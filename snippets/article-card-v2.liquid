{%- comment -%}
  Article card. Params: article, lead (true for a larger first card).
  Falls back to a tag-matched illustration when the article has no image.
{%- endcomment -%}
{%- liquid
  assign tags = article.tags | join: ' ' | downcase
  case article.handle
    when 'how-to-choose-a-wireless-charger-qi2-magsafe-and-watts-explained'
      assign art = 'ill-blog-charger'
    when 'wireless-earbuds-care-fit-cleaning-and-battery-tips'
      assign art = 'ill-blog-earbuds'
    when 'cafe-style-espresso-at-home-a-beginners-guide'
      assign art = 'ill-blog-espresso'
    else
      assign art = 'ill-guides'
      if tags contains 'audio' or tags contains 'earbud'
        assign art = 'ill-buds'
      elsif tags contains 'charg'
        assign art = 'ill-charge'
      elsif tags contains 'kitchen' or tags contains 'coffee' or tags contains 'home'
        assign art = 'ill-espresso'
      elsif tags contains 'wear' or tags contains 'watch'
        assign art = 'ill-watch'
      endif
  endcase
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
-%}
<a href="{{ article.url }}" class="post{% if lead %} post--lead{% endif %}">
  <span class="post__media">
    {%- if article.image -%}
      {%- assign post_alt = article.image.alt | default: article.title -%}
      {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(min-width: 990px) 33vw, 100vw', alt: post_alt }}
    {%- else -%}
      <span class="art-box tone tone--violet">{% render 'ill', name: art %}</span>
    {%- endif -%}
  </span>
  <span class="post__body">
    <span class="post__meta">
      {%- if article.tags.size > 0 -%}<span class="post__tag">{{ article.tags.first | escape }}</span>{%- endif -%}
      <span>{{ minutes }} min read</span>
    </span>
    <span class="post__title">{{ article.title | escape }}</span>
    <span class="post__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</span>
    <span class="post__more">Read the guide {% render 'icon', name: 'arrow-right', class: 'icon--xs' %}</span>
  </span>
</a>
