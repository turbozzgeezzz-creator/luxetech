{%- comment -%} Department chips for collection headers. Params: current (handle of the current collection) {%- endcomment -%}
<ul class="dept-chips" role="list">
  <li><a href="{{ routes.all_products_collection_url }}" class="dept-chip{% if current == 'all' %} is-active{% endif %}">Shop all</a></li>
  {%- for c in collections -%}
    {%- if c.handle == 'all' or c.handle == 'frontpage' or c.handle contains 'performance' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
    <li><a href="{{ c.url }}" class="dept-chip{% if current == c.handle %} is-active{% endif %}"{% if current == c.handle %} aria-current="page"{% endif %}>{{ c.title | escape }}</a></li>
  {%- endfor -%}
</ul>
