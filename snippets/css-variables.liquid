{%- comment -%}
  Design tokens. Every color in theme.css reads from these variables so the
  merchant's Colors settings flow through the whole theme.
{%- endcomment -%}
<style>
  :root {
    --c-bg: {{ settings.color_background }};
    --c-subtle: {{ settings.color_subtle }};
    --c-surface: {{ settings.color_surface }};
    --c-ink: {{ settings.color_ink }};
    --c-ink-rgb: {{ settings.color_ink.red }}, {{ settings.color_ink.green }}, {{ settings.color_ink.blue }};
    --c-muted: {{ settings.color_muted }};
    --c-border: {{ settings.color_border }};
    --c-primary: {{ settings.color_primary }};
    --c-primary-rgb: {{ settings.color_primary.red }}, {{ settings.color_primary.green }}, {{ settings.color_primary.blue }};
    --c-primary-dark: {{ settings.color_primary | color_darken: 12 }};
    --c-accent: {{ settings.color_accent }};
    --c-accent-text: {{ settings.color_primary | color_darken: 18 }};
    --c-success: {{ settings.color_success }};
    --c-success-soft: {{ settings.color_success | color_modify: 'alpha', 0.1 }};
    --c-warning: {{ settings.color_warning }};
    --c-warning-soft: {{ settings.color_warning | color_modify: 'alpha', 0.12 }};
    --c-error: {{ settings.color_error }};
    --c-error-soft: {{ settings.color_error | color_modify: 'alpha', 0.1 }};
    --c-night: {{ settings.color_ink }};
    --c-photo: {{ settings.color_subtle }};
    --c-on-ink: #FFFFFF;
    --c-on-ink-muted: {{ settings.color_ink | color_mix: '#FFFFFF', 35 }};
    --c-primary-on-ink: {{ settings.color_primary | color_mix: '#FFFFFF', 55 }};
    --font-display: 'Archivo', 'Helvetica Neue', Arial, system-ui, sans-serif;
    --font-body: 'Archivo', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --logo-width: {{ settings.logo_width }}px;
  }
  /* Dark mode: surfaces go dark, text goes light. --c-night stays dark for bands
     that are always dark, and product photos keep a light frame (--c-photo). */
  html[data-theme="dark"] {
    color-scheme: dark;
    --c-bg: #0A0E17;
    --c-subtle: #151C2B;
    --c-surface: #111827;
    --c-ink: #EDEFF5;
    --c-muted: #A1A9BA;
    --c-border: #263046;
    --c-accent: #261447;
    --c-accent-text: #CDB0FF;
    --c-on-ink-muted: #A1A9BA;
    --c-photo: #E9EBF0;
    --c-success: #3FBF6E;
    --c-success-soft: rgba(63, 191, 110, .16);
    --c-warning: #E0A43A;
    --c-warning-soft: rgba(224, 164, 58, .16);
    --c-error: #F0645A;
  }
</style>
