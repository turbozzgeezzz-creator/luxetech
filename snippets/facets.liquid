{%- comment -%}
  Filter form from Search & Discovery filters. Params: results (collection or search), id
{%- endcomment -%}
<form data-facet-form id="{{ id }}">
  {%- if results.terms -%}<input type="hidden" name="q" value="{{ results.terms | escape }}"><input type="hidden" name="options[prefix]" value="last"><input type="hidden" name="type" value="product">{%- endif -%}
  {%- for filter in results.filters -%}
    <details class="facets__group"{% if forloop.index <= 3 or filter.active_values.size > 0 %} open{% endif %}>
      <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %} {% render 'icon', name: 'plus', class: 'icon-plus' %}</summary>
      {%- case filter.type -%}
        {%- when 'price_range' -%}
          <div class="facets__price">
            <div class="field">
              <label class="field__label" for="{{ id }}-{{ filter.min_value.param_name | handle }}">{{ 'collections.from' | t }} ({{ cart.currency.symbol }})</label>
              <input class="field__input" type="number" inputmode="decimal" id="{{ id }}-{{ filter.min_value.param_name | handle }}" name="{{ filter.min_value.param_name }}" value="{% if filter.min_value.value %}{{ filter.min_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="0" min="0">
            </div>
            <div class="field">
              <label class="field__label" for="{{ id }}-{{ filter.max_value.param_name | handle }}">{{ 'collections.to' | t }} ({{ cart.currency.symbol }})</label>
              <input class="field__input" type="number" inputmode="decimal" id="{{ id }}-{{ filter.max_value.param_name | handle }}" name="{{ filter.max_value.param_name }}" value="{% if filter.max_value.value %}{{ filter.max_value.value | money_without_currency | replace: ',', '' }}{% endif %}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" min="0">
            </div>
          </div>
        {%- when 'boolean' -%}
          <div class="facets__values">
            {%- for value in filter.values -%}
              <label class="facets__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                {{ value.label }} <small>({{ value.count }})</small>
              </label>
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="facets__values{% if filter.presentation == 'swatch' %} facets__values--swatch{% endif %}">
            {%- for value in filter.values -%}
              {%- if filter.presentation == 'swatch' -%}
                <label class="facets__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}" title="{{ value.label | escape }}">
                  <input type="checkbox" class="visually-hidden" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                  <span class="swatch-pill"><span style="--sw: {% if value.swatch.color %}{{ value.swatch.color }}{% elsif value.swatch.image %}url({{ value.swatch.image | image_url: width: 80 }}){% else %}#ddd{% endif %}"></span></span>
                  <span class="visually-hidden">{{ value.label }}</span>
                </label>
              {%- else -%}
                <label class="facets__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                  {{ value.label }} <small>({{ value.count }})</small>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
      {%- endcase -%}
    </details>
  {%- endfor -%}
  <noscript><button type="submit" class="btn btn--block" style="margin-top: 20px">{{ 'collections.apply' | t }}</button></noscript>
</form>
