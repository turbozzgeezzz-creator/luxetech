{%- comment -%}
  Schema.org data from real store data only. Ratings are included only when a
  reviews app has written the standard reviews metafields.
{%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "OnlineStore",
    "@id": {{ request.origin | append: '/#store' | json }},
    "name": {{ shop.name | json }},
    "url": {{ request.origin | append: routes.root_url | json }},
    "logo": {{ 'logo-tech-luxedealers-purple.png' | asset_url | prepend: 'https:' | json }},
    "description": {{ settings.seo_home_description | default: shop.description | default: 'Hand-picked smart gadgets: audio, charging, wearables, home and kitchen tech, shipped with tracking.' | strip_html | json }},
    "email": {{ settings.support_email | default: shop.email | json }},
    "areaServed": "Worldwide",
    "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "email": {{ settings.support_email | default: shop.email | json }}, "availableLanguage": "English" },
    "sameAs": ["https://www.instagram.com/tech.luxedealers/", "https://www.facebook.com/profile.php?id=61595062625090"]
  }
</script>
{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ request.origin | append: routes.root_url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": "{{ request.origin }}/search?type=product&q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  </script>
{%- endif -%}
{%- if request.page_type == 'product' -%}
  {%- assign v = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {%- if product.featured_media -%}"image": [{%- for m in product.media limit: 4 -%}{{ m.preview_image | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],{%- endif -%}
      "description": {{ product.description | strip_html | strip_newlines | truncate: 500 | json }},
      {%- if v.sku != blank -%}"sku": {{ v.sku | json }},{%- endif -%}
      {%- if v.barcode != blank -%}"gtin": {{ v.barcode | json }},{%- endif -%}
      {%- if product.vendor != blank -%}"brand": { "@type": "Brand", "name": {{ product.vendor | json }} },{%- endif -%}
      {%- if product.metafields.reviews.rating.value != blank and product.metafields.reviews.rating_count.value > 0 -%}
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }},
        "bestRating": {{ product.metafields.reviews.rating.value.scale_max | json }},
        "ratingCount": {{ product.metafields.reviews.rating_count.value | json }}
      },
      {%- endif -%}
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "lowPrice": {{ product.price_min | divided_by: 100.0 | json }},
        "highPrice": {{ product.price_max | divided_by: 100.0 | json }},
        "offerCount": {{ product.variants.size }},
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
        "url": {{ request.origin | append: product.url | json }},
        "seller": { "@id": {{ request.origin | append: '/#store' | json }} }
      }
    }
  </script>
{%- endif -%}
{%- if request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'article' or request.page_type == 'page' or request.page_type == 'blog' -%}
  {%- liquid
    assign crumb = collection
    if request.page_type == 'product' and collection == blank
      capture crumb_handle
        render 'crumb-collection', product: product
      endcapture
      assign crumb_handle = crumb_handle | strip
      if crumb_handle != blank
        assign crumb = collections[crumb_handle]
      endif
    endif
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.home' | t | json }}, "item": {{ request.origin | append: routes.root_url | json }} }
        {%- if crumb -%},
        { "@type": "ListItem", "position": 2, "name": {{ crumb.title | json }}, "item": {{ request.origin | append: crumb.url | json }} }
        {%- endif -%}
        {%- if request.page_type == 'page' -%},
        { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ request.origin | append: page.url | json }} }
        {%- endif -%}
        {%- if request.page_type == 'blog' -%},
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} }
        {%- endif -%}
        {%- if article -%},
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
        {%- endif -%}
        {%- if product -%},
        { "@type": "ListItem", "position": {% if crumb %}3{% else %}2{% endif %}, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- endif %}
      ]
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | truncate: 110 | json }},
      "description": {{ article.excerpt_or_content | strip_html | strip_newlines | truncate: 200 | json }},
      {%- if article.image -%}"image": [{{ article.image | image_url: width: 1600 | prepend: 'https:' | json }}],{%- endif -%}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      "author": { "@type": "Person", "name": {{ article.author | json }} },
      "publisher": { "@type": "Organization", "name": {{ shop.name | json }}, "logo": { "@type": "ImageObject", "url": {{ 'logo-tech-luxedealers-purple.png' | asset_url | prepend: 'https:' | json }} } },
      "mainEntityOfPage": {{ request.origin | append: article.url | json }}
    }
  </script>
  {%- comment -%}
    The Q&A at the end of a post becomes FAQ data for Google and AI answers. Recognised formats:
    an <h2> "Common questions" / "Frequently asked questions" / "FAQ" heading followed by <strong> or <h3> questions,
    each followed by its answer paragraph.
  {%- endcomment -%}
  {%- liquid
    assign faq_section = ''
    assign faq_markers = '>Common questions</h2>|>Common Questions</h2>|>Frequently asked questions</h2>|>Frequently Asked Questions</h2>|>FAQ</h2>|>FAQs</h2>' | split: '|'
    for m in faq_markers
      if article.content contains '"FAQPage"'
        break
      endif
      if article.content contains m
        assign faq_section = article.content | split: m | last | split: '<h2' | first
        break
      endif
    endfor
    assign faq_tag = '<strong>'
    assign faq_end = '</strong>'
    if faq_section contains '<h3'
      assign faq_tag = '<h3'
      assign faq_end = '</h3>'
    endif
  -%}
  {%- if faq_section contains faq_end -%}
    {%- assign faq_parts = faq_section | split: faq_tag -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign first = true -%}
          {%- for part in faq_parts offset: 1 -%}
            {%- assign q = part | split: faq_end | first | prepend: faq_tag | strip_html | strip -%}
            {%- assign a = part | split: faq_end | last | strip_html | strip_newlines | strip -%}
            {%- if q != blank and a != blank -%}
              {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
              { "@type": "Question", "name": {{ q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a | truncate: 600 | json }} } }
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'collection' and collection.products.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ request.origin | append: collection.url | json }},
      "mainEntity": {
        "@type": "ItemList",
        "itemListElement": [
          {%- for p in collection.products limit: 12 -%}
          { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ request.origin | append: p.url | json }}, "name": {{ p.title | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
  </script>
{%- endif -%}
{%- if request.page_type == 'collection' and collection.description contains '<h2>Common questions</h2>' -%}
  {%- assign cfaq = collection.description | split: '<h2>Common questions</h2>' | last | split: '<p><strong>' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for part in cfaq offset: 1 -%}
          {%- assign q = part | split: '</strong>' | first | strip_html | strip -%}
          {%- assign a = part | split: '</strong>' | last | strip_html | strip_newlines | strip -%}
          {%- if q != blank and a != blank -%}
            {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
            { "@type": "Question", "name": {{ q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ a | truncate: 600 | json }} } }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}
