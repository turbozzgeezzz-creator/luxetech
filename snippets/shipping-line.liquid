{%- comment -%}
  Shipping line in the cart totals: the fee while the cart is under the free shipping threshold, Free once it
  qualifies. Only when Theme settings > Cart > Free shipping threshold is above 0 (both numbers must match the
  rates in Settings > Shipping and delivery). Other currencies: experience.js converts with Shopify's rate.
{%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign fee = settings.shipping_fee_below_threshold | times: 100
  -%}
  <p class="cart-summary__row cart-summary__row--ship"><span>Shipping</span>
    {%- if cart.currency.iso_code == shop.currency -%}
      {%- if cart.total_price >= threshold -%}<span class="cart-summary__free">Free</span>{%- else -%}<span>{{ fee | money_with_currency | replace: '.00 ', ' ' }}</span>{%- endif -%}
    {%- else -%}
      <span data-ship-cost data-threshold="{{ threshold }}" data-fee="{{ fee }}" data-total="{{ cart.total_price }}" data-currency="{{ cart.currency.iso_code }}">At checkout</span>
    {%- endif -%}
  </p>
{%- endif -%}
