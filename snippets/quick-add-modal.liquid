<quick-add-modal>
  <dialog class="modal" id="QuickAddModal" aria-label="Choose options">
    <button type="button" class="modal__close" data-modal-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
    <div class="modal__content" data-modal-content>
      <div class="modal__loading" aria-hidden="true"><span class="spinner"></span></div>
    </div>
  </dialog>
</quick-add-modal>
