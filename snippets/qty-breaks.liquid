{%- comment -%}
  Buy more, save more (Theme settings > Cart). Only shown when offers are set, which must match
  real automatic discounts in Shopify. Selecting an option sets the quantity added to the bag.
  Params: product, form_id
{%- endcomment -%}
{%- liquid
  assign c1 = settings.qty_1_count | default: 0
  assign c2 = settings.qty_2_count | default: 0
  assign v = product.selected_or_first_available_variant
-%}
{%- if c1 > 1 and v.available -%}
  <fieldset class="qtyb" data-qty-breaks data-form="{{ form_id }}">
    <legend class="qtyb__title">{% render 'icon', name: 'sparkle', class: 'icon--sm' %} {{ 'products.qty_title' | t }}</legend>
    {%- capture rows -%}1:0{% if c1 > 1 %},{{ c1 }}:{{ settings.qty_1_percent }}{% endif %}{% if c2 > c1 %},{{ c2 }}:{{ settings.qty_2_percent }}{% endif %}{%- endcapture -%}
    {%- assign rows = rows | split: ',' -%}
    {%- for r in rows -%}
      {%- assign parts = r | split: ':' -%}
      {%- assign n = parts[0] | plus: 0 -%}{%- assign pc = parts[1] | plus: 0 -%}
      {%- assign each = 100 | minus: pc | times: v.price | divided_by: 100 -%}
      {%- assign tot = each | times: n -%}
      <label class="qtyb__opt">
        <input type="radio" name="{{ form_id }}-qtyb" value="{{ n }}"{% if forloop.first %} checked{% endif %} data-price="{{ v.price }}" data-pct="{{ pc }}">
        <span class="qtyb__radio" aria-hidden="true"></span>
        <span class="qtyb__main"><strong>Buy {{ n }}</strong>
          {%- if pc > 0 -%}<span class="qtyb__save">{{ 'products.qty_save' | t: percent: pc }}</span>{%- else -%}<span class="qtyb__save qtyb__save--none">{{ 'products.qty_standard' | t }}</span>{%- endif -%}
          {%- if n > 1 -%}{%- assign em = each | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' -%}<small>{{ 'products.qty_each' | t: price: em }}</small>{%- endif -%}
        </span>
        <span class="qtyb__price"><strong data-qtyb-total>{{ tot | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</strong>{%- if pc > 0 -%}<s data-qtyb-was>{{ v.price | times: n | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</s>{%- endif -%}</span>
      </label>
    {%- endfor -%}
    <p class="qtyb__note">Mix and match any items. The discount is applied automatically at checkout.</p>
  </fieldset>
{%- endif -%}
