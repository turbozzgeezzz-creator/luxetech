{%- comment -%}
  Progress toward free shipping, only while the cart is short of it (once it qualifies, the cart's shipping line
  says Free). Hidden unless Theme settings > Cart > Free shipping threshold is above 0. The threshold is in the
  store's currency; for shoppers paying in another currency experience.js converts it with Shopify's rate.
{%- endcomment -%}
{%- if settings.free_shipping_threshold > 0 and cart.item_count > 0 -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign pct = cart.total_price | times: 100 | divided_by: threshold
    if pct > 100
      assign pct = 100
    endif
  -%}
  {%- if cart.currency.iso_code == shop.currency -%}
    {%- if remaining > 0 -%}
      <div class="ship-bar">
        <p class="ship-bar__text" role="status">
          {%- render 'icon', name: 'truck', class: 'icon--sm' -%}
          <span>You're <strong>{{ remaining | money_with_currency | replace: '.00 ', ' ' }}</strong> away from free shipping</span>
        </p>
        <div class="ship-bar__track" role="progressbar" aria-label="Progress to free shipping" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}">
          <span class="ship-bar__fill" style="width: {{ pct }}%;"></span>
        </div>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="ship-bar" data-ship-bar data-threshold="{{ threshold }}" data-total="{{ cart.total_price }}" data-currency="{{ cart.currency.iso_code }}" hidden>
      <p class="ship-bar__text" role="status">
        {%- render 'icon', name: 'truck', class: 'icon--sm' -%}
        <span>You're <strong data-ship-left></strong> away from free shipping</span>
      </p>
      <div class="ship-bar__track" role="progressbar" aria-label="Progress to free shipping" aria-valuemin="0" aria-valuemax="100">
        <span class="ship-bar__fill" style="width: 0%;"></span>
      </div>
    </div>
  {%- endif -%}
{%- endif -%}
