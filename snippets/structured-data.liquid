{%- comment -%}
  Structured data for search engines: Organization and WebSite (with site
  search) on the homepage, BreadcrumbList on collection, product and article
  pages, and Article on blog posts. Product data lives in main-product.
  Only real store data is used.
{%- endcomment -%}
{%- liquid
  assign same_as = ''
  assign social_keys = 'social_facebook,social_instagram,social_youtube,social_tiktok,social_x,social_pinterest' | split: ','
  for key in social_keys
    if settings[key] != blank
      assign same_as = same_as | append: settings[key] | append: '|||'
    endif
  endfor
  assign same_as_list = same_as | split: '|||'
  assign logo_url = 'logo-tech-luxedealers.png' | asset_url | prepend: 'https:'
  if settings.logo != blank
    assign logo_url = settings.logo | image_url: width: 600 | prepend: 'https:'
  endif
-%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ request.origin | append: '/#organization' | json }},
        "name": {{ settings.seo_brand | default: shop.name | json }},
        "url": {{ request.origin | json }},
        "logo": {{ logo_url | json }}
        {%- if settings.support_email != blank -%},"email": {{ settings.support_email | json }}{%- endif -%}
        {%- if same_as_list.size > 0 -%},"sameAs": {{ same_as_list | json }}{%- endif -%}
      },
      {
        "@type": "WebSite",
        "@id": {{ request.origin | append: '/#website' | json }},
        "url": {{ request.origin | json }},
        "name": {{ settings.seo_brand | default: shop.name | json }},
        "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "{{ request.origin }}{{ routes.search_url }}?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      }
    ]
  }
</script>
{%- endif -%}
{%- if request.page_type == 'collection' or request.page_type == 'product' or request.page_type == 'article' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ request.origin | json }} }
      {%- case request.page_type -%}
        {%- when 'collection' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
        {%- when 'product' -%}
          {%- assign crumb = collection -%}
          {%- if crumb == blank -%}
            {%- for c in product.collections -%}{%- if c.handle != 'all' and c.handle != 'frontpage' and c.handle != 'for-shopify-performance-tracking' -%}{%- assign crumb = c -%}{%- break -%}{%- endif -%}{%- endfor -%}
          {%- endif -%}
          {%- if crumb != blank -%}
            ,{ "@type": "ListItem", "position": 2, "name": {{ crumb.title | json }}, "item": {{ request.origin | append: crumb.url | json }} }
            ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
          {%- else -%}
            ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
          {%- endif -%}
        {%- when 'article' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ request.origin | append: blog.url | json }} }
          ,{ "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ request.origin | append: article.url | json }} }
      {%- endcase -%}
    ]
  }
</script>
{%- endif -%}
{%- if request.page_type == 'article' -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": {{ article.title | json }},
    "description": {{ article.excerpt_or_content | strip_html | truncate: 200 | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": { "@type": "Organization", "name": {{ article.author | default: shop.name | json }} },
    "publisher": { "@type": "Organization", "name": {{ settings.seo_brand | default: shop.name | json }}, "logo": { "@type": "ImageObject", "url": {{ logo_url | json }} } },
    "mainEntityOfPage": {{ request.origin | append: article.url | json }}
    {%- if article.image -%},"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}{%- endif -%}
  }
</script>
{%- endif -%}
