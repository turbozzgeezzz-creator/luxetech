{%- comment -%}
  Social profile icons from Theme settings > Social media. Renders nothing
  when no profiles are set. Params: class (optional extra class on the list).
{%- endcomment -%}
{%- liquid
  assign social_class = 'social'
  if class != blank
    assign social_class = social_class | append: ' ' | append: class
  endif
-%}
{%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_facebook != blank or settings.social_x != blank or settings.social_pinterest != blank -%}
<ul class="{{ social_class }}" role="list" aria-label="Follow us">
  {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook (opens in a new tab)">{% render 'icon', name: 'facebook' %}</a></li>{%- endif -%}
  {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram (opens in a new tab)">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
  {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube (opens in a new tab)">{% render 'icon', name: 'youtube' %}</a></li>{%- endif -%}
  {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok (opens in a new tab)">{% render 'icon', name: 'tiktok' %}</a></li>{%- endif -%}
  {%- if settings.social_x != blank -%}<li><a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X (opens in a new tab)">{% render 'icon', name: 'x' %}</a></li>{%- endif -%}
  {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest (opens in a new tab)">{% render 'icon', name: 'pinterest' %}</a></li>{%- endif -%}
</ul>
{%- endif -%}
