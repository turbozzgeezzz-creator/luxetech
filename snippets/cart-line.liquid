{%- comment -%} One line in the bag. Params: item, ctx {%- endcomment -%}
<div class="cart-line">
  <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.product.title, widths: '120, 200, 300', sizes: '96px' }}{%- else -%}{% render 'placeholder' %}{%- endif -%}
  </a>
  <div class="cart-line__info">
    <div class="cart-line__top">
      <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
      <button type="button" class="cart-line__x" data-line-remove="{{ item.key }}" aria-label="{{ 'cart.remove' | t }} {{ item.product.title | escape }}">{% render 'icon', name: 'close', class: 'icon--sm' %}</button>
    </div>
    {%- unless item.product.has_only_default_variant -%}
      <div class="cart-line__opts">
        {%- for o in item.options_with_values -%}<span>{{ o.name | replace: 'Collection', 'Style' }}: {{ o.value }}</span>{%- endfor -%}
      </div>
    {%- endunless -%}
    {%- for p in item.properties -%}
      {%- assign first = p.first | slice: 0 -%}
      {%- if p.last != blank and first != '_' -%}<span class="cart-line__props">{{ p.first }}: {{ p.last }}</span>{%- endif -%}
    {%- endfor -%}
    {%- for d in item.line_level_discount_allocations -%}<span class="cart-line__discount">{% render 'icon', name: 'tag', class: 'icon--sm' %} {{ d.discount_application.title }} (−{{ d.amount | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }})</span>{%- endfor -%}
    <div class="cart-line__bottom">
      <div class="qty qty--sm">
        <button type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease' | t: title: item.product.title | escape }}">{% render 'icon', name: 'minus', class: 'icon--sm' %}</button>
        <label class="visually-hidden" for="Qty-{{ ctx }}-{{ item.key | handle }}">{{ 'cart.quantity' | t }}</label>
        <input id="Qty-{{ ctx }}-{{ item.key | handle }}" type="number" min="0" value="{{ item.quantity }}" data-line-qty="{{ item.key }}" inputmode="numeric">
        <button type="button" data-qty-step="1" aria-label="{{ 'cart.increase' | t: title: item.product.title | escape }}">{% render 'icon', name: 'plus', class: 'icon--sm' %}</button>
      </div>
      <div class="price cart-line__price{% if item.original_line_price > item.final_line_price %} price--sale{% endif %}">
        {%- if item.original_line_price > item.final_line_price -%}<s class="price__compare">{{ item.original_line_price | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</s>{%- endif -%}
        <span class="price__current">{{ item.final_line_price | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</span>
      </div>
    </div>
  </div>
</div>
