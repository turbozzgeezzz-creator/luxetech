{%- comment -%}
  One cart line, used by the drawer and the cart page.
  Params: item, line (1-based index), context ('drawer' | 'page')
{%- endcomment -%}
<li class="cart-line cart-line--{{ context }}" data-line="{{ line }}">
  <a href="{{ item.url }}" class="cart-line__media" tabindex="-1" aria-hidden="true">
    {%- if item.image -%}
      {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240', sizes: '120px', alt: '' }}
    {%- else -%}
      {% render 'placeholder-art', type: 'product', uid: item.product_id %}
    {%- endif -%}
  </a>
  <div class="cart-line__info">
    {%- if item.vendor != blank and item.vendor != shop.name -%}<p class="card__label">{{ item.vendor | escape }}</p>{%- endif -%}
    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title | escape }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-line__meta">{{ item.variant.title | escape }}</p>
    {%- endunless -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="cart-line__meta">{{ property.first | escape }}: {{ property.last | escape }}</p>
      {%- endif -%}
    {%- endfor -%}
    {%- if item.selling_plan_allocation -%}
      <p class="cart-line__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
    {%- endif -%}
    {%- if item.sku != blank -%}<p class="card__sku">SKU {{ item.sku | escape }}</p>{%- endif -%}
    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-line__discount">{% render 'icon', name: 'tag', class: 'icon--xs' %} {{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</p>
    {%- endfor -%}

    <div class="cart-line__controls">
      <quantity-input class="qty qty--sm">
        <button type="button" class="qty__btn" name="minus" aria-label="Decrease quantity of {{ item.product.title | escape }}">{% render 'icon', name: 'minus', class: 'icon--xs' %}</button>
        <label for="Qty-{{ context }}-{{ line }}" class="visually-hidden">Quantity of {{ item.product.title | escape }}</label>
        <input
          type="number"
          id="Qty-{{ context }}-{{ line }}"
          class="qty__input"
          {% if context == 'page' %}name="updates[]"{% endif %}
          value="{{ item.quantity }}"
          min="0"
          step="1"
          inputmode="numeric"
          data-line-qty="{{ line }}"
        >
        <button type="button" class="qty__btn" name="plus" aria-label="Increase quantity of {{ item.product.title | escape }}">{% render 'icon', name: 'plus', class: 'icon--xs' %}</button>
      </quantity-input>
      <a href="{{ item.url_to_remove }}" class="cart-line__remove" data-line-remove="{{ line }}" aria-label="Remove {{ item.product.title | escape }}">
        {% render 'icon', name: 'trash', class: 'icon--sm' %}<span>Remove</span>
      </a>
    </div>
  </div>
  <div class="cart-line__price">
    {%- if item.original_line_price > item.final_line_price -%}
      <s class="price__compare"><span class="visually-hidden">Regular price</span>{{ item.original_line_price | money }}</s>
    {%- endif -%}
    <span class="cart-line__total">{{ item.final_line_price | money }}</span>
    {%- if item.quantity > 1 -%}<span class="cart-line__each">{{ item.final_price | money }} each</span>{%- endif -%}
  </div>
</li>
