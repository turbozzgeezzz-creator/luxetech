{%- comment -%}
  A gold illustration from assets (lx-*.svg), or the uploaded image when one
  is set. Params: name, image, sizes, class, eager
{%- endcomment -%}
{%- assign ill_alt = name | remove: 'lx-' | replace: '-', ' ' | capitalize | append: ' illustration' -%}
{%- if image != blank -%}
  {%- if eager -%}
    {{ image | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 960, 1200, 1400', sizes: sizes, fetchpriority: 'high', alt: ill_alt, class: class }}
  {%- else -%}
    {{ image | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 960, 1200, 1400', sizes: sizes, loading: 'lazy', alt: ill_alt, class: class }}
  {%- endif -%}
{%- elsif name != blank and name != 'none' -%}
  <img src="{{ name | append: '.svg' | asset_url }}" alt="{{ ill_alt }}" width="600" height="600" class="{{ class }}"{% if eager %} fetchpriority="high"{% else %} loading="lazy" decoding="async"{% endif %}>
{%- endif -%}
