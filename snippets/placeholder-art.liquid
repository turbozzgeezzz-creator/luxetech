{%- comment -%}
  Editorial stand-in artwork for image slots that don't have a photo yet
  (hero slides, banners, mega menu promo, collection and article tiles, and any
  product without media). It's drawn as a deliberate plate in the brand's own
  language rather than an "image missing" box: engineering-paper dot grid, a solid
  device silhouette in ink, the violet signal dot as the device's status light,
  and the logo's speed lines and price tag. Colors come from the theme tokens.
  Decorative only. Every slot that uses it has an image picker or uses the
  product's own media, so uploading a photo replaces it without code changes.

  Params:
  - type: 'product' (square plate, one device) or 'hero' (wider plate, three devices)
  - uid: unique string; used for pattern ids and to pick which device is drawn,
    so neighbouring placeholders don't all show the same thing
  - variant: optional 1-4 to force a device (1 case, 2 charger, 3 watch, 4 phone)
  - caption: optional short label for the plate, e.g. a category name
  - class: extra classes
{%- endcomment -%}
{%- liquid
  assign art_uid = uid | default: 'x' | append: '' | handle
  assign pick = variant | default: 0 | plus: 0
  if pick < 1 or pick > 4
    assign seed = art_uid | md5 | slice: 0
    case seed
      when '0', '1', '2', '3'
        assign pick = 1
      when '4', '5', '6', '7'
        assign pick = 2
      when '8', '9', 'a', 'b'
        assign pick = 3
      else
        assign pick = 4
    endcase
  endif
  assign cap = caption | default: '' | upcase | escape
-%}
{%- capture speed_tag -%}
  <g class="pa-mark">
    <rect x="0" y="0" width="34" height="4" rx="2" class="pa-violet"/>
    <rect x="12" y="9" width="22" height="4" rx="2" class="pa-violet"/>
    <rect x="22" y="18" width="12" height="4" rx="2" class="pa-violet"/>
    <path d="M40 -1 H60 L70 10 L60 23 H40 Q37 23 37 20 V2 Q37 -1 40 -1 Z" class="pa-violet"/>
    <circle cx="60" cy="11" r="3" class="pa-hole"/>
  </g>
{%- endcapture -%}
{%- if type == 'hero' -%}
  <svg class="placeholder-art placeholder-art--hero {{ class }}" viewBox="0 0 600 480" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="PaGrid-{{ art_uid }}" width="18" height="18" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.4" class="pa-grid"/>
      </pattern>
    </defs>
    <rect x="0" y="0" width="600" height="480" fill="url(#PaGrid-{{ art_uid }})"/>
    <text x="28" y="40" class="pa-cap">FIG. 00{% if cap != blank %} / {{ cap }}{% endif %}</text>
    <ellipse cx="318" cy="402" rx="236" ry="12" class="pa-shadow"/>
    {%- comment -%} Phone on stand {%- endcomment -%}
    <path d="M118 372 H226 L210 404 H134 Z" class="pa-band"/>
    <rect x="116" y="104" width="112" height="272" rx="22" class="pa-solid"/>
    <rect x="127" y="120" width="90" height="236" rx="12" class="pa-screen"/>
    <rect x="144" y="250" width="48" height="5" rx="2.5" class="pa-violet"/>
    <rect x="152" y="262" width="40" height="5" rx="2.5" class="pa-violet" opacity=".7"/>
    <rect x="164" y="274" width="28" height="5" rx="2.5" class="pa-violet" opacity=".45"/>
    <circle cx="172" cy="140" r="5" class="pa-violet"/>
    {%- comment -%} Wireless charger {%- endcomment -%}
    <ellipse cx="384" cy="356" rx="142" ry="44" class="pa-solid"/>
    <rect x="242" y="320" width="284" height="36" class="pa-solid"/>
    <ellipse cx="384" cy="320" rx="142" ry="44" class="pa-solid-2"/>
    <ellipse cx="384" cy="320" rx="96" ry="28" class="pa-hi"/>
    <circle cx="384" cy="320" r="6" class="pa-violet"/>
    <path d="M526 344 C 566 360, 570 420, 520 436" class="pa-cable"/>
    {%- comment -%} Earbuds case resting on the charger {%- endcomment -%}
    <rect x="320" y="200" width="128" height="104" rx="44" class="pa-solid"/>
    <path d="M320 236 H448" class="pa-hi"/>
    <circle cx="384" cy="276" r="5" class="pa-violet"/>
    <g transform="translate(28 430)">{{ speed_tag }}</g>
  </svg>
{%- else -%}
  <svg class="placeholder-art placeholder-art--product placeholder-art--v{{ pick }} {{ class }}" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <defs>
      <pattern id="PaGrid-{{ art_uid }}-{{ pick }}" width="16" height="16" patternUnits="userSpaceOnUse">
        <circle cx="2" cy="2" r="1.3" class="pa-grid"/>
      </pattern>
    </defs>
    <rect x="0" y="0" width="400" height="400" fill="url(#PaGrid-{{ art_uid }}-{{ pick }})"/>
    <text x="24" y="36" class="pa-cap">FIG. 0{{ pick }}{% if cap != blank %} / {{ cap }}{% endif %}</text>
    <ellipse cx="200" cy="322" rx="120" ry="9" class="pa-shadow"/>
    {%- case pick -%}
      {%- when 1 -%}
        <rect x="108" y="158" width="184" height="150" rx="62" class="pa-solid"/>
        <path d="M108 206 H292" class="pa-hi"/>
        <rect x="176" y="176" width="48" height="6" rx="3" class="pa-hi-fill"/>
        <circle cx="200" cy="262" r="7" class="pa-violet"/>
      {%- when 2 -%}
        <ellipse cx="200" cy="262" rx="132" ry="42" class="pa-solid"/>
        <rect x="68" y="226" width="264" height="36" class="pa-solid"/>
        <ellipse cx="200" cy="226" rx="132" ry="42" class="pa-solid-2"/>
        <ellipse cx="200" cy="226" rx="88" ry="27" class="pa-hi"/>
        <circle cx="200" cy="226" r="6" class="pa-violet"/>
        <path d="M332 248 C 362 262, 366 300, 330 316" class="pa-cable"/>
      {%- when 3 -%}
        <rect x="166" y="62" width="68" height="270" rx="24" class="pa-band"/>
        <rect x="132" y="124" width="136" height="154" rx="42" class="pa-solid"/>
        <rect x="148" y="140" width="104" height="122" rx="30" class="pa-screen"/>
        <rect x="268" y="168" width="10" height="34" rx="4" class="pa-solid"/>
        <rect x="166" y="212" width="52" height="5" rx="2.5" class="pa-violet"/>
        <rect x="178" y="224" width="40" height="5" rx="2.5" class="pa-violet" opacity=".7"/>
        <rect x="190" y="236" width="28" height="5" rx="2.5" class="pa-violet" opacity=".45"/>
        <circle cx="228" cy="172" r="7" class="pa-violet"/>
      {%- else -%}
        <path d="M146 300 H254 L238 330 H162 Z" class="pa-band"/>
        <rect x="146" y="58" width="108" height="246" rx="20" class="pa-solid"/>
        <rect x="157" y="73" width="86" height="214" rx="11" class="pa-screen"/>
        <rect x="172" y="200" width="46" height="5" rx="2.5" class="pa-violet"/>
        <rect x="180" y="212" width="38" height="5" rx="2.5" class="pa-violet" opacity=".7"/>
        <rect x="190" y="224" width="28" height="5" rx="2.5" class="pa-violet" opacity=".45"/>
        <circle cx="200" cy="94" r="5" class="pa-violet"/>
    {%- endcase -%}
    <g transform="translate(24 358)">{{ speed_tag }}</g>
  </svg>
{%- endif -%}
