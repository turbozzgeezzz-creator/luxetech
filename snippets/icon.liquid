{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', name: 'search' %}
  Pass class: 'icon--sm' for size variants. Icons are decorative (aria-hidden); label the parent control instead.
{%- endcomment -%}
{%- liquid
  assign icon_class = 'icon icon-' | append: name
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
