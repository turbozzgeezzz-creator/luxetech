{%- comment -%}
  Shopify customer newsletter form. Submitting it is the sign-up: the notice
  under the field says the visitor is subscribing to marketing emails and can
  unsubscribe any time (Spam Act / GDPR clear affirmative action). Params: id (unique), source (tag), button_label, code_box (false = the popup shows the code itself)
  After a successful sign-up the welcome code (if set) is revealed.
{%- endcomment -%}
{%- liquid
  assign tags = 'newsletter, ' | append: source
  assign label = button_label
  if label == blank
    assign label = 'newsletter.subscribe' | t
  endif
-%}
{%- form 'customer', id: id, class: 'newsletter__form', data-newsletter: source -%}
  <input type="hidden" name="contact[tags]" value="{{ tags }}">
  {%- if form.posted_successfully? -%}
    <div class="offer-reveal{% if settings.welcome_personal %} offer-reveal--compact{% endif %}" role="status" tabindex="-1" data-autofocus>
      <strong class="h4">{{ 'newsletter.thanks' | t }}</strong>
      {%- if settings.welcome_code != blank -%}
        <span class="muted">{{ settings.welcome_offer }}. {{ 'newsletter.your_code' | t }}</span>
        <span class="offer-reveal__code">{{ settings.welcome_code }}</span>
        <div class="offer-reveal__actions">
          <button type="button" class="btn btn--sm btn--outline" data-copy="{{ settings.welcome_code | escape }}">{{ 'newsletter.copy' | t }}</button>
          <a class="btn btn--sm" href="/discount/{{ settings.welcome_code | url_encode }}?redirect={{ routes.all_products_collection_url | url_encode }}">{{ 'newsletter.apply' | t }}</a>
        </div>
      {%- elsif settings.welcome_personal and code_box != false -%}
        <span class="muted" data-welcome-wait>{{ 'newsletter.code_coming' | t: offer: settings.welcome_offer }}</span>
        <div class="offer-reveal__personal" data-welcome-code hidden>
          <button type="button" class="offer-chip" data-copy="" aria-label="{{ 'newsletter.copy' | t }}"><span data-popup-code-value></span> {% render 'icon', name: 'tag', class: 'icon--sm' %}</button>
          <span class="offer-reveal__note" data-popup-code-note></span>
          <a class="btn btn--sm btn--gold" href="{{ routes.all_products_collection_url }}">{{ 'newsletter.keep_shopping' | t }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
        </div>
      {%- else -%}
        <span class="muted">{{ 'newsletter.thanks_sub' | t }}</span>
      {%- endif -%}
    </div>
  {%- else -%}
    <div class="newsletter__row">
      <label class="visually-hidden" for="{{ id }}-email">{{ 'newsletter.email' | t }}</label>
      <input id="{{ id }}-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ 'newsletter.email' | t }}"{% if form.errors %} aria-invalid="true" aria-describedby="{{ id }}-error"{% endif %}>
      <button type="submit">{{ label }} {% render 'icon', name: 'arrow-right' %}</button>
    </div>
    <input type="hidden" name="contact[accepts_marketing]" value="true">
    <p class="newsletter__notice">{{ 'newsletter.notice' | t }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ 'newsletter.privacy' | t }}</a> <span class="recaptcha-note">{{ 'general.recaptcha_html' | t }}</span></p>
    {%- if form.errors -%}
      <p class="form-message form-message--error" id="{{ id }}-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
    {%- endif -%}
  {%- endif -%}
{%- endform -%}
