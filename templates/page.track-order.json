{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {
        "show_title": false
      }
    },
    "steps": {
      "type": "track-order",
      "settings": {
        "contact_label": "Contact support",
        "contact_link": "/pages/contact",
        "heading": "Where to find your tracking details"
      },
      "blocks": {
        "s1": {
          "type": "step",
          "settings": {
            "title": "Check your shipping email",
            "text": "<p>When your order ships, we email you a tracking number and a link to the carrier's tracking page.</p>"
          }
        },
        "s2": {
          "type": "step",
          "settings": {
            "title": "Open your order status page",
            "text": "<p>Your order confirmation email has a View your order button. It opens your order status page, which shows the latest progress and tracking details.</p>"
          }
        },
        "s3": {
          "type": "step",
          "settings": {
            "title": "Or sign in to your account",
            "text": "<p>If you checked out with an account, every order and its status is listed under your order history.</p>"
          }
        },
        "s4": {
          "type": "step",
          "settings": {
            "title": "Still can't find it?",
            "text": "<p>Send us your order number and the email you ordered with and we'll check on it for you.</p>"
          }
        }
      },
      "block_order": [
        "s1",
        "s2",
        "s3",
        "s4"
      ]
    },
    "hero": {
      "type": "page-hero",
      "settings": {
        "tone": "violet",
        "art": "ill-track",
        "kicker": "Orders",
        "text": "<p>Paste your tracking number for live updates, or send us your order number and we'll check on it for you.</p>",
        "heading": "Track my order"
      }
    },
    "tracker": {
      "type": "order-tracker",
      "settings": {},
      "blocks": {
        "c1": {
          "type": "carrier",
          "settings": {
            "name": "Auto-detect carrier",
            "url": "https://t.17track.net/en#nums={number}"
          }
        },
        "c2": {
          "type": "carrier",
          "settings": {
            "name": "Australia Post",
            "url": "https://auspost.com.au/mypost/track/details/{number}"
          }
        },
        "c3": {
          "type": "carrier",
          "settings": {
            "name": "FedEx",
            "url": "https://www.fedex.com/fedextrack/?trknbr={number}"
          }
        },
        "c4": {
          "type": "carrier",
          "settings": {
            "name": "UPS",
            "url": "https://www.ups.com/track?tracknum={number}"
          }
        },
        "c5": {
          "type": "carrier",
          "settings": {
            "name": "DHL",
            "url": "https://www.dhl.com/global-en/home/tracking/tracking-express.html?submit=1&tracking-id={number}"
          }
        }
      },
      "block_order": [
        "c1",
        "c5",
        "c3",
        "c4",
        "c2"
      ]
    }
  },
  "order": [
    "hero",
    "tracker",
    "steps",
    "main"
  ]
}
