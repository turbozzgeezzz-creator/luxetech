<div class="container account-page">
  <a href="{{ routes.account_url }}" class="link-btn">{% render 'icon', name: 'chevron-left', class: 'icon--xs' %} Back to account</a>
  <h1 class="page-title">Addresses</h1>

  {%- paginate customer.addresses by 20 -%}
    <ul class="address-list" role="list">
      {%- for address in customer.addresses -%}
        <li class="account-card">
          {%- if address == customer.default_address -%}<p class="badge badge--new badge--static">Default</p>{%- endif -%}
          <address class="account-address">{{ address | format_address }}</address>
          <details class="address-edit">
            <summary class="btn btn--outline btn--sm">Edit</summary>
            {%- form 'customer_address', address, class: 'form-stack' -%}
              {% render 'address-fields', form: form, prefix: address.id %}
              <label class="check__label check__label--inline"><input type="checkbox" name="address[default]" value="1" class="check__native"{% if address == customer.default_address %} checked{% endif %}> Set as default address</label>
              <button type="submit" class="btn btn--primary">Save address</button>
            {%- endform -%}
          </details>
          {%- form 'customer_address', address -%}
            <input type="hidden" name="_method" value="delete">
            <button type="submit" class="link-btn link-btn--danger" data-confirm="Delete this address?">Delete</button>
          {%- endform -%}
        </li>
      {%- else -%}
        <li><p class="account-card__sub">You don't have any saved addresses yet.</p></li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}

  <div class="account-card">
    <h2 class="account-card__title">Add a new address</h2>
    {%- form 'customer_address', customer.new_address, class: 'form-stack' -%}
      {% render 'address-fields', form: form, prefix: 'new' %}
      <label class="check__label check__label--inline"><input type="checkbox" name="address[default]" value="1" class="check__native"> Set as default address</label>
      <button type="submit" class="btn btn--primary">Add address</button>
    {%- endform -%}
  </div>
</div>
