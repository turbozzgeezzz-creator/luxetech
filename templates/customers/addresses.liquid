<div class="container section">
  <p><a class="link" href="{{ routes.account_url }}">{% render 'icon', name: 'arrow-left', class: 'icon--sm' %} {{ 'customer.back_to_account' | t }}</a></p>
  <h1 class="h2" style="margin: 24px 0 32px">{{ 'customer.addresses' | t }}</h1>
  <div class="account-layout">
    <div style="display: flex; flex-direction: column; gap: 24px">
      {%- paginate customer.addresses by 10 -%}
        {%- for address in customer.addresses -%}
          <div style="padding: 24px; border: 1px solid var(--c-border)">
            {%- if address == customer.default_address -%}<span class="badge badge--new" style="padding: 0; margin-bottom: 8px">{{ 'customer.default' | t }}</span>{%- endif -%}
            {{ address | format_address }}
            <details style="margin-top: 14px">
              <summary class="link" style="cursor: pointer">{{ 'customer.edit' | t }}</summary>
              {%- form 'customer_address', address, class: 'form-grid', style: 'margin-top: 16px' -%}{% render 'address-fields', form: form, address: address, uid: address.id %}{%- endform -%}
            </details>
            <form method="post" action="/account/addresses/{{ address.id }}" style="margin-top: 10px" onsubmit="return confirm({{ 'customer.delete_confirm' | t | json | escape }});">
              <input type="hidden" name="_method" value="delete">
              <button type="submit" class="cart-line__remove">{{ 'customer.delete' | t }}</button>
            </form>
          </div>
        {%- endfor -%}
        {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
      {%- endpaginate -%}
    </div>
    <aside>
      <h2 class="h4" style="margin-bottom: 16px">{{ 'customer.add_address' | t }}</h2>
      {%- form 'customer_address', customer.new_address, class: 'form-grid' -%}{% render 'address-fields', form: form, address: customer.new_address, uid: 'new' %}{%- endform -%}
    </aside>
  </div>
</div>
