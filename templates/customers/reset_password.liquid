<div class="container section">
  <div class="narrow-form">
    <h1>{{ 'customer.reset' | t }}</h1>
    {%- form 'reset_customer_password', class: 'form-grid' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label class="field__label" for="ResetPassword">{{ 'customer.password' | t }}</label><input class="field__input" type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label class="field__label" for="ResetConfirm">{{ 'customer.password_confirm' | t }}</label><input class="field__input" type="password" id="ResetConfirm" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="btn btn--block">{{ 'customer.reset' | t }}</button>
    {%- endform -%}
  </div>
</div>
