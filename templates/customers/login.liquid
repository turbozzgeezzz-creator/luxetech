<div class="container section">
  <div class="narrow-form" data-reveal>
    <h1>{{ 'customer.login' | t }}</h1>
    <div id="RecoverForm" hidden>
      {%- form 'recover_customer_password', class: 'form-grid' -%}
        <p class="muted" style="text-align: center">{{ 'customer.recover_text' | t }}</p>
        {%- if form.posted_successfully? -%}<p class="form-message form-message--success" role="status">{{ 'customer.recover_sent' | t }}</p>{%- endif -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label class="field__label" for="RecoverEmail">{{ 'customer.email' | t }}</label><input class="field__input" type="email" id="RecoverEmail" name="email" autocomplete="email" required></div>
        <button type="submit" class="btn btn--block">{{ 'customer.recover_submit' | t }}</button>
        <a href="#login" class="link" style="justify-self: center" onclick="document.getElementById('RecoverForm').hidden=true;document.getElementById('LoginForm').hidden=false;return false;">{{ 'customer.back_to_login' | t }}</a>
      {%- endform -%}
    </div>
    <div id="LoginForm">
      {%- form 'customer_login', class: 'form-grid', novalidate: 'novalidate' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label class="field__label" for="LoginEmail">{{ 'customer.email' | t }}</label><input class="field__input" type="email" id="LoginEmail" name="customer[email]" autocomplete="email" required></div>
        {%- if form.password_needed -%}
          <div class="field"><label class="field__label" for="LoginPassword">{{ 'customer.password' | t }}</label><input class="field__input" type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required></div>
          <a href="#recover" class="muted" style="font-size: var(--fs-sm)" onclick="document.getElementById('RecoverForm').hidden=false;document.getElementById('LoginForm').hidden=true;return false;">{{ 'customer.forgot' | t }}</a>
        {%- endif -%}
        <button type="submit" class="btn btn--block">{{ 'customer.sign_in' | t }}</button>
        <a href="{{ routes.account_register_url }}" class="btn btn--outline btn--block">{{ 'customer.create' | t }}</a>
      {%- endform -%}
    </div>
    {%- if shop.checkout.guest_login -%}
      {%- form 'guest_login' -%}<button type="submit" class="link" style="margin: 0 auto">{{ 'customer.guest' | t }}</button>{%- endform -%}
    {%- endif -%}
  </div>
</div>
<script>if (location.hash === '#recover') { document.getElementById('RecoverForm').hidden = false; document.getElementById('LoginForm').hidden = true; }</script>
