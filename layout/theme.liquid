<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

    {%- liquid
      assign seo_brand = settings.seo_brand | default: shop.name
      assign seo_title = page_title
      if request.page_type == 'index' and settings.seo_home_title != blank
        assign seo_title = settings.seo_home_title
      endif
      assign seo_desc = page_description
      if request.page_type == 'index' and settings.seo_home_description != blank
        assign seo_desc = settings.seo_home_description
      endif
      if seo_desc == blank
        case request.page_type
          when 'product'
            assign seo_desc = product.description | strip_html | strip_newlines | truncate: 155
          when 'collection'
            assign seo_desc = collection.description | strip_html | strip_newlines | truncate: 155
            if seo_desc == blank
              assign seo_desc = 'Shop ' | append: collection.title | append: ' at ' | append: seo_brand | append: '. Hand-picked, dispatched in 3-4 business days with tracking.'
            endif
          when 'article'
            assign seo_desc = article.excerpt_or_content | strip_html | strip_newlines | truncate: 155
          when 'blog'
            assign seo_desc = 'Buying guides, care tips and news from the ' | append: seo_brand | append: ' team.'
          when 'page'
            assign seo_desc = page.content | strip_html | strip_newlines | truncate: 155
        endcase
      endif
      if seo_desc == blank
        assign seo_desc = settings.seo_home_description
      endif
    -%}
    <title>
      {{ seo_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless seo_title contains seo_brand or seo_title contains shop.name %} &ndash; {{ seo_brand }}{% endunless -%}
    </title>
    <meta name="description" content="{{ seo_desc | escape }}">
    {%- if template.suffix == 'wishlist' or request.page_type == 'search' or request.page_type == 'cart' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    {% render 'meta-tags', seo_title: seo_title, seo_desc: seo_desc, seo_brand: seo_brand %}
    {% render 'structured-data' %}
    {% render 'fonts' %}

    <script>
      /* Apply the saved or device colour mode before first paint (no flash). */
      (function () {
        var mode = {{ settings.dark_mode | default: 'device' | json }};
        if (mode === 'off') return;
        var saved = null;
        try { saved = localStorage.getItem('luxetech:theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : (mode === 'device' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
    {% render 'css-variables' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.LuxeTech = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'experience.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {%- if request.page_type == 'index' -%}<h1 class="visually-hidden">{{ shop.name | escape }}: tech, home and lifestyle gear</h1>{%- endif -%}
      {%- if request.page_type == 'policy' -%}{% render 'policy-hero' %}{%- endif -%}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% section 'newsletter-popup' %}
    {% render 'welcome-back' %}
    {% render 'quick-add-modal' %}

    <div class="visually-hidden" aria-live="polite" role="status" id="A11yStatus"></div>
  </body>
</html>
