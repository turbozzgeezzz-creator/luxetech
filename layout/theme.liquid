<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    {%- comment -%}
      Security: browsers only run scripts from the sources below, so injected code can't load a script from anywhere
      else (LuxeDealers had this happen through a compromised app). Off in the theme editor.
      If a new app stops working, add its script domain here.
    {%- endcomment -%}
    {%- unless request.design_mode -%}
    <meta http-equiv="Content-Security-Policy" content="script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.shopify.com https://*.shopify.com https://*.shopifycloud.com https://*.shopifycdn.com https://shop.app https://*.shop.app https://connect.facebook.net https://www.google.com https://www.gstatic.com https://www.recaptcha.net https://www.googletagmanager.com https://www.google-analytics.com https://*.hcaptcha.com https://hcaptcha.com https://*.judge.me https://luxemail-tech.turbozzgeezzz.workers.dev; object-src 'none'; base-uri 'self'">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    {%- endunless -%}
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink }}">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">

    {%- liquid
      assign seo_brand = settings.seo_brand | default: shop.name
      assign seo_title = page_title
      if request.page_type == 'index' and settings.seo_home_title != blank
        assign seo_title = settings.seo_home_title
      endif
      assign seo_desc = page_description
      if request.page_type == 'index' and settings.seo_home_description != blank
        assign seo_desc = settings.seo_home_description
      endif
      if seo_desc == blank
        case request.page_type
          when 'product'
            assign seo_desc = product.description | strip_html | strip_newlines | truncate: 155
          when 'collection'
            assign seo_desc = collection.description | strip_html | strip_newlines | truncate: 155
            if seo_desc == blank
              assign seo_desc = 'Shop ' | append: collection.title | append: ' at ' | append: seo_brand | append: '. Hand-picked, dispatched in 3-4 business days with tracking.'
            endif
          when 'article'
            assign seo_desc = article.excerpt_or_content | strip_html | strip_newlines | truncate: 155
          when 'blog'
            assign seo_desc = 'Buying guides, care tips and news from the ' | append: seo_brand | append: ' team.'
          when 'page'
            assign seo_desc = page.content | strip_html | strip_newlines | truncate: 155
        endcase
      endif
      if seo_desc == blank
        assign seo_desc = settings.seo_home_description
      endif
    -%}
    <title>
      {{ seo_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- comment -%} Brand suffix only when the title still fits in search results (about 60 characters). {%- endcomment -%}
      {%- unless seo_title contains seo_brand or seo_title contains shop.name or seo_title.size > 42 %} &ndash; {{ seo_brand }}{% endunless -%}
    </title>
    <meta name="description" content="{{ seo_desc | escape }}">
    {%- liquid
      assign noindex = false
      if template.suffix == 'wishlist' or request.page_type == 'search' or request.page_type == 'cart' or request.page_type == 'customers/account' or request.page_type == 'customers/order'
        assign noindex = true
      endif
      # Filtered or re-sorted collection pages are near-duplicates of the main page: keep them out of Google.
      if request.page_type == 'collection'
        if collection.sort_by != blank and collection.sort_by != collection.default_sort_by
          assign noindex = true
        endif
        for f in collection.filters
          if f.active_values.size > 0 or f.min_value.value != nil or f.max_value.value != nil
            assign noindex = true
          endif
        endfor
      endif
    -%}
    {%- if noindex -%}<meta name="robots" content="noindex, follow">{%- endif -%}

    {% render 'meta-tags', seo_title: seo_title, seo_desc: seo_desc, seo_brand: seo_brand %}
    {% render 'structured-data' %}
    {% render 'fonts' %}

    <script>
      /* Apply the saved or device colour mode before first paint (no flash). */
      (function () {
        var mode = {{ settings.dark_mode | default: 'device' | json }};
        if (mode === 'off') return;
        var saved = null;
        try { saved = localStorage.getItem('luxetech:theme'); } catch (e) {}
        var dark = saved ? saved === 'dark' : (mode === 'device' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (dark) document.documentElement.setAttribute('data-theme', 'dark');
      })();
    </script>
    {% render 'css-variables' %}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.LuxeTech = {
        routes: {
          root: {{ routes.root_url | json }},
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          cartUpdate: {{ routes.cart_update_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        mail: {{ settings.luxemail_endpoint | json }} ? { endpoint: {{ settings.luxemail_endpoint | json }}{% if customer and customer.accepts_marketing %}, email: {{ customer.email | json }}, firstName: {{ customer.first_name | json }}{% endif %} } : null,
        moneyFormat: {{ shop.money_format | json }},
        currency: {{ cart.currency.iso_code | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'experience.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {%- if request.page_type == 'index' -%}<h1 class="visually-hidden">{{ shop.name | escape }}: tech, home and lifestyle gear</h1>{%- endif -%}
      {%- if request.page_type == 'policy' -%}{% render 'policy-hero' %}{%- endif -%}
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
    {% section 'newsletter-popup' %}
    {% render 'welcome-back' %}
    {% render 'quick-add-modal' %}

    <div class="visually-hidden" aria-live="polite" role="status" id="A11yStatus"></div>
  </body>
</html>
