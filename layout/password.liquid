<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" data-motion="{{ settings.motion }}"{% if settings.gold_shimmer %} data-shimmer{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    <title>{{ shop.name }}</title>
    {% render 'css-variables' %}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js'); window.Luxe = { routes: { root: {{ routes.root_url | json }} }, strings: { copied: {{ 'general.copied' | t | json }} } };</script>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
