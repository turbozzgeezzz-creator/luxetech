[
  {
    "name": "theme_info",
    "theme_name": "LuxeTech",
    "theme_version": "2.0.0",
    "theme_author": "Luxe Dealers",
    "theme_documentation_url": "https://tech.luxedealers.com",
    "theme_support_url": "https://tech.luxedealers.com"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Leave empty to use the Tech.LuxeDealers logo that ships with the theme."
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 260,
        "step": 10,
        "unit": "px",
        "default": 170
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, 32 x 32px recommended."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Tech.LuxeDealers palette: cool paper and white surfaces, near-black ink from the logo, and the logo violet for primary actions, links, sale prices and the signal dot. Stock colors carry meaning on every product card, so keep them distinguishable from the brand color."
      },
      {
        "type": "select",
        "id": "dark_mode",
        "label": "Dark mode",
        "options": [
          {
            "value": "device",
            "label": "Follow the device, with a toggle"
          },
          {
            "value": "toggle",
            "label": "Start light, with a toggle"
          },
          {
            "value": "off",
            "label": "Off"
          }
        ],
        "default": "device"
      },
      {
        "type": "header",
        "content": "Base"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#F2F3F5"
      },
      {
        "type": "color",
        "id": "color_subtle",
        "label": "Panels (image backgrounds, bands)",
        "default": "#E7E9ED"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface (cards, header)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (text, footer, dark bands)",
        "default": "#0B1220"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#586072"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Hairlines",
        "default": "#D3D7DE"
      },
      {
        "type": "header",
        "content": "Brand"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Brand violet (actions, links, sale prices)",
        "default": "#7D03FC"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Signal tint (save labels, highlight chips)",
        "default": "#EFE6FF"
      },
      {
        "type": "header",
        "content": "Status"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "In stock",
        "default": "#1E7A3C"
      },
      {
        "type": "color",
        "id": "color_warning",
        "label": "Low stock",
        "default": "#8F5B00"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Errors",
        "default": "#B42318"
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_label",
        "label": "Small label above the title",
        "options": [
          {
            "value": "vendor",
            "label": "Brand (vendor)"
          },
          {
            "value": "type",
            "label": "Product type"
          },
          {
            "value": "none",
            "label": "None"
          }
        ],
        "default": "vendor"
      },
      {
        "type": "checkbox",
        "id": "card_show_sku",
        "label": "Show SKU",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_show_rating",
        "label": "Show star rating when review data exists",
        "default": true,
        "info": "Reads the standard reviews.rating and reviews.rating_count product metafields written by Shopify Product Reviews and most review apps. Nothing is shown for products without review data."
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Enable quick add",
        "default": true
      },
      {
        "type": "select",
        "id": "card_quick_style",
        "label": "Quick add button",
        "options": [
          {
            "value": "button",
            "label": "Always visible under the price"
          },
          {
            "value": "hover",
            "label": "Show on hover over the image"
          }
        ],
        "default": "button"
      },
      {
        "type": "checkbox",
        "id": "card_second_image",
        "label": "Show second image on hover",
        "default": true
      },
      {
        "type": "select",
        "id": "card_image_ratio",
        "label": "Image shape",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait"
          },
          {
            "value": "landscape",
            "label": "Landscape"
          }
        ],
        "default": "square"
      },
      {
        "type": "header",
        "content": "Category color code"
      },
      {
        "type": "textarea",
        "id": "category_colors",
        "label": "Product type colors",
        "info": "Optional. One per line, as Product type: #hex (e.g. Audio: #1D4ED8). Cards show a small color tab next to the label so shoppers can scan categories at a glance. Types not listed get no tab."
      }
    ]
  },
  {
    "name": "Stock and badges",
    "settings": [
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Low stock when quantity is at or below",
        "min": 1,
        "max": 25,
        "step": 1,
        "default": 5,
        "info": "Only applies to variants where Shopify tracks inventory."
      },
      {
        "type": "text",
        "id": "stock_in_text",
        "label": "In stock message",
        "default": "In stock"
      },
      {
        "type": "text",
        "id": "stock_shipping_note",
        "label": "Shipping note after in stock",
        "default": "dispatched in 3-4 business days",
        "info": "Example: ships today. Leave empty to show only the in stock message."
      },
      {
        "type": "text",
        "id": "stock_backorder_text",
        "label": "Backordered message",
        "default": "Backordered, ships when restocked",
        "info": "Shown when a variant is out of stock but set to continue selling."
      },
      {
        "type": "range",
        "id": "new_badge_days",
        "label": "Show New badge for products published in the last",
        "min": 0,
        "max": 90,
        "step": 5,
        "unit": "d",
        "default": 0,
        "info": "0 turns the New badge off. Worth leaving off while the whole range is new, or every card says New."
      }
    ]
  },
  {
    "name": "Welcome offer",
    "settings": [
      {
        "type": "paragraph",
        "content": "New subscribers see this code after signing up in the popup, the footer or the newsletter band. Create the same code first in Shopify admin > Discounts, or customers will be shown a code that doesn't work."
      },
      {
        "type": "text",
        "id": "welcome_code",
        "label": "Discount code",
        "default": "WELCOME10"
      },
      {
        "type": "text",
        "id": "welcome_label",
        "label": "Offer in one line",
        "default": "10% off your first order"
      }
    ]
  },
  {
    "name": "Reviews",
    "settings": [
      {
        "type": "paragraph",
        "content": "Built for Judge.me. Install Judge.me, then turn on its app embed in Theme settings > App embeds. Stars on product cards and the reviews section on product pages fill in automatically."
      },
      {
        "type": "checkbox",
        "id": "judgeme_enabled",
        "label": "Show Judge.me reviews and stars",
        "default": true
      }
    ]
  },
  {
    "name": "Volume and bundle deals",
    "settings": [
      {
        "type": "paragraph",
        "content": "These only change what the store shows. Create the matching automatic discounts in Shopify admin > Discounts first, then turn them on here, so the saving shown is the saving customers get at checkout."
      },
      {
        "type": "header",
        "content": "Buy more, save more"
      },
      {
        "type": "checkbox",
        "id": "qty_breaks_enabled",
        "label": "Show quantity discounts on product pages",
        "default": false
      },
      {
        "type": "range",
        "id": "tier1_qty",
        "label": "Tier 1 quantity",
        "min": 2,
        "max": 10,
        "step": 1,
        "default": 2
      },
      {
        "type": "range",
        "id": "tier1_pct",
        "label": "Tier 1 saving",
        "min": 1,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 5
      },
      {
        "type": "range",
        "id": "tier2_qty",
        "label": "Tier 2 quantity",
        "min": 2,
        "max": 10,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "tier2_pct",
        "label": "Tier 2 saving",
        "min": 0,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 10,
        "info": "Set to 0% to show only tier 1."
      },
      {
        "type": "header",
        "content": "Bundles"
      },
      {
        "type": "checkbox",
        "id": "bundle_enabled",
        "label": "Show bundle saving",
        "default": false,
        "info": "Shown on Complete the set and the pair builder."
      },
      {
        "type": "range",
        "id": "bundle_pct",
        "label": "Bundle saving",
        "min": 1,
        "max": 50,
        "step": 1,
        "unit": "%",
        "default": 10
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When a product is added",
        "options": [
          {
            "value": "drawer",
            "label": "Open cart drawer"
          },
          {
            "value": "page",
            "label": "Go to cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": 0,
        "info": "Order subtotal, in your store's default currency, that unlocks free shipping. Must match the free shipping rate you set up in Settings > Shipping and delivery (the theme cannot create shipping rates). Set to 0 to hide the progress bar, the buy box line and the utility bar message."
      },
      {
        "type": "checkbox",
        "id": "cart_show_note",
        "label": "Show order note on cart page",
        "default": true
      }
    ]
  },
  {
    "name": "Store details",
    "settings": [
      {
        "type": "paragraph",
        "content": "Used in the footer business block. Anything left empty is simply not shown."
      },
      {
        "type": "textarea",
        "id": "store_address",
        "label": "Business address"
      },
      {
        "type": "textarea",
        "id": "support_hours",
        "label": "Support hours",
        "info": "Example: Mon-Fri 9am-6pm ET"
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "Support email"
      },
      {
        "type": "text",
        "id": "support_phone",
        "label": "Support phone"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "paragraph",
        "content": "Only platforms with a URL get an icon in the footer."
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "placeholder": "https://instagram.com/"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "placeholder": "https://tiktok.com/@"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube",
        "placeholder": "https://youtube.com/"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "placeholder": "https://facebook.com/"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X (Twitter)",
        "placeholder": "https://x.com/"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/"
      }
    ]
  },
  {
    "name": "Search",
    "settings": [
      {
        "type": "text",
        "id": "search_placeholder",
        "label": "Search bar placeholder",
        "default": "Search headphones, chargers, smart plugs..."
      },
      {
        "type": "checkbox",
        "id": "predictive_search",
        "label": "Show live product suggestions while typing",
        "default": true
      }
    ]
  },
  {
    "name": "Search engines",
    "settings": [
      {
        "type": "paragraph",
        "content": "Used in page titles and Google results. Individual pages, products and collections still use their own SEO title and description when set in Shopify admin."
      },
      {
        "type": "text",
        "id": "seo_brand",
        "label": "Brand name in titles",
        "default": "Tech.LuxeDealers"
      },
      {
        "type": "text",
        "id": "seo_home_title",
        "label": "Homepage title",
        "default": "Tech.LuxeDealers | Everyday Tech, Home & Lifestyle Gear"
      },
      {
        "type": "textarea",
        "id": "seo_home_description",
        "label": "Homepage description",
        "default": "Shop hand-picked tech, home and lifestyle gear at Tech.LuxeDealers. Wireless earbuds, chargers, smart kitchen and hair care, dispatched in 3-4 business days with tracking."
      }
    ]
  },
  {
    "name": "Spend and save",
    "settings": [
      {
        "type": "paragraph",
        "content": "Shows a progress bar in the cart. Keep these in line with your automatic discounts in Shopify (Discounts)."
      },
      {
        "type": "checkbox",
        "id": "spend_bar_enabled",
        "label": "Show spend-and-save bar in cart",
        "default": true
      },
      {
        "type": "number",
        "id": "spend_tier1_amount",
        "label": "Tier 1: spend (dollars)",
        "default": 100
      },
      {
        "type": "number",
        "id": "spend_tier1_pct",
        "label": "Tier 1: percent off",
        "default": 5
      },
      {
        "type": "number",
        "id": "spend_tier2_amount",
        "label": "Tier 2: spend (dollars)",
        "info": "0 turns tier 2 off.",
        "default": 150
      },
      {
        "type": "number",
        "id": "spend_tier2_pct",
        "label": "Tier 2: percent off",
        "default": 10
      }
    ]
  },
  {
    "name": "Email tracking",
    "settings": [
      {
        "type": "paragraph",
        "content": "Connects the store to LuxeMail, our own email automation. Newsletter sign-ups (with the consent box ticked) join LuxeMail's list. For browsers that signed up, it records product views, add-to-cart and wishlist saves so emails can recommend the right products. Leave empty to turn it off."
      },
      {
        "type": "text",
        "id": "luxemail_endpoint",
        "label": "LuxeMail tracking URL",
        "info": "For example https://luxemail-tech.your-account.workers.dev/t"
      }
    ]
  }
]