[
  {
    "name": "theme_info",
    "theme_name": "LuxeTech",
    "theme_version": "1.0.0",
    "theme_author": "Tech.LuxeDealers",
    "theme_documentation_url": "https://tech.luxedealers.com",
    "theme_support_url": "https://tech.luxedealers.com/pages/contact"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Leave empty to use the bundled LD diamond mark."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height (desktop)",
        "min": 32,
        "max": 96,
        "step": 2,
        "unit": "px",
        "default": 56
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square, at least 64 x 64 px. Leave empty to use the LD mark."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_subtle",
        "label": "Soft panels",
        "info": "Image backgrounds and quiet bands.",
        "default": "#F6F1FF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Text and dark buttons",
        "default": "#2E1460"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Secondary text",
        "default": "#6B5E8C"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Lines and borders",
        "default": "#ECE4FB"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Gold",
        "info": "Taken from the logo. Used for accents, sale prices and highlights.",
        "default": "#D9C4FF"
      },
      {
        "type": "color",
        "id": "color_gold_text",
        "label": "Gold text",
        "info": "A deeper gold that stays readable on white.",
        "default": "#8048F5"
      },
      {
        "type": "color",
        "id": "color_sapphire",
        "label": "Sapphire",
        "info": "The diamond blue. Used sparingly: focus rings and New badges.",
        "default": "#7A3FF0"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "In stock",
        "default": "#1E7A3C"
      },
      {
        "type": "color",
        "id": "color_error",
        "label": "Errors",
        "default": "#B42318"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "typeface",
        "label": "Typeface",
        "options": [
          {
            "value": "atelier",
            "label": "Atelier (Poppins)"
          },
          {
            "value": "maison",
            "label": "Maison (Jost and Cormorant)"
          },
          {
            "value": "custom",
            "label": "Fonts below"
          }
        ],
        "default": "atelier",
        "info": "Atelier and Maison are bundled with the theme. Pick Fonts below to use Shopify's font library."
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Headings",
        "default": "playfair_display_n4",
        "info": "Used when Typeface is set to Fonts below."
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body and labels",
        "default": "montserrat_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Animation",
    "settings": [
      {
        "type": "select",
        "id": "motion",
        "label": "Animation level",
        "options": [
          {
            "value": "off",
            "label": "Off"
          },
          {
            "value": "subtle",
            "label": "Subtle"
          },
          {
            "value": "full",
            "label": "Full"
          }
        ],
        "default": "full",
        "info": "Visitors whose device asks for reduced motion always get animations off."
      },
      {
        "type": "checkbox",
        "id": "gold_shimmer",
        "label": "Gold shimmer on the logo name and highlights",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "page_transitions",
        "label": "Fade between pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "intro_splash",
        "label": "Logo intro on first visit",
        "default": false,
        "info": "A short logo reveal, once per visit. Skipped for reduced motion."
      },
      {
        "type": "checkbox",
        "id": "view_cursor",
        "label": "View cursor over products",
        "default": true,
        "info": "Desktop only."
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Image shape",
        "options": [
          {
            "value": "portrait",
            "label": "Portrait 4:5"
          },
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "tall",
            "label": "Tall 2:3"
          }
        ],
        "default": "square"
      },
      {
        "type": "checkbox",
        "id": "card_hover_image",
        "label": "Show second photo on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_vendor",
        "label": "Show brand",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "card_quick_add",
        "label": "Quick add button",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_button",
        "label": "Show stock line and Add to bag button",
        "default": true,
        "info": "Replaces the hover Quick add."
      },
      {
        "type": "checkbox",
        "id": "card_swatches",
        "label": "Colour swatches",
        "info": "Shown for an option named Color, Colour or Dial.",
        "default": true
      },
      {
        "type": "range",
        "id": "badge_new_days",
        "label": "New badge for products published within",
        "min": 0,
        "max": 90,
        "step": 5,
        "unit": "d",
        "default": 30,
        "info": "0 turns the New badge off."
      },
      {
        "type": "range",
        "id": "low_stock_threshold",
        "label": "Low stock line at or below",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 3,
        "info": "Uses real tracked inventory only. 0 turns it off."
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "When something is added",
        "options": [
          {
            "value": "drawer",
            "label": "Open cart drawer"
          },
          {
            "value": "page",
            "label": "Go to cart page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping from (store currency)",
        "default": 0,
        "info": "0 hides the progress bar. Create the matching free rate in Settings > Shipping and delivery first."
      },
      {
        "type": "number",
        "id": "shipping_fee_below_threshold",
        "label": "Shipping fee below the free-shipping amount (store currency)",
        "default": 5.95,
        "info": "Shown in the cart. Must match the rate in Settings > Shipping and delivery."
      },
      {
        "type": "header",
        "content": "Spend and save"
      },
      {
        "type": "paragraph",
        "content": "Create matching automatic discounts in Discounts first (Amount off order, minimum purchase amount). Leave Spend at 0 to hide."
      },
      {
        "type": "number",
        "id": "tier_1_spend",
        "label": "Tier 1: spend (store currency)",
        "default": 0
      },
      {
        "type": "number",
        "id": "tier_1_percent",
        "label": "Tier 1: % off",
        "default": 5
      },
      {
        "type": "number",
        "id": "tier_2_spend",
        "label": "Tier 2: spend (store currency)",
        "default": 0
      },
      {
        "type": "number",
        "id": "tier_2_percent",
        "label": "Tier 2: % off",
        "default": 10
      },
      {
        "type": "header",
        "content": "Cookie banner"
      },
      {
        "type": "checkbox",
        "id": "cookie_banner",
        "label": "Show our cookie banner",
        "info": "Shown only where the law requires consent (Shopify decides, e.g. EU and UK). Stays hidden while another cookie app is active.",
        "default": true
      },
      {
        "type": "header",
        "content": "Buy more, save more"
      },
      {
        "type": "paragraph",
        "content": "Shows quantity offers on product pages and in the bag. Create matching automatic discounts in Discounts first (Amount off products, minimum quantity of items). Leave Pieces at 0 to hide."
      },
      {
        "type": "number",
        "id": "qty_1_count",
        "label": "Offer 1: pieces",
        "default": 0
      },
      {
        "type": "number",
        "id": "qty_1_percent",
        "label": "Offer 1: % off",
        "default": 10
      },
      {
        "type": "number",
        "id": "qty_2_count",
        "label": "Offer 2: pieces",
        "default": 0
      },
      {
        "type": "number",
        "id": "qty_2_percent",
        "label": "Offer 2: % off",
        "default": 15
      },
      {
        "type": "checkbox",
        "id": "cart_code_field",
        "label": "Discount code box in the bag",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "cart_gift_note",
        "label": "Gift message box",
        "default": false
      },
      {
        "type": "richtext",
        "id": "cart_note_text",
        "label": "Text under checkout button",
        "default": ""
      }
    ]
  },
  {
    "name": "Welcome offer",
    "settings": [
      {
        "type": "text",
        "id": "welcome_code",
        "label": "Discount code",
        "info": "Shown after someone subscribes. Create the same code in Discounts first. Leave empty to show no offer."
      },
      {
        "type": "checkbox",
        "id": "welcome_personal",
        "label": "LuxeMail gives each subscriber their own code",
        "default": false,
        "info": "Shows the welcome offer around the site without a shared code. The code appears after sign-up and is emailed too."
      },
      {
        "type": "text",
        "id": "welcome_offer",
        "label": "Offer line",
        "default": "10% off your first order"
      },
      {
        "type": "text",
        "id": "luxemail_endpoint",
        "label": "LuxeMail address",
        "info": "Filled in by the LuxeMail deploy. Leave empty if you don't use it."
      }
    ]
  },
  {
    "name": "Client services",
    "settings": [
      {
        "type": "header",
        "content": "Client advisor"
      },
      {
        "type": "text",
        "id": "advisor_whatsapp",
        "label": "WhatsApp number",
        "info": "International format, digits only, e.g. 447700900123. Shows a Contact an advisor button."
      },
      {
        "type": "text",
        "id": "advisor_label",
        "label": "Advisor button text",
        "default": "Contact an advisor"
      },
      {
        "type": "checkbox",
        "id": "advisor_float",
        "label": "Floating advisor button",
        "default": false
      },
      {
        "type": "header",
        "content": "Dispatch estimate"
      },
      {
        "type": "range",
        "id": "dispatch_days",
        "label": "Business days to dispatch",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 0,
        "info": "0 hides the estimate. Use your real handling time."
      },
      {
        "type": "range",
        "id": "dispatch_cutoff",
        "label": "Same-day cutoff hour (store time zone)",
        "min": 0,
        "max": 23,
        "step": 1,
        "default": 14
      },
      {
        "type": "header",
        "content": "Returning visitors"
      },
      {
        "type": "checkbox",
        "id": "welcome_back",
        "label": "Welcome back panel",
        "default": true,
        "info": "Shows the last piece a returning visitor looked at. Uses their own browsing on this device."
      }
    ]
  },
  {
    "name": "Store details",
    "settings": [
      {
        "type": "text",
        "id": "support_email",
        "label": "Support email",
        "default": "support@luxedealers.com"
      },
      {
        "type": "text",
        "id": "support_phone",
        "label": "Phone"
      },
      {
        "type": "text",
        "id": "support_hours",
        "label": "Opening hours"
      },
      {
        "type": "textarea",
        "id": "store_address",
        "label": "Business address"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram",
        "default": "https://www.instagram.com/tech.luxedealers/"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok",
        "default": ""
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook",
        "default": "https://www.facebook.com/profile.php?id=61595062625090"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest"
      },
      {
        "type": "text",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "text",
        "id": "social_x",
        "label": "X"
      }
    ]
  },
  {
    "name": "Search engines",
    "settings": [
      {
        "type": "text",
        "id": "seo_home_title",
        "label": "Homepage title",
        "default": "Tech.LuxeDealers | Smart Gadgets, Audio, Charging & Home Tech"
      },
      {
        "type": "textarea",
        "id": "seo_home_description",
        "label": "Homepage description",
        "default": "Shop hand-picked smart gadgets: earbuds, chargers, smart watches, home and kitchen tech. Tracked shipping on every order and real people to help."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social sharing image"
      }
    ]
  }
]
