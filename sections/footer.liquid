{%- assign s = section.settings -%}
<footer class="site-footer">
  {%- if s.show_promises and template.name != 'product' -%}
    <div class="footer__promises">
      <div class="container footer__promises-grid">
        {%- for i in (1..4) -%}
          {%- liquid
            assign ik = 'p_icon_' | append: i
            assign tk = 'p_title_' | append: i
            assign xk = 'p_text_' | append: i
          -%}
          {%- if s[tk] != blank -%}
            <div class="footer__promise"><span class="footer__promise-icon">{% render 'icon', name: s[ik] %}</span><div><strong>{{ s[tk] }}</strong><span>{{ s[xk] }}</span></div></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="container footer__main">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'brand' -%}
          <div class="footer__col footer__brand" {{ block.shopify_attributes }}>
            <img class="footer__logo-img" src="{{ 'logo-tech-luxedealers-light.png' | asset_url }}" width="1008" height="200" alt="{{ block.settings.title | default: shop.name | escape }}" loading="lazy">
            {%- if block.settings.text != blank -%}<div class="footer__about rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.service_title != blank -%}<span class="footer__title">{{ block.settings.service_title }}</span>{%- endif -%}
            {%- if block.settings.service_text != blank -%}<p class="footer__about">{{ block.settings.service_text }}</p>{%- endif -%}
            <ul class="footer__contact" role="list">
              {%- if settings.support_email != blank -%}<li><a href="mailto:{{ settings.support_email }}">{% render 'icon', name: 'mail', class: 'icon--sm' %}{{ settings.support_email }}</a></li>{%- endif -%}
              {%- if settings.support_phone != blank -%}<li><a href="tel:{{ settings.support_phone | remove: ' ' }}">{% render 'icon', name: 'phone', class: 'icon--sm' %}{{ settings.support_phone }}</a></li>{%- endif -%}
              {%- if block.settings.page != blank -%}<li><a href="{{ block.settings.page.url }}">{% render 'icon', name: 'chat', class: 'icon--sm' %}{{ 'footer.send_message' | t }}</a></li>{%- endif -%}
            </ul>
          </div>
        {%- when 'menu' -%}
          <details class="footer__col footer__accordion" open {{ block.shopify_attributes }}>
            <summary class="footer__title">{{ block.settings.title | default: block.settings.menu.title }} {% render 'icon', name: 'plus', class: 'icon-plus' %}</summary>
            <ul class="footer__links" role="list">
              {%- if block.settings.menu != blank -%}
                {%- for link in block.settings.menu.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
              {%- else -%}
                {%- for policy in shop.policies -%}<li><a href="{{ policy.url }}">{{ policy.title }}</a></li>{%- endfor -%}
              {%- endif -%}
            </ul>
          </details>
        {%- when 'newsletter' -%}
          <div class="footer__col footer__signup newsletter" {{ block.shopify_attributes }}>
            <span class="footer__signup-title">{{ block.settings.title }}</span>
            <p class="footer__about">{% if settings.welcome_offer != blank and settings.welcome_code != blank or settings.welcome_personal %}{{ 'footer.signup_offer' | t: offer: settings.welcome_offer }}{% else %}{{ block.settings.text }}{% endif %}</p>
            {% render 'newsletter-form', id: 'FooterNewsletter', source: 'footer' %}
            {% render 'social-links' %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>

  <div class="container footer__bottom">
    <div class="footer__legal-row">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'footer.rights' | t }}</span>
      <nav class="footer__legal" aria-label="{{ 'footer.legal' | t }}">
        {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}<a href="/pages/cookie-policy">{{ 'cookies.policy_title' | t }}</a><button type="button" class="footer__cookie" data-cookie-prefs>{{ 'cookies.prefs_link' | t }}</button>
      </nav>
    </div>
    <div class="footer__bottom-right">
      {%- if s.show_payment -%}
        <ul class="payment-icons" role="list" aria-label="{{ 'footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {% render 'localization', id: 'FooterLocalization' %}
    </div>
  </div>
  {%- if s.note != blank -%}<div class="container footer__note">{{ s.note }}</div>{%- endif -%}
</footer>


{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "show_promises", "label": "Show promise row", "default": true },
    { "type": "select", "id": "p_icon_1", "label": "Promise 1 icon", "options": [{ "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Secure" }, { "value": "chat", "label": "Chat" }, { "value": "diamond", "label": "Diamond" }], "default": "truck" },
    { "type": "text", "id": "p_title_1", "label": "Promise 1 title", "default": "Free shipping" },
    { "type": "text", "id": "p_text_1", "label": "Promise 1 text", "default": "On every order, tracked" },
    { "type": "select", "id": "p_icon_2", "label": "Promise 2 icon", "options": [{ "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Secure" }, { "value": "chat", "label": "Chat" }, { "value": "diamond", "label": "Diamond" }], "default": "return" },
    { "type": "text", "id": "p_title_2", "label": "Promise 2 title", "default": "Refund or reship" },
    { "type": "text", "id": "p_text_2", "label": "Promise 2 text", "default": "If something's not right" },
    { "type": "select", "id": "p_icon_3", "label": "Promise 3 icon", "options": [{ "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Secure" }, { "value": "chat", "label": "Chat" }, { "value": "diamond", "label": "Diamond" }], "default": "lock" },
    { "type": "text", "id": "p_title_3", "label": "Promise 3 title", "default": "Secure checkout" },
    { "type": "text", "id": "p_text_3", "label": "Promise 3 text", "default": "PayPal, Shop Pay and cards" },
    { "type": "select", "id": "p_icon_4", "label": "Promise 4 icon", "options": [{ "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Secure" }, { "value": "chat", "label": "Chat" }, { "value": "diamond", "label": "Diamond" }], "default": "chat" },
    { "type": "text", "id": "p_title_4", "label": "Promise 4 title", "default": "Real support" },
    { "type": "text", "id": "p_text_4", "label": "Promise 4 text", "default": "People, not bots" },
    { "type": "checkbox", "id": "show_payment", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "note", "label": "Small print" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "About and contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Tech.LuxeDealers" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Everyday tech, chosen by people who use it.</p>" },
        { "type": "text", "id": "service_title", "label": "Support heading", "default": "Customer service" },
        { "type": "text", "id": "service_text", "label": "Support text", "default": "Send us a message any time. Real people reply." },
        { "type": "page", "id": "page", "label": "Contact page" }
      ]
    },
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu", "info": "With no menu, the column lists your policies." }
      ]
    },
    {
      "type": "newsletter",
      "name": "Email sign-up",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Deal alerts" },
        { "type": "text", "id": "text", "label": "Text", "default": "New arrivals, restocks and subscriber-only offers by email." }
      ]
    }
  ]
}
{% endschema %}

