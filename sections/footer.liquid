{%- comment -%}
  Footer: brand and customer service, four link columns (Help, My account,
  About, Shop), deal alerts signup with the welcome offer and socials, then
  payment icons, small print and an oversized wordmark.
  Link columns use a menu when one is picked, otherwise built-in links that
  only appear when the page or policy they point to exists.
{%- endcomment -%}
{%- liquid
  assign has_social = false
  if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_youtube != blank or settings.social_facebook != blank or settings.social_x != blank or settings.social_pinterest != blank
    assign has_social = true
  endif
  assign terms_url = pages['terms-conditions'].url | default: shop.terms_of_service.url
  assign privacy_url = pages['privacy'].url | default: shop.privacy_policy.url
-%}
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'about' -%}
            <div class="footer__col footer__col--about" {{ block.shopify_attributes }}>
              <a href="{{ routes.root_url }}" class="footer__brand" aria-label="{{ shop.name | escape }} home">
                {%- if settings.logo != blank and block.settings.show_logo -%}
                  {{ settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200,400', sizes: '200px', alt: shop.name, class: 'footer__logo' }}
                {%- else -%}
                  <img src="{{ 'logo-tech-luxedealers-light.png' | asset_url }}" width="653" height="178" alt="{{ shop.name | escape }}" class="footer__logo" loading="lazy">
                {%- endif -%}
              </a>
              {%- if block.settings.text != blank -%}
                <div class="footer__about rte">{{ block.settings.text }}</div>
              {%- endif -%}
              <div class="footer__service">
                <h2 class="footer__subhead">{{ block.settings.service_heading | escape }}</h2>
                {%- if settings.support_hours != blank -%}
                  <p>{{ settings.support_hours | escape | newline_to_br }}</p>
                {%- elsif block.settings.service_text != blank -%}
                  <p>{{ block.settings.service_text | escape }}</p>
                {%- endif -%}
                <ul class="footer__contact" role="list">
                  {%- if settings.support_phone != blank -%}
                    <li>{% render 'icon', name: 'phone', class: 'icon--sm' %}<a href="tel:{{ settings.support_phone | remove: ' ' }}">{{ settings.support_phone | escape }}</a></li>
                  {%- endif -%}
                  {%- if settings.support_email != blank -%}
                    <li>{% render 'icon', name: 'mail', class: 'icon--sm' %}<a href="mailto:{{ settings.support_email }}">{{ settings.support_email | escape }}</a></li>
                  {%- endif -%}
                  {%- if pages.contact.url != blank -%}
                    <li>{% render 'icon', name: 'chat', class: 'icon--sm' %}<a href="{{ pages.contact.url }}">Send us a message</a></li>
                  {%- endif -%}
                  {%- if settings.store_address != blank -%}
                    <li>{% render 'icon', name: 'map-pin', class: 'icon--sm' %}<address>{{ settings.store_address | escape | newline_to_br }}</address></li>
                  {%- endif -%}
                </ul>
              </div>
            </div>

          {%- when 'links' -%}
            <nav class="footer__col" aria-labelledby="FooterHeading-{{ block.id }}" {{ block.shopify_attributes }}>
              <h2 class="footer__heading" id="FooterHeading-{{ block.id }}">{{ block.settings.heading | escape }}</h2>
              <ul class="footer__links" role="list">
                {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
                  {%- endfor -%}
                {%- else -%}
                  {%- case block.settings.fallback -%}
                    {%- when 'help' -%}
                      {%- if pages.contact.url != blank -%}<li><a href="{{ pages.contact.url }}">Contact us</a></li>{%- endif -%}
                      {%- if pages['shipping-delivery'].url != blank -%}<li><a href="{{ pages['shipping-delivery'].url }}">Shipping and delivery</a></li>{%- endif -%}
                      {%- if pages['returns-warranty'].url != blank -%}
                        <li><a href="{{ pages['returns-warranty'].url }}">Returns and refunds</a></li>
                      {%- elsif shop.refund_policy != blank -%}
                        <li><a href="{{ shop.refund_policy.url }}">Returns and refunds</a></li>
                      {%- endif -%}
                      {%- if pages.faq.url != blank -%}<li><a href="{{ pages.faq.url }}">FAQs</a></li>{%- endif -%}
                      {%- if pages['track-order'].url != blank -%}<li><a href="{{ pages['track-order'].url }}">Track my order</a></li>{%- endif -%}
                    {%- when 'account' -%}
                      {%- if shop.customer_accounts_enabled -%}
                        {%- if customer -%}
                          <li><a href="{{ routes.account_url }}">My account</a></li>
                          <li><a href="{{ routes.account_url }}">Order history</a></li>
                          <li><a href="{{ routes.account_logout_url }}">Sign out</a></li>
                        {%- else -%}
                          <li><a href="{{ routes.account_login_url }}">Sign in or register</a></li>
                          <li><a href="{{ routes.account_url }}">Order history</a></li>
                        {%- endif -%}
                      {%- endif -%}
                      <li><a href="{{ routes.cart_url }}">My cart</a></li>
                      {%- if pages.wishlist.url != blank -%}<li><a href="{{ pages.wishlist.url }}">My wishlist</a></li>{%- endif -%}
                    {%- when 'company' -%}
                      {%- if pages['about-us'].url != blank -%}<li><a href="{{ pages['about-us'].url }}">About us</a></li>{%- endif -%}
                      {%- if pages['about-us'].url != blank -%}<li><a href="{{ pages['about-us'].url }}#why">Why shop with us</a></li>{%- endif -%}
                      {%- if blogs.news.url != blank -%}<li><a href="{{ blogs.news.url }}">Guides and news</a></li>{%- endif -%}
                      <li><a href="{{ routes.root_url }}#deals">Deals and offers</a></li>
                      {%- if pages.contact.url != blank -%}<li><a href="{{ pages.contact.url }}">Get in touch</a></li>{%- endif -%}
                    {%- else -%}
                      <li><a href="{{ routes.all_products_collection_url }}?sort_by=created-descending">New arrivals</a></li>
                      {%- for c in collections -%}
                        {%- if c.handle == 'all' or c.handle == 'frontpage' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
                        <li><a href="{{ c.url }}">{{ c.title | escape }}</a></li>
                      {%- endfor -%}
                      <li><a href="{{ routes.all_products_collection_url }}">Shop everything</a></li>
                  {%- endcase -%}
                {%- endif -%}
              </ul>
            </nav>

          {%- when 'newsletter' -%}
            <div class="footer__col footer__col--newsletter" {{ block.shopify_attributes }}>
              <h2 class="footer__deal-title">{{ block.settings.heading | escape }}</h2>
              {%- if block.settings.text != blank -%}<p class="footer__text">{{ block.settings.text | escape }}</p>{%- endif -%}
              {% render 'newsletter-form', id: block.id, placeholder: 'Your email', button_label: block.settings.button_label, discount_code: settings.welcome_code, tags: 'newsletter,footer' %}
              {%- if block.settings.fine_print != blank -%}<p class="footer__fine">{{ block.settings.fine_print | escape }}</p>{%- endif -%}
              {%- if has_social -%}
                <ul class="social" role="list" aria-label="Follow us">
                  {%- if settings.social_facebook != blank -%}<li><a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook (opens in a new tab)">{% render 'icon', name: 'facebook' %}</a></li>{%- endif -%}
                  {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram (opens in a new tab)">{% render 'icon', name: 'instagram' %}</a></li>{%- endif -%}
                  {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube (opens in a new tab)">{% render 'icon', name: 'youtube' %}</a></li>{%- endif -%}
                  {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok (opens in a new tab)">{% render 'icon', name: 'tiktok' %}</a></li>{%- endif -%}
                  {%- if settings.social_x != blank -%}<li><a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X (opens in a new tab)">{% render 'icon', name: 'x' %}</a></li>{%- endif -%}
                  {%- if settings.social_pinterest != blank -%}<li><a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener" aria-label="Pinterest (opens in a new tab)">{% render 'icon', name: 'pinterest' %}</a></li>{%- endif -%}
                </ul>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__base">
    <div class="container footer__bottom">
      <div class="footer__legal">
        <p class="footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. All rights reserved.</p>
        {%- if section.settings.show_policies -%}
          <ul class="footer__policies" role="list">
            {%- if terms_url != blank -%}<li><a href="{{ terms_url }}">Terms</a></li>{%- endif -%}
            {%- if privacy_url != blank -%}<li><a href="{{ privacy_url }}">Privacy</a></li>{%- endif -%}
            {%- for policy in shop.policies -%}
              {%- if policy.url == terms_url or policy.url == privacy_url -%}{%- continue -%}{%- endif -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <div class="footer__end">
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="payment-icons">
            <span class="visually-hidden">Payment methods accepted</span>
            <ul class="payment-icons__list" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        {% render 'currency-selector', id: 'footer', variant: 'footer' %}
      </div>
    </div>
    <div class="container footer__fine">
      {%- if section.settings.small_print != blank -%}<p>{{ section.settings.small_print | escape }}</p>{%- endif -%}
      <p>Protected by hCaptcha. Its <a href="https://www.hcaptcha.com/privacy" target="_blank" rel="noopener">Privacy Policy</a> and <a href="https://www.hcaptcha.com/terms" target="_blank" rel="noopener">Terms of Service</a> apply.</p>
    </div>
    <div class="footer__wordmark" aria-hidden="true">{{ section.settings.wordmark | escape }}</div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 7,
  "settings": [
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true, "info": "Pulled automatically from your Shopify payment settings." },
    { "type": "checkbox", "id": "show_policies", "label": "Show policy links", "default": true },
    { "type": "text", "id": "small_print", "label": "Small print", "default": "Prices and stock can change without notice. Photos may differ slightly from the item you receive." },
    { "type": "text", "id": "wordmark", "label": "Large wordmark", "default": "TECH.LUXEDEALERS" }
  ],
  "blocks": [
    {
      "type": "about",
      "name": "About and service",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_logo", "label": "Use uploaded logo", "default": false, "info": "Off uses the white version of the Tech.LuxeDealers logo." },
        { "type": "richtext", "id": "text", "label": "About text", "default": "<p>Everyday tech, chosen by people who use it. Audio, charging, smart kitchen and wearables, with straight answers and tracked delivery.</p>" },
        { "type": "text", "id": "service_heading", "label": "Customer service heading", "default": "Customer service" },
        { "type": "text", "id": "service_text", "label": "Customer service text", "default": "Send us a message any time. We aim to reply within one business day.", "info": "Replaced by Support hours from Theme settings > Store details when those are filled in." }
      ]
    },
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "select", "id": "fallback", "label": "Links to show if no menu is chosen", "options": [
          { "value": "shop", "label": "Shop" },
          { "value": "help", "label": "Help" },
          { "value": "account", "label": "My account" },
          { "value": "company", "label": "About" }
        ], "default": "shop" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Deal alerts and social",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Deal alerts" },
        { "type": "text", "id": "text", "label": "Text", "default": "Sign up for 10% off your first order, plus restocks and subscriber-only offers." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" },
        { "type": "text", "id": "fine_print", "label": "Fine print", "default": "By signing up you agree to receive marketing emails. Unsubscribe any time." }
      ]
    }
  ]
}
{% endschema %}
