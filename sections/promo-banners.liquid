{%- if section.blocks.size > 0 -%}
<section class="section">
  <div class="container">
    <ul class="promo-grid promo-grid--{{ section.blocks.size | at_most: 3 }}" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="promo slide--text-{{ block.settings.text_tone }}" style="--slide-bg: {{ block.settings.background }};">
            <span class="promo__copy">
              {%- if block.settings.kicker != blank -%}<span class="slide__kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
              <span class="promo__heading">{{ block.settings.heading | escape }}</span>
              {%- if block.settings.text != blank -%}<span class="promo__text">{{ block.settings.text | escape }}</span>{%- endif -%}
              <span class="promo__cta">{{ block.settings.link_label | escape }}</span>
            </span>
            <span class="promo__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 280px, 45vw', alt: block.settings.image.alt, class: 'promo__img' }}
              {%- else -%}
                {% render 'placeholder-art', type: 'product', class: 'promo__img' %}
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Promo banners",
  "max_blocks": 3,
  "settings": [],
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product image", "info": "Cut-out product shots on a transparent background look best." },
        { "type": "color", "id": "background", "label": "Background", "default": "#ECEDE8" },
        { "type": "select", "id": "text_tone", "label": "Text color", "options": [
          { "value": "dark", "label": "Dark" },
          { "value": "light", "label": "Light" }
        ], "default": "dark" },
        { "type": "text", "id": "kicker", "label": "Small line above heading" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Banner heading" },
        { "type": "text", "id": "text", "label": "Text", "default": "A short line about what this links to." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banners",
      "blocks": [
        { "type": "banner" },
        { "type": "banner", "settings": { "background": "#1D1E1B", "text_tone": "light", "heading": "Second banner heading", "link_label": "Shop now" } }
      ]
    }
  ]
}
{% endschema %}
