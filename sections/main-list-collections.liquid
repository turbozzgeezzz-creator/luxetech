<div class="container page">
  <h1 class="page-title">All categories</h1>
  {%- if collections.size > 0 -%}
    <ul class="collection-list" role="list">
      {%- for c in collections -%}
        <li>
          <a href="{{ c.url }}" class="collection-tile">
            <span class="collection-tile__media ratio ratio--landscape">
              {%- if c.image -%}
                {{ c.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
              {%- elsif c.products.first.featured_media -%}
                {{ c.products.first.featured_media.preview_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 990px) 25vw, 50vw', alt: '' }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </span>
            <span class="collection-tile__title">{{ c.title | escape }}</span>
            <span class="collection-tile__count">{{ c.products_count }} {{ c.products_count | pluralize: 'product', 'products' }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="empty-state">No categories have been published yet.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
