{%- comment -%}
  Top bar: short selling points with icons. All of them show in a row on
  wide screens; phones rotate through them. The country selector sits on
  the right. Messages marked "Needs welcome code" only appear once a code is
  set in Theme settings > Welcome offer, so no offer is shown that can't be
  redeemed.
{%- endcomment -%}
{%- liquid
  assign shown = 0
  for block in section.blocks
    if block.settings.needs_code and settings.welcome_code == blank and settings.welcome_personal != true
      continue
    endif
    if block.settings.needs_tiers and settings.tier_1_spend == 0
      continue
    endif
    if block.settings.needs_qty and settings.qty_1_count < 2
      continue
    endif
    assign shown = shown | plus: 1
  endfor
-%}
{%- if shown > 0 -%}
<div class="announcement announcement--usp" role="region" aria-label="{{ 'header.announcements' | t }}">
  <div class="container announcement__inner">
    <ul class="usp-list" role="list" data-rotator="{{ section.settings.speed }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.needs_code and settings.welcome_code == blank and settings.welcome_personal != true -%}{%- continue -%}{%- endif -%}
        {%- if block.settings.needs_tiers and settings.tier_1_spend == 0 -%}{%- continue -%}{%- endif -%}
        {%- if block.settings.needs_qty and settings.qty_1_count < 2 -%}{%- continue -%}{%- endif -%}
        <li class="usp announcement__msg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- capture inner -%}{% render 'icon', name: block.settings.icon, class: 'icon--sm' %}<span>{{ block.settings.text }}</span>{%- endcapture -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}"{% if block.settings.opens_popup %} data-open-popup{% endif %}>{{ inner }}</a>
          {%- elsif block.settings.opens_popup -%}
            <button type="button" data-open-popup>{{ inner }}</button>
          {%- else -%}
            {{ inner }}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_localization -%}
      <div class="announcement__loc">{% render 'localization', id: 'TopLocalization', direction: 'down', show_language: false, compact: true %}</div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "settings": [
    { "type": "range", "id": "speed", "label": "Seconds per message on phones", "min": 3, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_localization", "label": "Show country selector", "default": true }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "percent", "label": "Percent" },
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Secure" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "chat", "label": "Chat" },
            { "value": "check", "label": "Check" },
            { "value": "tag", "label": "Tag" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on every order" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "opens_popup", "label": "Opens the email popup", "default": false },
        { "type": "checkbox", "id": "needs_code", "label": "Needs welcome code", "default": false, "info": "Hide this message until a code is set in Theme settings > Welcome offer." },
        { "type": "checkbox", "id": "needs_qty", "label": "Needs buy-more-save-more", "default": false, "info": "Hide this message unless Theme settings > Cart > Buy more, save more is set." },
        { "type": "checkbox", "id": "needs_tiers", "label": "Needs spend and save", "default": false, "info": "Hide this message until tiers are set in Theme settings > Cart." }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
