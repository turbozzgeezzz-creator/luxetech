{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'logo' and block.settings.image != blank -%}
      <span class="marquee__item">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}{{ block.settings.image | image_url: height: 120 | image_tag: height: 44, loading: 'lazy', alt: block.settings.name }}{%- if block.settings.link != blank -%}</a>{%- endif -%}<i class="marquee__sep" aria-hidden="true"></i></span>
    {%- else -%}
      <span class="marquee__item{% if section.settings.style == 'label' %} marquee__item--label{% endif %}">{%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | default: block.settings.name }}</a>{%- else -%}{{ block.settings.text | default: block.settings.name }}{%- endif -%}<i class="marquee__sep" aria-hidden="true"></i></span>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if section.blocks.size > 0 -%}
<div class="marquee{% if section.settings.ink %} marquee--ink{% endif %}{% if section.settings.reverse %} marquee--reverse{% endif %}" style="--speed: {{ section.settings.speed }}s" role="region" aria-label="{{ section.settings.label | escape }}">
  <div class="marquee__track">
    <div class="marquee__group">{{ items }}{{ items }}</div>
    <div class="marquee__group" aria-hidden="true">{{ items }}{{ items }}</div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Scrolling text",
  "class": "section-marquee",
  "settings": [
    { "type": "text", "id": "label", "label": "Name for screen readers", "default": "Highlights" },
    {
      "type": "select",
      "id": "style",
      "label": "Text style",
      "options": [
        { "value": "serif", "label": "Large serif" },
        { "value": "label", "label": "Small capitals" }
      ],
      "default": "serif"
    },
    { "type": "checkbox", "id": "ink", "label": "Black background", "default": false },
    { "type": "checkbox", "id": "reverse", "label": "Scroll the other way", "default": false },
    { "type": "range", "id": "speed", "label": "Loop time", "min": 10, "max": 90, "step": 5, "unit": "s", "default": 45 }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "New arrivals" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "name", "label": "Brand name" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        { "type": "text", "settings": { "text": "Watches" } },
        { "type": "text", "settings": { "text": "Fine jewellery" } },
        { "type": "text", "settings": { "text": "Designer bags" } },
        { "type": "text", "settings": { "text": "Ready-to-wear" } },
        { "type": "text", "settings": { "text": "Accessories" } }
      ]
    }
  ]
}
{% endschema %}
