{%- comment -%}
  Brand statement with numbered principles. Keep every principle to something the
  store actually does; the defaults only restate what the About, Shipping and
  Returns pages already promise.
{%- endcomment -%}
<section class="section brand-story" aria-labelledby="Heading-{{ section.id }}">
  <div class="container brand-story__grid">
    <div class="brand-story__lead">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="section-head__title brand-story__heading" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.statement != blank -%}
        <div class="brand-story__statement">{{ section.settings.statement }}</div>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.root_url }}" class="section-head__link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="principles" role="list">
        {%- for block in section.blocks -%}
          <li class="principle" {{ block.shopify_attributes }}>
            <span class="principle__no" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
            <div class="principle__body">
              <h3 class="principle__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="principle__text">{{ block.settings.text | escape }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Why the list is short" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Chosen, not listed" },
    { "type": "richtext", "id": "statement", "label": "Statement", "default": "<p>Most tech stores list everything a supplier offers. We'd rather keep a short range of things people use every day, and be straight about each one.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "More about us" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Principle",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Principle" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "principle", "settings": { "title": "A short range on purpose", "text": "Charging, audio, small appliances and wearables. If we wouldn't use it ourselves, it doesn't go on the list." } },
        { "type": "principle", "settings": { "title": "Stock you can see", "text": "Stock levels come from our inventory and update as orders come in, so in stock means we can send it." } },
        { "type": "principle", "settings": { "title": "The full price, up front", "text": "Delivery options and costs for your address are shown at checkout before you pay." } }
      ]
    }
  ]
}
{% endschema %}
