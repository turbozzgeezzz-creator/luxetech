{%- comment -%}
  Newsletter sign-up card: illustration, offer and perks, and the form on its
  own white panel so it reads clearly in light and dark mode.
{%- endcomment -%}
<section class="section" id="newsletter">
  <div class="container">
    <div class="news-card tone tone--violet">
      <div class="news-card__art art-box">{% render 'ill', name: 'ill-newsletter', image: section.settings.image, sizes: '(min-width: 990px) 22vw, 50vw' %}</div>
      <div class="news-card__copy">
        {%- if section.settings.kicker != blank -%}<p class="tone-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h2 class="news-card__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="news-card__text">{{ section.settings.text }}</div>{%- endif -%}
        <ul class="news-card__perks" role="list">
          {%- for i in (1..3) -%}
            {%- assign perk_key = 'perk_' | append: i -%}
            {%- if section.settings[perk_key] != blank -%}
              <li>{% render 'icon', name: 'check-circle', class: 'icon--sm' %}<span>{{ section.settings[perk_key] | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      <div class="news-card__panel">
        <p class="news-card__panel-title">{{ settings.welcome_label | escape }}</p>
        <p class="news-card__panel-sub">{{ section.settings.panel_text | escape }}</p>
        {% render 'newsletter-form', id: section.id, button_label: section.settings.button_label, discount_code: settings.welcome_code, tags: 'newsletter,homepage' %}
        <p class="news-card__fine">{{ section.settings.fine_print | escape }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Replaces the illustration." },
    { "type": "text", "id": "kicker", "label": "Small line above heading", "default": "Welcome offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear about deals and new arrivals first" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Occasional emails with restocks, new products and subscriber offers.</p>" },
    { "type": "text", "id": "perk_1", "label": "Perk 1", "default": "10% off your first order" },
    { "type": "text", "id": "perk_2", "label": "Perk 2", "default": "Early access to deals and restocks" },
    { "type": "text", "id": "perk_3", "label": "Perk 3", "default": "Expert guides, never spam" },
    { "type": "text", "id": "panel_text", "label": "Form text", "default": "Enter your email and your code appears straight away." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my code" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "By signing up you agree to get our emails. Unsubscribe any time." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
