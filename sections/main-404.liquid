<script>
  // Old order-status and account links (/orders/…, /profile) now live in customer accounts.
  if (/^\/(orders|profile)(\/|$)/.test(location.pathname)) location.replace({{ routes.account_url | json }});
</script>
<section class="container not-found">
  <div class="page-hero__inner">
    <p class="not-found__num gold-text" aria-hidden="true">404</p>
    <h1 class="h2">{{ 'general.not_found' | t }}</h1>
    <p class="muted">{{ 'general.not_found_sub' | t }}</p>
    <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center">
      <a class="btn" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      <button type="button" class="btn btn--outline" data-drawer-open="SearchOverlay">{{ 'header.search' | t }}</button>
    </div>
  </div>
</section>


<template id="TrackOrderView">{% render 'track-order' %}</template>
<script>
  (function () {
    if (!/track-(your-)?order/.test(location.pathname)) return;
    var t = document.getElementById('TrackOrderView'), nf = document.querySelector('.not-found');
    if (!t || !nf) return;
    nf.replaceWith(t.content.cloneNode(true));
    document.title = {{ 'track.title' | t | json }} + ' – ' + {{ shop.name | json }};
  })();
</script>

<template id="CookiePolicyView">
  {%- assign cpt = 'cookies.policy_title' | t -%}{%- assign cpx = 'cookies.policy_intro' | t -%}
  {% render 'page-banner', title: cpt, eyebrow: 'Legal', text: cpx, art: 'ill-terms' %}
  <div class="container page-body"><div class="page-body__card rte">{% render 'cookie-policy-content' %}</div></div>
</template>
<script>
  (function () {
    if (!/\/pages\/cookie-policy\/?$/.test(location.pathname)) return;
    var t = document.getElementById('CookiePolicyView'), nf = document.querySelector('.not-found');
    if (!t || !nf) return;
    nf.replaceWith(t.content.cloneNode(true));
    document.title = {{ 'cookies.policy_title' | t | json }} + ' – ' + {{ shop.name | json }};
  })();
</script>

{% schema %}
{ "name": "404" }
{% endschema %}
