{%- assign s = section.settings -%}
<section class="section">
  <div class="container">
    {%- if s.heading != blank -%}
      <div class="section-head">
        <div class="section-head__text">
          {%- if s.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ s.eyebrow }}</span>{%- endif -%}
          <h2 class="h2" data-split>{{ s.heading | newline_to_br }}</h2>
        </div>
      </div>
    {%- endif -%}
    <div class="bento" data-stagger>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <a class="bento__tile bento__tile--{{ b.size }}{% if b.image != blank %} has-image{% endif %}" href="{{ b.link | default: routes.all_products_collection_url }}" {% if b.opens_popup %}data-open-popup{% endif %} {{ block.shopify_attributes }}>
          <div class="bento__media">{%- if b.image != blank -%}{% render 'image', image: b.image, sizes: '(min-width: 750px) 50vw, 100vw' %}{%- else -%}{% render 'placeholder' %}{%- endif -%}</div>
          <div class="bento__body">
            {%- if b.eyebrow != blank -%}<span class="eyebrow eyebrow--plain"{% if b.image != blank %} style="color: rgba(255,255,255,.8)"{% endif %}>{{ b.eyebrow }}</span>{%- endif -%}
            <span class="bento__title">{{ b.title }}</span>
            {%- if b.text != blank -%}<span style="opacity: .8; font-size: 14px">{{ b.text }}</span>{%- endif -%}
            {%- if b.cta != blank -%}<span class="link">{{ b.cta }}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bento grid",
  "class": "section-bento",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "textarea", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            { "value": "sm", "label": "Small" },
            { "value": "wide", "label": "Wide" },
            { "value": "tall", "label": "Tall" },
            { "value": "lg", "label": "Large" }
          ],
          "default": "sm"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Small heading" },
        { "type": "text", "id": "title", "label": "Title", "default": "New in" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "opens_popup", "label": "Opens the email popup", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Bento grid",
      "blocks": [
        { "type": "tile", "settings": { "size": "lg", "title": "The watch edit" } },
        { "type": "tile", "settings": { "size": "wide", "title": "Fine jewellery" } },
        { "type": "tile", "settings": { "size": "sm", "title": "Bags" } },
        { "type": "tile", "settings": { "size": "sm", "title": "Gifts" } }
      ]
    }
  ]
}
{% endschema %}
