{%- assign s = section.settings -%}
<section class="section rich-text{% if s.align == 'left' %} rich-text--left{% endif %}{% if s.subtle %} section--subtle{% endif %}">
  <div class="container">
    <div class="rich-text__inner">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}<span class="eyebrow" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- when 'heading' -%}<h2 class="h2" data-split {{ block.shopify_attributes }}>{{ block.settings.text | newline_to_br }}</h2>
          {%- when 'quote' -%}<p class="rich-text__quote" data-split {{ block.shopify_attributes }}>{{ block.settings.text | newline_to_br }}</p>
          {%- when 'text' -%}<div class="rte muted" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'button' -%}<a class="btn{% if block.settings.outline %} btn--outline{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-reveal {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- when 'logo' -%}<span class="eyebrow eyebrow--plain" aria-hidden="true" {{ block.shopify_attributes }}></span>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "class": "section-rich-text",
  "settings": [
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Centre" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "subtle", "label": "Soft background", "default": false }
  ],
  "blocks": [
    { "type": "logo", "name": "Spacer", "limit": 1, "settings": [] },
    { "type": "eyebrow", "name": "Small heading", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Our story" }] },
    { "type": "heading", "name": "Heading", "settings": [{ "type": "textarea", "id": "text", "label": "Text", "default": "Considered style" }] },
    { "type": "quote", "name": "Large statement", "settings": [{ "type": "textarea", "id": "text", "label": "Text", "default": "Every order is hand-checked, carefully packed and sent with tracking." }] },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" }] },
    {
      "type": "button",
      "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Discover" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "checkbox", "id": "outline", "label": "Outline style", "default": true }
      ]
    }
  ],
  "presets": [
    { "name": "Rich text", "blocks": [{ "type": "quote" }, { "type": "button" }] }
  ]
}
{% endschema %}
