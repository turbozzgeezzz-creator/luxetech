<div class="container container--narrow page{% if page.content == blank %} page--title-only{% endif %}">
  <h1 class="page-title">{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Page content",
  "settings": []
}
{% endschema %}
