<div class="container container--narrow page{% if page.content == blank %} page--title-only{% endif %}{% unless section.settings.show_title %} page--no-title{% endunless %}">
  {%- if section.settings.show_title -%}<h1 class="page-title">{{ page.title | escape }}</h1>{%- endif -%}
  {%- if page.content != blank -%}<div class="rte">{{ page.content }}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "Page content",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true, "info": "Turn off when a Page banner above already shows the title." }
  ]
}
{% endschema %}
