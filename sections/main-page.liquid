{%- if section.settings.show_title -%}
  {% render 'page-banner', title: page.title, art: section.settings.art %}
{%- endif -%}
{%- if page.content != blank -%}
  <div class="container page-body">
    <div class="page-body__card rte" data-reveal>{{ page.content }}</div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Page content",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true },
    { "type": "select", "id": "art", "label": "Illustration", "default": "diamond", "options": [
      { "value": "diamond", "label": "Diamond" }, { "value": "envelope", "label": "Envelope" }, { "value": "gift", "label": "Gift" },
      { "value": "parcel", "label": "Parcel" }, { "value": "coupon", "label": "Coupon" } ] }
  ]
}
{% endschema %}
