{%- assign s = section.settings -%}
<section class="section helpc">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="h2">{{ s.heading }}</h2>
      </div>
      {%- if s.link_label != blank -%}<a class="pill-link" href="{{ s.link }}">{{ s.link_label }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>{%- endif -%}
    </div>
    <div class="helpc__grid">
      {%- for block in section.blocks -%}
        <div class="helpc__card" {{ block.shopify_attributes }}>
          <span class="helpc__q">Q.</span>
          <h3>{{ block.settings.question }}</h3>
          <div class="rte">{{ block.settings.answer }}</div>
          {%- if block.settings.link != blank -%}<a class="link" href="{{ block.settings.link }}">{{ block.settings.link_label }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>{%- endif -%}
        </div>
      {%- endfor -%}
      <div class="helpc__card helpc__card--dark">
        <h3>{{ s.cta_heading }}</h3>
        <p>{{ s.cta_text }}</p>
        <a class="btn btn--gold btn--sm" href="{{ s.cta_link }}">{{ s.cta_button }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Help cards",
  "class": "section-helpc",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Help desk" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you buy" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "All FAQs" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "cta_heading", "label": "Dark card heading", "default": "Still not sure?" },
    { "type": "text", "id": "cta_text", "label": "Dark card text", "default": "Questions go to a real person on our team." },
    { "type": "text", "id": "cta_button", "label": "Dark card button", "default": "Ask us" },
    { "type": "url", "id": "cta_link", "label": "Dark card link" }
  ],
  "blocks": [
    { "type": "q", "name": "Question", "settings": [ { "type": "text", "id": "question", "label": "Question", "default": "Question" }, { "type": "richtext", "id": "answer", "label": "Answer" }, { "type": "url", "id": "link", "label": "Link" }, { "type": "text", "id": "link_label", "label": "Link text", "default": "Read more" } ] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Help cards", "blocks": [{ "type": "q" }, { "type": "q" }, { "type": "q" }] }]
}
{% endschema %}
