{%- comment -%}
  "You might also like" rail. Loads Shopify's related-product recommendations
  over the Section Rendering API so the product page itself stays fast.
{%- endcomment -%}
<product-recommendations
  class="section"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="section-head">
        <h2 class="section-head__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        <div class="section-head__aside">
          <div class="rail-arrows" data-rail-arrows hidden>
            <button type="button" class="rail-arrow" data-rail-prev aria-label="Scroll products left">{% render 'icon', name: 'chevron-left', class: 'icon--sm' %}</button>
            <button type="button" class="rail-arrow" data-rail-next aria-label="Scroll products right">{% render 'icon', name: 'chevron-right', class: 'icon--sm' %}</button>
          </div>
        </div>
      </div>
      <product-rail class="rail">
        <ul class="rail__track" role="list" tabindex="0" aria-labelledby="Heading-{{ section.id }}">
          {%- for rec in recommendations.products -%}
            <li class="rail__item">{% render 'product-card', product: rec, section_id: section.id %}</li>
          {%- endfor -%}
        </ul>
      </product-rail>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "options": [
      { "value": "related", "label": "Related (similar products)" },
      { "value": "complementary", "label": "Complementary (works with this)" }
    ], "default": "related", "info": "Complementary products are set up in the Shopify Search & Discovery app." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 8 }
  ]
}
{% endschema %}
