{%- comment -%}
  Offers row: the welcome offer (only when a code is set in Theme settings),
  a two-product bundle with the real combined price, and the newest arrivals.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="section deals">
  <div class="container">
    <div class="section-head">
      <div class="section-head__text">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="h2">{{ s.heading }}</h2>
      </div>
    </div>
    <div class="deals__grid">
      <div class="deal deal--offer tile tile--noir">
        <div class="tile__art">{% render 'illustration', name: s.offer_illustration, sizes: '30vw', class: 'tile__img' %}</div>
        <div class="tile__text">
          {%- if settings.welcome_code != blank or settings.welcome_personal -%}
            <span class="tile__eyebrow">{{ s.offer_eyebrow }}</span>
            <h3 class="tile__title tile__title--lg">{{ settings.welcome_offer }}</h3>
            <p class="tile__copy">{{ s.offer_text }}</p>
            <button type="button" class="btn btn--gold btn--sm" data-open-popup>{{ s.offer_button }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button>
          {%- else -%}
            <span class="tile__eyebrow">{{ s.list_eyebrow }}</span>
            <h3 class="tile__title tile__title--lg">{{ s.list_heading }}</h3>
            <p class="tile__copy">{{ s.list_text }}</p>
            <button type="button" class="btn btn--gold btn--sm" data-open-popup>{{ s.list_button }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button>
          {%- endif -%}
        </div>
      </div>

      {%- assign p1 = s.product_1 -%}
      {%- assign p2 = s.product_2 -%}
      {%- if p1 != blank and p2 != blank -%}
        {%- assign v1 = p1.selected_or_first_available_variant -%}
        {%- assign v2 = p2.selected_or_first_available_variant -%}
        <div class="deal deal--bundle">
          <span class="deal__kicker">{{ s.bundle_eyebrow }}</span>
          <h3 class="deal__title">{{ s.bundle_heading }}</h3>
          <div class="bundle">
            {%- for p in (1..2) -%}
              {%- if forloop.first -%}{%- assign bp = p1 -%}{%- assign bv = v1 -%}{%- else -%}{%- assign bp = p2 -%}{%- assign bv = v2 -%}{%- endif -%}
              <a class="bundle__item" href="{{ bp.url }}" data-pid="{{ bp.id }}">
                <span class="bundle__img">{{ bp.featured_media.preview_image | image_url: width: 400 | image_tag: width: 200, height: 200, loading: 'lazy', alt: bp.title }}</span>
                <span class="bundle__name">{{ bp.title }}</span>
                <span class="bundle__price">{{ bv.price | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</span>
              </a>
              {%- if forloop.first -%}<span class="bundle__plus" aria-hidden="true">+</span>{%- endif -%}
            {%- endfor -%}
          </div>
          <form class="bundle__foot" action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="items[0][id]" value="{{ v1.id }}"><input type="hidden" name="items[0][quantity]" value="1">
            <input type="hidden" name="items[1][id]" value="{{ v2.id }}"><input type="hidden" name="items[1][quantity]" value="1">
            <span><small>{{ 'sections.together' | t }}</small><strong>{{ v1.price | plus: v2.price | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</strong></span>
            {%- if v1.available and v2.available -%}<button type="submit" class="btn btn--sm">{% render 'icon', name: 'cart', class: 'icon--sm' %} {{ 'sections.add_both' | t }}</button>{%- endif -%}
          </form>
          {%- if p1.variants.size > 1 or p2.variants.size > 1 -%}<p class="deal__note">{{ 'sections.bundle_note' | t }}</p>{%- endif -%}
        </div>
      {%- endif -%}

      {%- assign nc = s.new_collection -%}
      {%- if nc != blank -%}
        <div class="deal deal--new">
          <span class="deal__kicker">{{ s.new_eyebrow }}</span>
          <h3 class="deal__title">{{ s.new_heading }}</h3>
          <ul class="mini-list" role="list">
            {%- for p in nc.products limit: 4 -%}
              <li data-pid="{{ p.id }}"><a href="{{ p.url }}">
                <span class="mini-list__img">{{ p.featured_media.preview_image | image_url: width: 140 | image_tag: width: 64, height: 64, loading: 'lazy', alt: p.title }}</span>
                <span class="mini-list__name">{{ p.title }}</span>
                <strong>{{ p.price | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</strong>
              </a></li>
            {%- endfor -%}
          </ul>
          <a class="link" href="{{ nc.url }}">{{ s.new_link }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Offers row",
  "class": "section-deals",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Offers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Deals, sets and new drops" },
    { "type": "header", "content": "Offer card" },
    { "type": "select", "id": "offer_illustration", "label": "Illustration", "options": [{"value": "none", "label": "None"}, {"value": "lx-watch", "label": "Smart watch"}, {"value": "lx-bag", "label": "Shopping bag"}, {"value": "lx-sneaker", "label": "Earbuds"}, {"value": "lx-diamond", "label": "Phone, watch and earbuds"}, {"value": "lx-gift", "label": "Gift"}, {"value": "lx-parcel", "label": "Parcel"}, {"value": "lx-ring", "label": "Charging pad"}, {"value": "lx-hoodie", "label": "Wireless charger"}, {"value": "lx-heel", "label": "Hair dryer"}, {"value": "lx-tote", "label": "Earbuds and case"}, {"value": "lx-necklace", "label": "Blender and toaster"}, {"value": "lx-perfume", "label": "Espresso machine"}, {"value": "lx-sunglasses", "label": "Hair dryer and tracker"}, {"value": "lx-coupon", "label": "Coupon"}, {"value": "lx-envelope", "label": "Envelope"}], "default": "lx-coupon" },
    { "type": "text", "id": "offer_eyebrow", "label": "Small heading (with code)", "default": "New here?" },
    { "type": "text", "id": "offer_text", "label": "Text (with code)", "default": "Join our email list and your code appears straight away." },
    { "type": "text", "id": "offer_button", "label": "Button (with code)", "default": "Get my code" },
    { "type": "text", "id": "list_eyebrow", "label": "Small heading (no code)", "default": "The list" },
    { "type": "text", "id": "list_heading", "label": "Heading (no code)", "default": "First look at new drops" },
    { "type": "text", "id": "list_text", "label": "Text (no code)", "default": "New arrivals and restocks by email. Unsubscribe any time." },
    { "type": "text", "id": "list_button", "label": "Button (no code)", "default": "Join the list" },
    { "type": "header", "content": "Bundle" },
    { "type": "text", "id": "bundle_eyebrow", "label": "Small heading", "default": "Better together" },
    { "type": "text", "id": "bundle_heading", "label": "Heading", "default": "Complete the look in one click" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "header", "content": "New arrivals list" },
    { "type": "collection", "id": "new_collection", "label": "Collection" },
    { "type": "text", "id": "new_eyebrow", "label": "Small heading", "default": "Just landed" },
    { "type": "text", "id": "new_heading", "label": "Heading", "default": "Fresh in" },
    { "type": "text", "id": "new_link", "label": "Link text", "default": "See what's new" }
  ],
  "presets": [{ "name": "Offers row" }]
}
{% endschema %}
