{%- comment -%}
  "After you order" timeline. Steps are joined by a hairline with the signal dot
  at each stop, the same dot used for stock status. Defaults restate the
  Shipping and Returns pages; change them together if the policies change.
{%- endcomment -%}
<section class="section process" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-head__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="timeline timeline--{{ section.blocks.size }}" role="list">
        {%- for block in section.blocks -%}
          <li class="tl-step" {{ block.shopify_attributes }}>
            <span class="tl-step__node" aria-hidden="true"></span>
            <p class="tl-step__when">{{ block.settings.when | escape }}</p>
            <h3 class="tl-step__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<p class="tl-step__text">{{ block.settings.text | escape }}</p>{%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="tl-step__link">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "After you order",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "How we work" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "After you order" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "What happens between checkout and your door, and what's covered after." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "when", "label": "Timing label", "default": "Day 0" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "After you order",
      "blocks": [
        { "type": "step", "settings": { "when": "Checkout", "title": "Order from live stock", "text": "Every product page shows its current stock before you buy." } },
        { "type": "step", "settings": { "when": "3-4 business days", "title": "Packed and dispatched", "text": "In-stock orders are dispatched within 3-4 business days." } },
        { "type": "step", "settings": { "when": "On dispatch", "title": "Tracking by email", "text": "Every order ships with a tracking number." } },
        { "type": "step", "settings": { "when": "After delivery", "title": "Covered", "text": "30-day change-of-mind returns on unused items, and faulty items put right." } }
      ]
    }
  ]
}
{% endschema %}
