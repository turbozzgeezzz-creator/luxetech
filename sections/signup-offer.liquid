{%- comment -%}
  Sign-up band. Shows the welcome offer only when a code is set in Theme
  settings > Welcome offer; otherwise it's a plain newsletter sign-up.
{%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign has_offer = false -%}
{%- if settings.welcome_offer != blank and settings.welcome_code != blank or settings.welcome_personal -%}{%- assign has_offer = true -%}{%- endif -%}
<section class="section signup">
  <div class="container">
    <div class="signup__band">
      <div class="signup__art">{% if has_offer %}{% render 'illustration', name: s.illustration_offer, sizes: '30vw', class: 'tile__img' %}{% else %}{% render 'illustration', name: s.illustration, sizes: '30vw', class: 'tile__img' %}{% endif %}</div>
      <div class="signup__copy">
        <span class="eyebrow">{% if has_offer %}{{ s.offer_eyebrow }}{% else %}{{ s.eyebrow }}{% endif %}</span>
        <h2 class="signup__title">{% if has_offer %}{{ 'sections.get_offer' | t: offer: settings.welcome_offer }}{% else %}{{ s.heading }}{% endif %}</h2>
        {%- if s.text != blank -%}<p>{{ s.text }}</p>{%- endif -%}
        <ul class="signup__ticks" role="list">
          {%- if has_offer -%}<li>{% render 'icon', name: 'check', class: 'icon--sm' %}{{ settings.welcome_offer }}</li>{%- endif -%}
          {%- for i in (1..3) -%}{%- assign k = 'tick_' | append: i -%}{%- if s[k] != blank -%}<li>{% render 'icon', name: 'check', class: 'icon--sm' %}{{ s[k] }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      </div>
      <div class="signup__card newsletter">
        <span class="signup__kicker">{% if has_offer %}{{ settings.welcome_offer }}{% else %}{{ s.card_title }}{% endif %}</span>
        <p>{{ s.card_text }}</p>
        {% render 'newsletter-form', id: 'SignupBand', source: 'homepage' %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sign-up offer",
  "class": "section-signup",
  "settings": [
    { "type": "select", "id": "illustration", "label": "Illustration", "options": [{"value": "none", "label": "None"}, {"value": "lx-watch", "label": "Smart watch"}, {"value": "lx-bag", "label": "Shopping bag"}, {"value": "lx-sneaker", "label": "Earbuds"}, {"value": "lx-diamond", "label": "Phone, watch and earbuds"}, {"value": "lx-gift", "label": "Gift"}, {"value": "lx-parcel", "label": "Parcel"}, {"value": "lx-ring", "label": "Charging pad"}, {"value": "lx-hoodie", "label": "Wireless charger"}, {"value": "lx-heel", "label": "Hair dryer"}, {"value": "lx-tote", "label": "Earbuds and case"}, {"value": "lx-necklace", "label": "Blender and toaster"}, {"value": "lx-perfume", "label": "Espresso machine"}, {"value": "lx-sunglasses", "label": "Hair dryer and tracker"}, {"value": "lx-coupon", "label": "Coupon"}, {"value": "lx-envelope", "label": "Envelope"}], "default": "lx-envelope" },
    { "type": "select", "id": "illustration_offer", "label": "Illustration when an offer is set", "options": [{"value": "none", "label": "None"}, {"value": "lx-watch", "label": "Smart watch"}, {"value": "lx-bag", "label": "Shopping bag"}, {"value": "lx-sneaker", "label": "Earbuds"}, {"value": "lx-diamond", "label": "Phone, watch and earbuds"}, {"value": "lx-gift", "label": "Gift"}, {"value": "lx-parcel", "label": "Parcel"}, {"value": "lx-ring", "label": "Charging pad"}, {"value": "lx-hoodie", "label": "Wireless charger"}, {"value": "lx-heel", "label": "Hair dryer"}, {"value": "lx-tote", "label": "Earbuds and case"}, {"value": "lx-necklace", "label": "Blender and toaster"}, {"value": "lx-perfume", "label": "Espresso machine"}, {"value": "lx-sunglasses", "label": "Hair dryer and tracker"}, {"value": "lx-coupon", "label": "Coupon"}, {"value": "lx-envelope", "label": "Envelope"}], "default": "lx-envelope" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The list" },
    { "type": "text", "id": "offer_eyebrow", "label": "Small heading (with offer)", "default": "Welcome offer" },
    { "type": "text", "id": "heading", "label": "Heading (no offer)", "default": "First look at new drops" },
    { "type": "text", "id": "text", "label": "Text", "default": "Join the list for new arrivals, restocks and subscriber-only deals." },
    { "type": "text", "id": "tick_1", "label": "Point 1", "default": "Early access to new arrivals" },
    { "type": "text", "id": "tick_2", "label": "Point 2", "default": "Subscriber-only deals" },
    { "type": "text", "id": "tick_3", "label": "Point 3", "default": "No spam, unsubscribe any time" },
    { "type": "text", "id": "card_title", "label": "Form title (no offer)", "default": "Join the list" },
    { "type": "text", "id": "card_text", "label": "Form text", "default": "Enter your email and tick the box to subscribe." }
  ],
  "presets": [{ "name": "Sign-up offer" }]
}
{% endschema %}
