{%- liquid
  assign per_page = section.settings.per_page
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}
<div class="container collection-page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ routes.collections_url }}">Collections</a></li>
      <li><span aria-current="page">{{ collection.title | escape }}</span></li>
    </ol>
  </nav>

  {%- liquid
    case collection.handle
      when 'audio'
        assign c_art = 'art-audio'
        assign c_tone = 'violet'
        assign c_line = 'Wireless sound, sorted. Earbuds that pair fast and go everywhere.'
      when 'charging'
        assign c_art = 'art-charging'
        assign c_tone = 'ink'
        assign c_line = 'Fast, cable-free charging for your phone, earbuds and more.'
      when 'smart-home'
        assign c_art = 'art-home'
        assign c_tone = 'violet'
        assign c_line = 'Café-style coffee, smoothies and desserts, made at home.'
      when 'accessories'
        assign c_art = 'art-accessories'
        assign c_tone = 'grape'
        assign c_line = 'Smartwatches, hair care and personal cooling for every day.'
      else
        assign c_art = 'art-hero'
        assign c_tone = 'violet'
        assign c_line = 'Hand-picked audio, charging, smart kitchen and wearable tech.'
    endcase
  -%}
  <header class="collection-banner bento-tone--{{ c_tone }}">
    <div class="collection-banner__art">
      {%- if section.settings.show_image and collection.image -%}
        {{ collection.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,1000,1600', sizes: '100vw', class: 'bento-art', alt: '' }}
      {%- else -%}
        <img src="{{ c_art | append: '.svg' | asset_url }}" alt="" class="bento-art" width="1200" height="600" loading="eager">
      {%- endif -%}
    </div>
    <div class="collection-banner__copy">
      <p class="bento-kicker">Shop</p>
      <h1 class="collection-banner__title">{{ collection.title | escape }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection-banner__desc rte">{{ collection.description }}</div>
      {%- else -%}
        <p class="collection-banner__desc">{{ c_line }}</p>
      {%- endif -%}
    </div>
  </header>

  {%- paginate collection.products by per_page -%}
    <facet-filters class="collection-layout{% if collection.filters.size == 0 %} collection-layout--no-filters{% endif %}" data-section-id="{{ section.id }}">
      {% render 'facets',
        results: collection,
        section_id: section.id,
        sort_options: collection.sort_options,
        sort_by: sort_by,
        clear_url: collection.url,
        count: collection.products_count
      %}

      <div class="collection-results" id="ProductGrid-{{ section.id }}" data-facet-swap>
        {% render 'active-filters', results: collection, section_id: section.id, clear_url: collection.url %}

        {%- if collection.products.size > 0 -%}
          <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
            {%- for product in collection.products -%}
              {%- liquid
                assign card_lazy = true
                if forloop.index <= 4
                  assign card_lazy = false
                endif
              -%}
              <li>{% render 'product-card', product: product, section_id: section.id, lazy: card_lazy, heading_tag: 'h2', sizes: '(min-width: 1200px) 280px, (min-width: 990px) 28vw, (min-width: 750px) 33vw, 50vw' %}</li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- else -%}
          <div class="empty-state">
            {%- assign filters_applied = false -%}
            {%- for filter in collection.filters -%}
              {%- if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil -%}{%- assign filters_applied = true -%}{%- endif -%}
            {%- endfor -%}
            {% render 'icon', name: 'search', class: 'empty-state__icon' %}
            {%- if filters_applied -%}
              <h2 class="empty-state__title">No products match these filters</h2>
              <p>Try removing a filter or widening the price range.</p>
              <a href="{{ collection.url }}" class="btn btn--primary" data-facet-link>Clear all filters</a>
            {%- else -%}
              <h2 class="empty-state__title">Nothing here yet</h2>
              <p>We're stocking this category now. In the meantime, browse everything we carry.</p>
              <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Shop all products</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </facet-filters>
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "options": [
      { "value": "3", "label": "3" },
      { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "checkbox", "id": "show_image", "label": "Show collection image", "default": false },
    { "type": "paragraph", "content": "Filters come from Shopify's Search & Discovery app. Add price, availability, vendor, product type and option filters (like Color) there and they appear here automatically." }
  ]
}
{% endschema %}
