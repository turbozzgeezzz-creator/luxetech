{%- liquid
  assign s = section.settings
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign count_text = 'collections.count' | t: count: collection.products_count
  capture art
    render 'coll-art', handle: collection.handle
  endcapture
  assign art = art | strip
  assign clear_url = collection.url | append: '?sort_by=' | append: sort_by
  # A collection description can hold an intro and, after a "Common questions" heading, a short Q&A.
  # The first paragraph shows under the title; the full intro and the Q&A show below the products.
  assign coll_intro = collection.description | split: '<h2>Common questions</h2>' | first
  assign coll_faq = ''
  if collection.description contains '<h2>Common questions</h2>'
    assign coll_faq = collection.description | split: '<h2>Common questions</h2>' | last
  endif
  assign coll_lead = coll_intro | split: '</p>' | first | strip_html | strip
-%}
<div data-collection data-section-id="{{ section.id }}">
  <div class="container">
    <div class="coll-hero tile tile--noir">
      <div class="tile__text">
        <nav class="breadcrumbs breadcrumbs--left" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title }}</span></nav>
        <h1 class="coll-hero__title">{{ collection.title }}</h1>
        <p class="coll-hero__meta"><span>{{ count_text }}</span>{%- capture fp -%}{% render 'from-price', collection: collection %}{%- endcapture -%}{%- if fp != blank -%}<span data-from-wrap>{{ 'sections.from_price' | t }} <strong>{{ fp }}</strong></span>{%- endif -%}<span>{% render 'icon', name: 'truck', class: 'icon--sm' %} {{ 'products.free_shipping' | t }}</span></p>
        {%- if coll_lead != blank and s.show_description -%}<div class="coll-hero__desc" data-clamp>{{ coll_lead | truncate: 240 }}</div>{%- endif -%}
      </div>
      <div class="tile__art coll-hero__art"><img src="{{ art | append: '.svg' | asset_url }}" alt="{{ collection.title | escape }}" width="600" height="600" class="tile__img" fetchpriority="high"></div>
    </div>
    {%- if s.chips_menu != blank -%}
      <nav class="coll-chips" aria-label="{{ 'collections.browse' | t }}">
        {%- for l in s.chips_menu.links -%}
          {%- if l.type == 'frontpage_link' -%}{%- continue -%}{%- endif -%}
          <a class="search-chip{% if l.url == collection.url or l.object.handle == collection.handle %} is-active{% endif %}" href="{{ l.url }}"{% if l.url == collection.url or l.object.handle == collection.handle %} aria-current="page"{% endif %}>{{ l.title | escape }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>

  {%- paginate collection.products by s.per_page -%}
  <div class="container coll{% if collection.filters.size == 0 %} coll--no-filters{% endif %}">
    {%- if collection.filters.size > 0 -%}{% render 'coll-sidebar', results: collection, form_id: 'FacetForm', count_text: count_text %}{%- endif -%}
    <div class="coll__main">
      {% render 'coll-toolbar', results: collection, count_text: count_text, sort_options: collection.sort_options, sort_by: sort_by, clear_url: clear_url %}
      <div class="collection-grid" data-collection-grid>
        {%- if collection.products.size > 0 -%}
          <div class="product-grid">
            {%- for product in collection.products -%}
              {%- liquid
                assign eager = false
                if forloop.index <= 3 and paginate.current_page == 1
                  assign eager = true
                endif
              -%}
              {% render 'product-card', product: product, eager: eager, reveal: false %}
            {%- endfor -%}
          </div>
        {%- else -%}
          <div class="empty-state">
            <p class="h3">{{ 'collections.empty' | t }}</p>
            <a class="btn btn--outline" href="{{ clear_url }}" data-facet-link>{{ 'collections.clear' | t }}</a>
          </div>
        {%- endif -%}
      </div>
      <div data-load-more>
        {%- if paginate.next -%}
          {%- liquid
            assign shown = paginate.current_page | times: paginate.page_size
            if shown > paginate.items
              assign shown = paginate.items
            endif
            assign pct = shown | times: 100 | divided_by: paginate.items
          -%}
          <div class="load-more">
            <span>{{ 'collections.shown' | t: shown: shown, total: paginate.items }}</span>
            <div class="load-more__bar" aria-hidden="true"><span style="--pct: {{ pct }}%"></span></div>
            <a class="btn btn--outline" href="{{ paginate.next.url }}" data-next>{{ 'collections.load_more' | t }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
    {%- liquid
      assign intro_text = coll_intro | strip_html | strip
      assign lead_len = coll_lead.size | plus: 20
      assign show_about = false
      if paginate.current_page == 1
        if coll_faq != ''
          assign show_about = true
        endif
        if s.show_description and intro_text.size > lead_len
          assign show_about = true
        endif
      endif
    -%}
    {%- if show_about -%}
      <section class="container coll-about" aria-labelledby="CollAbout">
        <div class="coll-about__intro">
          <h2 class="coll-about__title" id="CollAbout">About the {{ collection.title }} range</h2>
          <div class="rte">{{ coll_intro }}</div>
        </div>
        {%- if coll_faq != '' -%}
          <div class="coll-about__faq">
            <h2 class="coll-about__title">Common questions</h2>
            {%- assign faq_parts = coll_faq | split: '<p><strong>' -%}
            {%- for part in faq_parts offset: 1 -%}
              {%- assign q = part | split: '</strong>' | first | strip_html | strip -%}
              {%- assign a = part | split: '</strong>' | last | remove_first: '</p>' -%}
              <details class="coll-about__q"><summary>{{ q }}</summary><div class="rte">{{ a }}</div></details>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </section>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 48, "step": 3, "default": 24 },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "link_list", "id": "chips_menu", "label": "Quick links under the banner" }
  ]
}
{% endschema %}

