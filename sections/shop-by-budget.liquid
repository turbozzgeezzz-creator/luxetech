{%- comment -%}
  Shop by budget. Each card counts the live products in its price band and
  shows a few of them, then links to the full catalogue filtered to that band.
  Bands with no products are skipped, so nothing here can go stale.
{%- endcomment -%}
{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
-%}
<section class="section budget" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-head__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
    </div>
    <ul class="budget__grid" role="list" data-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign min_cents = block.settings.min | times: 100
          assign max_cents = block.settings.max | times: 100
          assign count = 0
          assign picks = ''
          for p in source.products limit: 50
            if p.price < min_cents
              continue
            endif
            if block.settings.max > 0 and p.price >= max_cents
              continue
            endif
            assign count = count | plus: 1
            if count <= 3
              assign picks = picks | append: p.handle | append: ','
            endif
          endfor
          assign pick_list = picks | split: ','

          assign url = source.url | append: '?filter.v.price.gte=' | append: block.settings.min
          if block.settings.max > 0
            assign upper = block.settings.max | minus: 0.01
            assign url = url | append: '&filter.v.price.lte=' | append: upper
          endif
        -%}
        {%- if count > 0 -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ url }}" class="budget-card tone tone--{{ block.settings.tone }}">
              <span class="budget-card__copy">
                <span class="tone-kicker">{{ block.settings.kicker | escape }}</span>
                <span class="budget-card__price">{{ block.settings.label | escape }}</span>
                <span class="budget-card__text">{{ block.settings.text | escape }}</span>
                <span class="budget-card__foot">
                  <span class="tone-pill">{{ section.settings.cta | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</span>
                </span>
              </span>
              <span class="budget-card__stack" aria-hidden="true">
                {%- for h in pick_list -%}
                  {%- assign pp = all_products[h] -%}
                  {%- if pp.featured_image != blank -%}
                    <span class="budget-card__thumb budget-card__thumb--{{ forloop.index }}">
                      {{ pp.featured_image | image_url: width: 260 | image_tag: loading: 'lazy', alt: '', width: 130, height: 130, sizes: '130px' }}
                    </span>
                  {%- endif -%}
                {%- endfor -%}
              </span>
            </a>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by budget",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Shop by budget" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Great tech at every price" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Pick a budget and see everything that fits it." },
    { "type": "text", "id": "cta", "label": "Card button", "default": "Shop now" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." }
  ],
  "blocks": [
    {
      "type": "band",
      "name": "Price band",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Small line", "default": "Easy gifts" },
        { "type": "text", "id": "label", "label": "Price label", "default": "Under $50" },
        { "type": "text", "id": "text", "label": "Text", "default": "Small upgrades that make a big difference." },
        { "type": "number", "id": "min", "label": "From price (dollars)", "default": 0 },
        { "type": "number", "id": "max", "label": "Up to price (dollars)", "info": "0 means no upper limit.", "default": 50 },
        {
          "type": "select", "id": "tone", "label": "Color",
          "options": [
            { "value": "violet", "label": "Violet night" },
            { "value": "grape", "label": "Bright violet" },
            { "value": "ink", "label": "Ink" },
            { "value": "light", "label": "Light" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by budget",
      "blocks": [
        { "type": "band", "settings": { "kicker": "Easy gifts", "label": "Under $50", "min": 0, "max": 50, "tone": "light" } },
        { "type": "band", "settings": { "kicker": "Everyday upgrades", "label": "$50 to $100", "min": 50, "max": 100, "tone": "grape" } },
        { "type": "band", "settings": { "kicker": "Treat yourself", "label": "$100 and up", "min": 100, "max": 0, "tone": "ink" } }
      ]
    }
  ]
}
{% endschema %}
