<section class="password-page">
  <div class="password-page__inner">
    <img class="password-page__mark" src="{{ 'logo-tech-luxedealers-purple.png' | asset_url }}" alt="{{ shop.name | escape }}" width="1008" height="200">
    <p class="wordmark" style="font-size: 30px"><span class="gold-text">LUXE</span>DEALERS</p>
    <h1 class="h2" data-split>{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
    <div class="newsletter" style="width: 100%">{% render 'newsletter-form', id: 'PasswordNewsletter', source: 'password' %}</div>
    <details style="margin-top: 24px; width: 100%">
      <summary class="link" style="cursor: pointer">{{ 'password.enter' | t }}</summary>
      {%- form 'storefront_password', class: 'newsletter__form', style: 'margin-top: 18px' -%}
        {%- if form.errors -%}<p class="form-message form-message--error">{{ form.errors.messages.form }}</p>{%- endif -%}
        <div class="newsletter__row">
          <label class="visually-hidden" for="StorePassword">{{ 'password.label' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}">
          <button type="submit">{{ 'password.submit' | t }} {% render 'icon', name: 'arrow-right' %}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
