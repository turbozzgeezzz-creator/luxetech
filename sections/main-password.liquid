<div class="password container container--narrow">
  <p class="wordmark">{{ shop.name | escape }}</p>
  <h1 class="page-title">{{ section.settings.heading | escape }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {% render 'newsletter-form', id: 'password', button_label: 'Notify me' %}
  <details class="password__login">
    <summary>Store owner? Enter password</summary>
    {%- form 'storefront_password', class: 'form-stack' -%}
      {%- if form.errors -%}<div class="form-status form-status--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="Password">Password</label>
        <input type="password" name="password" id="Password" class="input" autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn--primary">Enter store</button>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
