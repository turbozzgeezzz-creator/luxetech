<div class="container page page--blog">
  {%- if section.settings.show_title -%}<h1 class="page-title">{{ blog.title | escape }}</h1>{%- endif -%}
  {%- paginate blog.articles by 12 -%}
    {%- if blog.articles.size > 0 -%}
      {%- if blog.all_tags.size > 0 -%}
        <ul class="blog-tags" role="list">
          <li><a href="{{ blog.url }}" class="blog-tag{% if current_tags == blank %} is-active{% endif %}">All</a></li>
          {%- for tag in blog.all_tags -%}
            <li><a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog-tag{% if current_tags contains tag %} is-active{% endif %}">{{ tag | escape }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <ul class="post-grid post-grid--page" role="list" data-stagger>
        {%- for article in blog.articles -%}
          <li>{% render 'article-card-v2', article: article, lead: forloop.first %}</li>
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <p class="empty-state">No posts yet. Check back soon.</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show blog title", "default": true, "info": "Turn off when a Page banner above already shows it." }
  ]
}
{% endschema %}
