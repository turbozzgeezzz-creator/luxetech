{% render 'page-banner', title: blog.title, eyebrow: section.settings.eyebrow, text: section.settings.text, art: 'ill-guides' %}
<div class="container blog">
  {%- if blog.all_tags.size > 0 -%}
    <nav class="blog__tags" aria-label="{{ 'blog.topics' | t }}">
      <a class="search-chip{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">{{ 'blog.all' | t }}</a>
      {%- for tag in blog.all_tags limit: section.settings.tag_limit -%}<a class="search-chip{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>{%- endfor -%}
    </nav>
  {%- endif -%}
  {%- paginate blog.articles by 10 -%}
    {%- for article in blog.articles -%}
      {%- if forloop.first and paginate.current_page == 1 and current_tags == blank -%}
        {% render 'article-card', article: article, featured: true %}
        <div class="posts">
      {%- else -%}
        {%- if forloop.first -%}<div class="posts">{%- endif -%}
        {% render 'article-card', article: article %}
      {%- endif -%}
      {%- if forloop.last -%}</div>{%- endif -%}
    {%- endfor -%}
    {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The style desk" },
    { "type": "text", "id": "text", "label": "Text", "default": "Guides, care tips and style inspiration from the Tech.LuxeDealers team." },
    { "type": "range", "id": "tag_limit", "label": "Topics to show", "min": 0, "max": 20, "step": 1, "default": 8 }
  ]
}
{% endschema %}
