{%- comment -%} Filled in by theme.js from the shopper's own browsing (stored on their device). Hidden until there is something to show. {%- endcomment -%}
<section class="section section--tight" data-handle-section hidden>
  <div class="container">
    <div class="section-head">
      <div class="section-head__text"><h2 class="h3">{{ section.settings.heading }}</h2></div>
      <div class="rail__controls">
        <button type="button" class="rail__btn" data-rail-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', class: 'icon--sm' %}</button>
        <button type="button" class="rail__btn" data-rail-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button>
      </div>
    </div>
    <div class="rail" data-rail>
      <div class="rail__track" data-recently-viewed data-limit="{{ section.settings.limit }}"></div>
      <div class="rail__progress" aria-hidden="true"><span></span></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recently viewed",
  "class": "section-recent",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recently viewed" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Recently viewed" }]
}
{% endschema %}
