{%- comment -%}
  Sales-led hero: a sliding main banner, one side tile and up to four small
  tiles, each with a gold illustration or your own image. "From" prices are
  worked out live from the linked collection.
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign sides = section.blocks | where: 'type', 'side'
  assign tiles = section.blocks | where: 'type', 'tile'
  assign avg = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
  assign total = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count | plus: 0
-%}
<section class="section promo{% if section.settings.flush %} section--flush-top{% endif %}">
  <div class="container">
    <div class="promo__grid{% if sides.size == 0 %} promo__grid--wide{% endif %}">
      <div class="promo__hero" data-promo-slider>
        <div class="promo__track">
          {%- for block in slides -%}
            {%- assign b = block.settings -%}
            <div class="promo-slide tile tile--{{ b.theme }}{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
              <div class="tile__text">
                {%- if b.eyebrow != blank -%}<span class="tile__eyebrow">{{ b.eyebrow }}</span>{%- endif -%}
                <h2 class="tile__title tile__title--xl">{{ b.heading | newline_to_br }}</h2>
                {%- if b.text != blank -%}<p class="tile__copy">{{ b.text }}</p>{%- endif -%}
                {%- if b.collection != blank and b.show_from -%}{%- capture fp -%}{% render 'from-price', collection: b.collection %}{%- endcapture -%}{%- if fp != blank -%}<p class="tile__from">{{ 'sections.from_price' | t }} <strong>{{ fp }}</strong></p>{%- endif -%}{%- endif -%}
                <div class="tile__actions">
                  {%- if b.button != blank -%}<a class="btn btn--gold" href="{{ b.link | default: b.collection.url }}">{{ b.button }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>{%- endif -%}
                  {%- if b.button_2 != blank -%}<a class="btn btn--ghost-light" href="{{ b.link_2 }}">{{ b.button_2 }}</a>{%- endif -%}
                </div>
                {%- if section.settings.show_rating and total > 0 -%}
                  <p class="promo-proof">{%- render 'icon', name: 'star', class: 'icon--sm' -%}<strong>{{ avg | round: 2 }}</strong><span>{{ 'sections.hero_rating' | t: count: total }}</span><span class="promo-proof__sep" aria-hidden="true">·</span><span>{{ 'sections.hero_ship' | t }}</span></p>
                {%- endif -%}
              </div>
              <span class="promo-count" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }} <i>/</i> {{ slides.size | prepend: '0' | slice: -2, 2 }}</span>
              <div class="tile__art">{% render 'illustration', name: b.illustration, image: b.image, sizes: '(min-width: 990px) 40vw, 80vw', class: 'tile__img', eager: forloop.first %}</div>
            </div>
          {%- endfor -%}
        </div>
        {%- if slides.size > 1 -%}
          <div class="promo__nav">
            <button type="button" class="promo__arrow" data-promo-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', class: 'icon--sm' %}</button>
            <div class="promo__dots">{%- for block in slides -%}<button type="button" class="promo__dot{% if forloop.first %} is-active{% endif %}" data-promo-dot="{{ forloop.index0 }}" aria-label="{{ block.settings.eyebrow | default: block.settings.heading | escape }}"></button>{%- endfor -%}</div>
            <button type="button" class="promo__arrow" data-promo-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button>
          </div>
        {%- endif -%}
      </div>
      {%- for block in sides -%}
        {%- assign b = block.settings -%}
        <a class="promo__side tile tile--{{ b.theme }}" href="{{ b.link | default: b.collection.url | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="tile__art">{% render 'illustration', name: b.illustration, image: b.image, sizes: '(min-width: 990px) 25vw, 60vw', class: 'tile__img' %}</div>
          <div class="tile__text">
            {%- if b.eyebrow != blank -%}<span class="tile__eyebrow">{{ b.eyebrow }}</span>{%- endif -%}
            <h3 class="tile__title">{{ b.heading | newline_to_br }}</h3>
            {%- if b.text != blank -%}<p class="tile__copy">{{ b.text }}</p>{%- endif -%}
            {%- if b.collection != blank and b.show_from -%}{%- capture fp -%}{% render 'from-price', collection: b.collection %}{%- endcapture -%}{%- if fp != blank -%}<p class="tile__from">{{ 'sections.from_price' | t }} <strong>{{ fp }}</strong></p>{%- endif -%}{%- endif -%}
            {%- if b.button != blank -%}<span class="btn btn--sm btn--light">{{ b.button }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if tiles.size > 0 -%}
      <div class="promo__tiles">
        {%- for block in tiles -%}
          {%- assign b = block.settings -%}
          <a class="promo__tile tile tile--{{ b.theme }}" href="{{ b.link | default: b.collection.url | default: '#' }}"{% if b.opens_popup %} data-open-popup{% endif %} {{ block.shopify_attributes }}>
            <div class="tile__text">
              {%- if b.eyebrow != blank -%}<span class="tile__eyebrow">{{ b.eyebrow }}</span>{%- endif -%}
              <h3 class="tile__title">{{ b.heading | newline_to_br }}</h3>
              {%- if b.collection != blank and b.show_from -%}{%- capture fp -%}{% render 'from-price', collection: b.collection %}{%- endcapture -%}{%- if fp != blank -%}<p class="tile__from">{{ 'sections.from_price' | t }} <strong>{{ fp }}</strong></p>{%- endif -%}{%- endif -%}
              {%- if b.button != blank -%}<span class="btn btn--sm btn--light">{{ b.button }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</span>{%- endif -%}
            </div>
            <div class="tile__art">{% render 'illustration', name: b.illustration, image: b.image, sizes: '(min-width: 990px) 15vw, 40vw', class: 'tile__img' %}</div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Promo grid",
  "class": "section-promo",
  "settings": [
    { "type": "checkbox", "id": "flush", "label": "Less space above", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per slide", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "checkbox", "id": "show_rating", "label": "Show store rating under the buttons", "default": true, "info": "From Judge.me. Hidden when there are no reviews." }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Main slide",
      "limit": 5,
      "settings": [
        { "type": "select", "id": "illustration", "label": "Illustration", "options": [{"value": "none", "label": "None"}, {"value": "lx-watch", "label": "Smart watch"}, {"value": "lx-bag", "label": "Shopping bag"}, {"value": "lx-sneaker", "label": "Earbuds"}, {"value": "lx-diamond", "label": "Phone, watch and earbuds"}, {"value": "lx-gift", "label": "Gift"}, {"value": "lx-parcel", "label": "Parcel"}, {"value": "lx-ring", "label": "Charging pad"}, {"value": "lx-hoodie", "label": "Wireless charger"}, {"value": "lx-heel", "label": "Hair dryer"}, {"value": "lx-tote", "label": "Earbuds and case"}, {"value": "lx-necklace", "label": "Blender and toaster"}, {"value": "lx-perfume", "label": "Espresso machine"}, {"value": "lx-sunglasses", "label": "Hair dryer and tracker"}, {"value": "lx-coupon", "label": "Coupon"}, {"value": "lx-envelope", "label": "Envelope"}], "default": "lx-watch" },
        { "type": "image_picker", "id": "image", "label": "Or your own image" },
        { "type": "select", "id": "theme", "label": "Colour", "options": [{"value": "noir", "label": "Black and gold"}, {"value": "gold", "label": "Gold"}, {"value": "ivory", "label": "Ivory"}, {"value": "onyx", "label": "Deep brown"}], "default": "noir" },
        { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "New in" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Heading" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "checkbox", "id": "show_from", "label": "Show lowest price from the collection", "default": true },
        { "type": "text", "id": "button", "label": "Button", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link (overrides collection)" },
        { "type": "text", "id": "button_2", "label": "Second button" },
        { "type": "url", "id": "link_2", "label": "Second button link" }
      ]
    },
    {
      "type": "side",
      "name": "Side tile",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "illustration", "label": "Illustration", "options": [{"value": "none", "label": "None"}, {"value": "lx-watch", "label": "Smart watch"}, {"value": "lx-bag", "label": "Shopping bag"}, {"value": "lx-sneaker", "label": "Earbuds"}, {"value": "lx-diamond", "label": "Phone, watch and earbuds"}, {"value": "lx-gift", "label": "Gift"}, {"value": "lx-parcel", "label": "Parcel"}, {"value": "lx-ring", "label": "Charging pad"}, {"value": "lx-hoodie", "label": "Wireless charger"}, {"value": "lx-heel", "label": "Hair dryer"}, {"value": "lx-tote", "label": "Earbuds and case"}, {"value": "lx-necklace", "label": "Blender and toaster"}, {"value": "lx-perfume", "label": "Espresso machine"}, {"value": "lx-sunglasses", "label": "Hair dryer and tracker"}, {"value": "lx-coupon", "label": "Coupon"}, {"value": "lx-envelope", "label": "Envelope"}], "default": "lx-perfume" },
        { "type": "image_picker", "id": "image", "label": "Or your own image" },
        { "type": "select", "id": "theme", "label": "Colour", "options": [{"value": "noir", "label": "Black and gold"}, {"value": "gold", "label": "Gold"}, {"value": "ivory", "label": "Ivory"}, {"value": "onyx", "label": "Deep brown"}], "default": "gold" },
        { "type": "text", "id": "eyebrow", "label": "Small heading" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Heading" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "checkbox", "id": "show_from", "label": "Show lowest price from the collection", "default": true },
        { "type": "url", "id": "link", "label": "Link (overrides collection)" },
        { "type": "text", "id": "button", "label": "Button", "default": "Shop now" }
      ]
    },
    {
      "type": "tile",
      "name": "Small tile",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "illustration", "label": "Illustration", "options": [{"value": "none", "label": "None"}, {"value": "lx-watch", "label": "Smart watch"}, {"value": "lx-bag", "label": "Shopping bag"}, {"value": "lx-sneaker", "label": "Earbuds"}, {"value": "lx-diamond", "label": "Phone, watch and earbuds"}, {"value": "lx-gift", "label": "Gift"}, {"value": "lx-parcel", "label": "Parcel"}, {"value": "lx-ring", "label": "Charging pad"}, {"value": "lx-hoodie", "label": "Wireless charger"}, {"value": "lx-heel", "label": "Hair dryer"}, {"value": "lx-tote", "label": "Earbuds and case"}, {"value": "lx-necklace", "label": "Blender and toaster"}, {"value": "lx-perfume", "label": "Espresso machine"}, {"value": "lx-sunglasses", "label": "Hair dryer and tracker"}, {"value": "lx-coupon", "label": "Coupon"}, {"value": "lx-envelope", "label": "Envelope"}], "default": "lx-gift" },
        { "type": "image_picker", "id": "image", "label": "Or your own image" },
        { "type": "select", "id": "theme", "label": "Colour", "options": [{"value": "noir", "label": "Black and gold"}, {"value": "gold", "label": "Gold"}, {"value": "ivory", "label": "Ivory"}, {"value": "onyx", "label": "Deep brown"}], "default": "onyx" },
        { "type": "text", "id": "eyebrow", "label": "Small heading" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Heading" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "checkbox", "id": "show_from", "label": "Show lowest price from the collection", "default": false },
        { "type": "url", "id": "link", "label": "Link (overrides collection)" },
        { "type": "checkbox", "id": "opens_popup", "label": "Opens the email popup", "default": false },
        { "type": "text", "id": "button", "label": "Button", "default": "Shop now" }
      ]
    }
  ],
  "presets": [{ "name": "Promo grid", "blocks": [{ "type": "slide" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
