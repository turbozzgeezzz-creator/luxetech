{%- comment -%}
  Department showcase: one large illustrated card per category, with up to three
  real product photos from the collection floating over the artwork.
  Upload an image on a block to replace its illustration.
{%- endcomment -%}
<section class="section showcase" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-head__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="section-head__link">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--xs' %}</a>
      {%- endif -%}
    </div>
    <ul class="showcase__grid" role="list" data-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          if c == blank and block.settings.link contains '/collections/'
            assign c_handle = block.settings.link | split: '/collections/' | last | split: '?' | first | split: '/' | first
            assign c = collections[c_handle]
          endif
          assign tile_link = block.settings.link | default: c.url | default: routes.collections_url
        -%}
        <li class="showcase__item" {{ block.shopify_attributes }}>
          <a href="{{ tile_link }}" class="dept bento-tone--{{ block.settings.tone }}">
            <span class="dept__art">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 990px) 25vw, 50vw', alt: '', class: 'bento-art' }}
              {%- else -%}
                <img src="{{ block.settings.art | append: '.svg' | asset_url }}" alt="" class="bento-art" width="600" height="600" loading="lazy">
              {%- endif -%}
            </span>
            <span class="dept__copy">
              {%- if block.settings.kicker != blank -%}<span class="bento-kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
              <span class="dept__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.tagline != blank -%}<span class="dept__tagline">{{ block.settings.tagline | escape }}</span>{%- endif -%}
            </span>
            {%- if c != blank and c.products_count > 0 and section.settings.show_products -%}
              <span class="dept__shelf" aria-hidden="true">
                {%- for product in c.products limit: 3 -%}
                  {%- if product.featured_media -%}
                    <span class="dept__thumb">{{ product.featured_media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200', sizes: '64px', alt: '' }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </span>
            {%- endif -%}
            <span class="dept__cta"><span class="dept__cta-long">Shop {{ block.settings.title | escape }}</span><span class="dept__cta-short">Shop</span> {% render 'icon', name: 'arrow-right', class: 'icon--xs' %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Department showcase",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading", "default": "Departments" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by department" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All departments" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "show_products", "label": "Show product photos on cards", "default": true }
  ],
  "blocks": [
    {
      "type": "department",
      "name": "Department",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Department" },
        { "type": "text", "id": "kicker", "label": "Small line above title" },
        { "type": "text", "id": "tagline", "label": "Tagline" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the product photos. If empty, the collection in the link is used." },
        { "type": "select", "id": "tone", "label": "Color", "options": [
          { "value": "violet", "label": "Violet night" },
          { "value": "grape", "label": "Bright violet" },
          { "value": "ink", "label": "Ink" },
          { "value": "light", "label": "Light" }
        ], "default": "violet" },
        { "type": "select", "id": "art", "label": "Illustration", "options": [
          { "value": "art-audio", "label": "Earbuds" },
          { "value": "art-charging", "label": "Wireless charging" },
          { "value": "art-home", "label": "Coffee and blender" },
          { "value": "art-accessories", "label": "Smartwatch" },
          { "value": "art-dryer", "label": "Hair dryer" },
          { "value": "art-hero", "label": "Devices on stage" },
          { "value": "art-guide", "label": "Phone and charger" }
        ], "default": "art-audio" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Replaces the illustration." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Department showcase",
      "blocks": [
        { "type": "department", "settings": { "title": "Audio", "art": "art-audio", "tone": "violet" } },
        { "type": "department", "settings": { "title": "Charging", "art": "art-charging", "tone": "ink" } },
        { "type": "department", "settings": { "title": "Smart home", "art": "art-home", "tone": "violet" } },
        { "type": "department", "settings": { "title": "Accessories", "art": "art-accessories", "tone": "grape" } }
      ]
    }
  ]
}
{% endschema %}
