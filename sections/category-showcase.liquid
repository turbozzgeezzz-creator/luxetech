{%- comment -%}
  Department showcase: one large illustrated card per category, with up to three
  real product photos from the collection floating over the artwork.
  Upload an image on a block to replace its illustration.
{%- endcomment -%}
<section class="section showcase" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--muted">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="section-head__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p class="section-head__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="section-head__link">{{ section.settings.link_label | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--xs' %}</a>
      {%- endif -%}
    </div>
    <ul class="showcase__grid" role="list" data-stagger>
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          if c == blank and block.settings.link contains '/collections/'
            assign c_handle = block.settings.link | split: '/collections/' | last | split: '?' | first | split: '/' | first
            assign c = collections[c_handle]
          endif
          assign tile_link = block.settings.link | default: c.url | default: routes.collections_url
        -%}
        <li class="showcase__item" {{ block.shopify_attributes }}>
          <a href="{{ tile_link }}" class="dept tone tone--{{ block.settings.tone }}">
            <span class="dept__art art-box">{% render 'ill', name: block.settings.art, image: block.settings.image, sizes: '(min-width: 990px) 25vw, 50vw' %}</span>
            <span class="dept__panel">
              {%- if block.settings.kicker != blank -%}<span class="tone-kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
              <span class="dept__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.tagline != blank -%}<span class="dept__tagline">{{ block.settings.tagline | escape }}</span>{%- endif -%}
              {%- if c != blank and c.products_count > 0 and section.settings.show_products -%}
                <span class="dept__shelf" aria-hidden="true">
                  {%- for product in c.products limit: 3 -%}
                    {%- if product.featured_media -%}
                      <span class="dept__thumb">{{ product.featured_media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100,200', sizes: '48px', alt: '' }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                </span>
              {%- endif -%}
              <span class="dept__cta tone-pill">Shop now {% render 'icon', name: 'arrow-right', class: 'icon--xs' %}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.show_more -%}
      {%- liquid
        assign shown = ''
        for block in section.blocks
          assign b = block.settings.collection
          if b == blank and block.settings.link contains '/collections/'
            assign b_handle = block.settings.link | split: '/collections/' | last | split: '?' | first | split: '/' | first
            assign shown = shown | append: '|' | append: b_handle | append: '|'
          elsif b != blank
            assign shown = shown | append: '|' | append: b.handle | append: '|'
          endif
        endfor
        assign more_count = 0
      -%}
      {%- capture more_items -%}
        {%- for c in collections -%}
          {%- assign key = '|' | append: c.handle | append: '|' -%}
          {%- if c.handle == 'all' or c.handle == 'frontpage' or c.handle contains 'performance' or c.handle == 'new-arrivals' or c.handle == 'best-sellers' or c.products_count == 0 or shown contains key -%}{%- continue -%}{%- endif -%}
          {%- assign more_count = more_count | plus: 1 -%}
          <li><a href="{{ c.url }}" class="dept-chip">{{ c.title | escape }}</a></li>
        {%- endfor -%}
      {%- endcapture -%}
      {%- if more_count > 0 -%}
        <div class="showcase__more">
          <p class="showcase__more-label">More departments</p>
          <ul class="dept-chips" role="list">{{ more_items }}</ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

