{%- if section.blocks.size > 0 -%}
<section class="section" aria-labelledby="Heading-{{ section.id }}">
  <div class="container">
    <div class="section-head">
      <h2 class="section-head__title" id="Heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link | default: routes.collections_url }}" class="section-head__link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <ul class="cat-grid cat-grid--{{ section.settings.columns }}" role="list">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: routes.collections_url }}" class="cat-tile">
            <span class="cat-tile__icon">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '80px', alt: '', class: 'cat-tile__img' }}
              {%- else -%}
                {% render 'icon', name: block.settings.icon %}
              {%- endif -%}
            </span>
            <span class="cat-tile__text">
              <span class="cat-tile__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.subtitle != blank -%}
                <span class="cat-tile__sub">{{ block.settings.subtitle | escape }}</span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "All categories" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "columns", "label": "Tiles per row on desktop", "options": [
      { "value": "4", "label": "4" },
      { "value": "6", "label": "6" }
    ], "default": "4" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "headphones", "label": "Headphones"}, {"value": "earbuds", "label": "Earbuds"}, {"value": "speaker", "label": "Speaker"}, {"value": "plug", "label": "Charger"}, {"value": "battery", "label": "Battery"}, {"value": "cable", "label": "Cable"}, {"value": "bolt", "label": "Power"}, {"value": "home-device", "label": "Smart home"}, {"value": "camera", "label": "Camera"}, {"value": "bulb", "label": "Smart lighting"}, {"value": "watch", "label": "Watch"}, {"value": "smartphone", "label": "Smartphone"}, {"value": "tablet", "label": "Tablet"}, {"value": "laptop", "label": "Laptop"}, {"value": "monitor", "label": "Monitor"}, {"value": "tv", "label": "TV"}, {"value": "gamepad", "label": "Gamepad"}, {"value": "keyboard", "label": "Keyboard"}, {"value": "case", "label": "Phone case"}, {"value": "drone", "label": "Drone"}, {"value": "router", "label": "Networking"}, {"value": "tag", "label": "Deals tag"}, {"value": "percent", "label": "Percent"}, {"value": "gift", "label": "Gift"}, {"value": "sparkle", "label": "New arrivals"}, {"value": "box", "label": "Bundle"}, {"value": "grid", "label": "All categories"}], "default": "headphones" },
        { "type": "image_picker", "id": "image", "label": "Image (replaces icon)", "info": "Optional small cut-out product shot." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "category", "settings": { "title": "Audio", "subtitle": "Headphones and speakers", "icon": "headphones" } },
        { "type": "category", "settings": { "title": "Charging", "subtitle": "Chargers, cables, power banks", "icon": "plug" } },
        { "type": "category", "settings": { "title": "Smart home", "subtitle": "Plugs, cameras, lighting", "icon": "home-device" } },
        { "type": "category", "settings": { "title": "Accessories", "subtitle": "Cases, mounts, stands", "icon": "case" } }
      ]
    }
  ]
}
{% endschema %}
