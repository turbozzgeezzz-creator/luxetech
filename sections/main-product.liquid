{%- liquid
  assign s = section.settings
  assign current = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign thumb_limit = 40
  assign has_size = false
  for o in product.options
    assign on = o | downcase
    if on contains 'size'
      assign has_size = true
    endif
  endfor
  assign chart = 'all'
  assign ptitle = product.title | downcase
  for c in product.collections
    if c.handle contains 'shoe' or c.handle contains 'sneaker' or c.handle contains 'boot' or c.handle contains 'slide'
      assign chart = 'shoes'
    elsif c.handle == 'clothing' or c.handle contains 'hoodie' or c.handle contains 'jacket' or c.handle contains 'shirt' or c.handle contains 'denim' or c.handle contains 'jersey'
      assign chart = 'apparel'
    endif
  endfor
  if chart == 'all'
    if ptitle contains 'shoe' or ptitle contains 'sneaker' or ptitle contains 'trainer' or ptitle contains 'slide' or ptitle contains 'boot' or ptitle contains 'heel'
      assign chart = 'shoes'
    elsif ptitle contains 'hoodie' or ptitle contains 'jacket' or ptitle contains 'tee' or ptitle contains 't-shirt' or ptitle contains 'shirt' or ptitle contains 'tracksuit' or ptitle contains 'pants' or ptitle contains 'shorts' or ptitle contains 'jersey' or ptitle contains 'sweater' or ptitle contains 'coat'
      assign chart = 'apparel'
    endif
  endif
  # Only clothing and shoes get a size guide. Bags, accessories, jewellery and fragrances don't need one.
  if chart == 'all'
    assign has_size = false
  endif
  assign jd = product.metafields.judgeme.review_widget_data.value
  assign rcount = product.metafields.reviews.rating_count.value | default: 0
-%}
<section class="pdp" data-product data-product-handle="{{ product.handle }}" data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" data-update-url="true">
  <div class="container">
    <nav class="breadcrumbs breadcrumbs--left" aria-label="{{ 'general.breadcrumbs' | t }}">
      <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span>
      {%- capture crumb_handle -%}{%- render 'crumb-collection', product: product -%}{%- endcapture -%}
      {%- assign crumb_handle = crumb_handle | strip -%}{%- assign crumb = collections[crumb_handle] -%}
      {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a><span aria-hidden="true">/</span>{%- elsif crumb_handle != blank and crumb -%}<a href="{{ crumb.url }}">{{ crumb.title }}</a><span aria-hidden="true">/</span>{%- endif -%}
      <span aria-current="page">{{ product.title }}</span>
    </nav>

    <div class="pdp__grid">
      {%- comment -%} Gallery: thumbnails beside one main image {%- endcomment -%}
      <div class="gallery gallery--slider pdp__gallery" data-gallery data-zoom="{{ s.hover_zoom }}">
        {%- if media_count > 1 -%}
          <div class="gallery__thumbs" role="list">
            {%- for media in product.media limit: thumb_limit -%}
              <button type="button" class="gallery__dot gallery__thumb" role="listitem" aria-label="{{ 'products.show_image' | t: n: forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">{{ media.preview_image | image_url: width: 160 | image_tag: width: 72, height: 72, loading: 'lazy', alt: product.title }}</button>
            {%- endfor -%}
          </div>
        {%- endif -%}
        <div class="gallery__stage">
          <div class="gallery__main" tabindex="0" aria-label="{{ 'products.gallery' | t }}">
            {%- for media in product.media limit: thumb_limit -%}
              <div class="gallery__slide" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- liquid
                      assign load = 'lazy'
                      if forloop.first
                        assign load = 'eager'
                      endif
                    -%}
                    {{ media | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 46vw, 100vw', loading: load, alt: media.alt | default: product.title }}
                  {%- when 'video' -%}
                    {{ media | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, image_size: '1000x' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag: image_size: '1000x', reveal: 'interaction', toggleable: true }}
                {%- endcase -%}
              </div>
            {%- else -%}
              <div class="gallery__slide">{% render 'placeholder' %}</div>
            {%- endfor -%}
          </div>
          {%- if media_count > 1 -%}
            <button type="button" class="gallery__arrow gallery__arrow--prev" data-gallery-prev aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left', class: 'icon--sm' %}</button>
            <button type="button" class="gallery__arrow gallery__arrow--next" data-gallery-next aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button>
            <span class="gallery__count" data-gallery-count aria-hidden="true">1 / {% if media_count > thumb_limit %}{{ thumb_limit }}{% else %}{{ media_count }}{% endif %}</span>
          {%- endif -%}
        </div>
        {%- if media_count > 0 -%}
          <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="{{ 'products.zoom' | t }}">
            <button type="button" class="lightbox__close" aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
            <div class="lightbox__track">
              {%- for media in product.media limit: thumb_limit -%}
                {%- if media.media_type == 'image' -%}
                  {%- comment -%} Full-size photos load only when the zoom view is opened (keeps the page light). {%- endcomment -%}
                  <div class="lightbox__item"><img data-lb-src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | default: product.title | escape }}" width="{{ media.width }}" height="{{ media.height }}" decoding="async"></div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="pdp__info">
        <div class="pdp__box">
          <div class="pdp__top">
            {%- if product.vendor != blank -%}<span class="pdp__vendor">{{ product.vendor }}</span>{%- endif -%}
            <h1 class="pdp__title">{{ product.title }}</h1>
            {%- if rcount > 0 -%}
              {%- assign r = product.metafields.reviews.rating.value -%}
              {%- assign pct = r.rating | divided_by: r.scale_max | times: 100 -%}
              <a class="pdp__rating" href="#reviews"><span class="rating__stars rating__stars--gold" aria-hidden="true"><span style="--pct: {{ pct }}%"></span></span><strong>{{ r.rating | round: 1 }}</strong><span>{{ 'products.reviews_count' | t: count: rcount }}</span></a>
            {%- endif -%}
          </div>

          <div class="pdp__price">
            {% render 'price', product: product, variant: current, class: 'product__price' %}

            <div class="pdp__installments">{% form 'product', product %}{{ form | payment_terms }}{% endform %}</div>
            {% render 'tier-offer' %}
          </div>

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'buy' -%}
                <div class="pdp__buy" {{ block.shopify_attributes }}>
                  {%- assign sp = nil -%}{%- if has_size -%}{%- assign sp = 'chart' -%}{%- endif -%}
                  {% render 'product-form', product: product, form_id: 'ProductForm', show_dynamic: block.settings.dynamic, show_qty: block.settings.qty, size_page: sp %}
                </div>
              {%- when 'trust' -%}
                <div class="pdp__trust" {{ block.shopify_attributes }}>
                  {%- for i in (1..3) -%}
                    {%- liquid
                      assign tk = 'text_' | append: i
                      assign ik = 'icon_' | append: i
                    -%}
                    {%- if block.settings[tk] != blank -%}<div class="pdp__trust-item">{% render 'icon', name: block.settings[ik] %}<span>{{ block.settings[tk] }}</span></div>{%- endif -%}
                  {%- endfor -%}
                  <ul class="pdp__trust-pay" role="list" aria-label="{{ 'products.pay_securely' | t }}">{%- for type in shop.enabled_payment_types limit: 7 -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul>
                </div>
              {%- when 'delivery' -%}
                <div class="pdp__delivery" {{ block.shopify_attributes }}>
                  <span class="pdp__delivery-icon">{% render 'icon', name: 'truck' %}</span>
                  <div><strong>{{ block.settings.title }}</strong><p>{{ block.settings.text }}</p></div>
                </div>
              {%- when 'payments' -%}
                <div class="pdp__pay" {{ block.shopify_attributes }}>
                  <span>{% render 'icon', name: 'lock', class: 'icon--sm' %} {{ 'products.pay_securely' | t }}</span>
                  <ul class="payment-icons" role="list">{%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}</ul>
                </div>
              {%- when 'advisor' -%}
                {%- if settings.advisor_whatsapp != blank -%}
                  {%- capture msg -%}{{ 'products.advisor_message' | t: title: product.title }} {{ request.origin }}{{ product.url }}{%- endcapture -%}
                  <a class="advisor" href="https://wa.me/{{ settings.advisor_whatsapp }}?text={{ msg | url_encode }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
                    <span class="advisor__dot" aria-hidden="true"></span>
                    <span><strong style="font-weight: 600">{{ settings.advisor_label }}</strong><br><span class="muted">{{ block.settings.text }}</span></span>
                    {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}
                  </a>
                {%- elsif block.settings.page != blank -%}
                  <a class="pdp__help" href="{{ block.settings.page.url }}" {{ block.shopify_attributes }}>
                    <span class="pdp__help-icon">{% render 'icon', name: 'chat', class: 'icon--sm' %}</span>
                    <span class="pdp__help-text"><strong>{{ 'products.help_title' | t }}</strong><span>{{ block.settings.text }}</span></span>
                    <span class="pdp__help-cta">{{ 'products.help_cta' | t }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</span>
                  </a>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="rte muted" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- when 'share' -%}
                <div class="product__share" {{ block.shopify_attributes }}>
                  {% render 'icon', name: 'share', class: 'icon--sm' %} {{ 'products.share' | t }}:
                  <a class="link" style="padding: 0" href="https://www.pinterest.com/pin/create/button/?url={{ request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">Pinterest</a>
                  <a class="link" style="padding: 0" href="https://www.facebook.com/sharer/sharer.php?u={{ request.origin | append: product.url | url_encode }}" target="_blank" rel="noopener">Facebook</a>
                  <button type="button" class="link" style="padding: 0" data-copy="{{ request.origin | append: product.url }}">{{ 'products.copy_link' | t }}</button>
                </div>
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} Bought together {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'set' -%}<div class="pdp__set" {{ block.shopify_attributes }}>{% render 'complete-set', product: product, block: block %}</div>{%- endif -%}
    {%- endfor -%}

    {%- comment -%} Details: tabs and an at-a-glance card {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'accordions' -%}
        <div class="pdp__more" {{ block.shopify_attributes }}>
          <div class="pdp__tabs" data-tabs>
            <div class="pdp__tablist" role="tablist">
              <button type="button" role="tab" class="pdp__tab" id="pt-1" aria-controls="pp-1" aria-selected="true">{{ 'products.description' | t }}</button>
              <button type="button" role="tab" class="pdp__tab" id="pt-2" aria-controls="pp-2" aria-selected="false" tabindex="-1">{{ 'products.shipping_refunds' | t }}</button>
              {%- if has_size or chart != 'all' -%}<button type="button" role="tab" class="pdp__tab" id="pt-3" aria-controls="pp-3" aria-selected="false" tabindex="-1">{{ 'products.size_guide' | t }}</button>{%- endif -%}
            </div>
            <div role="tabpanel" id="pp-1" aria-labelledby="pt-1" class="pdp__panel rte">{{ product.description | default: '—' }}</div>
            <div role="tabpanel" id="pp-2" aria-labelledby="pt-2" class="pdp__panel rte" hidden>
              {{ block.settings.shipping_text }}
              <p>{%- if shop.shipping_policy.body != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}{%- if shop.refund_policy.body != blank -%} · <a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}</p>
            </div>
            {%- if has_size or chart != 'all' -%}<div role="tabpanel" id="pp-3" aria-labelledby="pt-3" class="pdp__panel" hidden>{% render 'size-chart', show: chart %}</div>{%- endif -%}
          </div>
          <aside class="glance">
            <span class="glance__kicker">{{ 'products.at_a_glance' | t }}</span>
            <dl>
              {%- if product.collections.first -%}<div><dt>{{ 'products.department' | t }}</dt><dd><a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a></dd></div>{%- endif -%}
              {%- unless product.has_only_default_variant -%}<div><dt>{{ 'products.options_count' | t }}</dt><dd>{{ product.variants.size }}</dd></div>{%- endunless -%}
              <div><dt>{{ 'products.price' | t }}</dt><dd>{% if product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ product.price_min | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</dd></div>
              <div><dt>{{ 'products.availability' | t }}</dt><dd>{% if product.available %}{{ 'products.in_stock_short' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</dd></div>
              <div><dt>{{ 'products.shipping' | t }}</dt><dd>{{ 'products.shipping_value' | t }}</dd></div>
              <div><dt>{{ 'products.guarantee' | t }}</dt><dd>{{ 'products.guarantee_value' | t }}</dd></div>
              {%- if rcount > 0 -%}<div><dt>{{ 'products.reviews' | t }}</dt><dd><a href="#reviews">{{ product.metafields.reviews.rating.value.rating | round: 1 }} / 5 · {{ 'products.reviews_count' | t: count: rcount }}</a></dd></div>{%- endif -%}
              {%- if current.sku != blank -%}<div><dt>{{ 'products.ref' | t }}</dt><dd data-sku>{{ current.sku }}</dd></div>{%- endif -%}
            </dl>
            <ul class="glance__ticks" role="list">
              <li>{% render 'icon', name: 'truck', class: 'icon--sm' %}{{ 'products.free_shipping' | t }}</li>
              <li>{% render 'icon', name: 'lock', class: 'icon--sm' %}{{ 'products.secure_checkout' | t }}</li>
              <li>{% render 'icon', name: 'return', class: 'icon--sm' %}{{ 'products.refund_reship' | t }}</li>
              <li>{% render 'icon', name: 'chat', class: 'icon--sm' %}{{ 'products.real_support' | t }}</li>
            </ul>
          </aside>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{%- if has_size or chart != 'all' -%}
  <div class="drawer drawer--sheet" id="SizeGuide" aria-hidden="true">
    <div class="drawer__overlay" data-drawer-close></div>
    <div class="drawer__panel drawer__panel--wide" role="dialog" aria-modal="true" aria-labelledby="SizeGuideTitle" tabindex="-1">
      <div class="sheet__grab" data-sheet-grab aria-hidden="true"><span></span></div>
      <div class="drawer__head"><h2 class="drawer__title" id="SizeGuideTitle">{{ 'products.size_guide' | t }}</h2><button type="button" class="bag__close" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div>
      <div class="drawer__body">{% render 'size-chart', show: chart %}</div>
      <div class="sheet__foot"><button type="button" class="btn btn--block" data-drawer-close>{{ 'products.size_done' | t }}</button></div>
    </div>
  </div>
{%- endif -%}

{%- comment -%} Sticky add to bag on scroll (all screen sizes) {%- endcomment -%}
{%- if s.sticky_bar -%}
  <div class="sticky-atc" data-sticky-atc aria-hidden="false">
    <div class="sticky-atc__inner">
      <div class="sticky-atc__info">
        <div class="sticky-atc__img">{%- if product.featured_media -%}{{ product.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}</div>
        <div class="sticky-atc__text">
          <div class="sticky-atc__title">{{ product.title }}</div>
          <div class="sticky-atc__sub">{% render 'price', product: product, variant: current %}<span class="sticky-atc__ship">{% render 'icon', name: 'truck', class: 'icon--sm' %} {{ 'products.free_shipping' | t }}</span></div>
        </div>
      </div>
      <button type="button" class="btn btn--gold sticky-atc__btn" data-add-button{% unless current.available %} disabled{% endunless %}>{% render 'icon', name: 'cart', class: 'icon--sm' %}<span data-add-label>{% if current.available %}{{ 'products.add_to_bag' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span></button>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "settings": [
    {
      "type": "select",
      "id": "gallery",
      "label": "Desktop gallery",
      "options": [
        { "value": "slider", "label": "Thumbnails and slider" }
      ],
      "default": "slider"
    },
    { "type": "checkbox", "id": "hover_zoom", "label": "Zoom on hover", "default": false },
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add to bag bar", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "delivery",
      "name": "Delivery box",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Free tracked shipping" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Most orders arrive within 2–3 weeks. You'll get a tracking number by email when it ships." }
      ]
    },
    { "type": "payments", "name": "Payment icons", "limit": 1, "settings": [] },
    {
      "type": "buy",
      "name": "Options and buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "qty", "label": "Quantity selector", "default": false },
        { "type": "checkbox", "id": "dynamic", "label": "Express checkout buttons", "default": true }
      ]
    },
    { "type": "text", "name": "Text", "settings": [{ "type": "richtext", "id": "text", "label": "Text" }] },
    {
      "type": "trust",
      "name": "Promise row",
      "limit": 1,
      "settings": [
        { "type": "select", "id": "icon_1", "label": "Icon 1", "options": [{ "value": "diamond", "label": "Diamond" }, { "value": "globe", "label": "Globe" }, { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Secure" }, { "value": "gift", "label": "Gift" }, { "value": "chat", "label": "Chat" }, { "value": "shield", "label": "Shield" }], "default": "diamond" },
        { "type": "text", "id": "text_1", "label": "Text 1", "default": "Free shipping" },
        { "type": "select", "id": "icon_2", "label": "Icon 2", "options": [{ "value": "diamond", "label": "Diamond" }, { "value": "globe", "label": "Globe" }, { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Secure" }, { "value": "gift", "label": "Gift" }, { "value": "chat", "label": "Chat" }, { "value": "shield", "label": "Shield" }], "default": "globe" },
        { "type": "text", "id": "text_2", "label": "Text 2", "default": "Refund or reship guarantee" },
        { "type": "select", "id": "icon_3", "label": "Icon 3", "options": [{ "value": "diamond", "label": "Diamond" }, { "value": "globe", "label": "Globe" }, { "value": "truck", "label": "Delivery" }, { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Secure" }, { "value": "gift", "label": "Gift" }, { "value": "chat", "label": "Chat" }, { "value": "shield", "label": "Shield" }], "default": "lock" },
        { "type": "text", "id": "text_3", "label": "Text 3", "default": "Secure checkout" }
      ]
    },
    {
      "type": "accordions",
      "name": "Details tabs",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "open_first", "label": "Open description", "default": true },
        
        { "type": "richtext", "id": "shipping_text", "label": "Delivery and returns text" },
        { "type": "richtext", "id": "care_text", "label": "Care text" }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1, "settings": [] },
    {
      "type": "advisor",
      "name": "Advisor button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Questions about this piece? Chat with us." },
        { "type": "page", "id": "page", "label": "Contact page (if no WhatsApp)" }
      ]
    },
    {
      "type": "set",
      "name": "Complete the set",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Complete the look" },
        { "type": "text", "id": "fallback", "label": "Pair with collection (handle)", "default": "accessories", "info": "Used when no products are picked and Search & Discovery has none." },
        { "type": "text", "id": "fallback_alt", "label": "Pair with, for products already in that collection", "default": "clothing" },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 3, "info": "Leave empty to use complementary products from the Search & Discovery app." }
      ]
    }
  ]
}
{% endschema %}
