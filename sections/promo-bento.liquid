{%- comment -%}
  Bento promo hero: a rotating main banner with promo tiles around it.
  Tiles 1-2 fill the left column, tiles 3-5 the row under the banner.
  Copy and artwork each get their own area, so text always sits on a solid
  background. Tick "Opens welcome-offer popup" to make a slide or tile open
  the email popup.
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign tiles = section.blocks | where: 'type', 'tile'
-%}
<section class="bento-section" aria-label="{{ section.settings.label | escape }}">
  <div class="container">
    <div class="bento">
      {%- if slides.size > 0 -%}
        <bento-carousel class="bento__main" data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
          <div class="bento__track" data-bento-track>
          {%- for block in slides -%}
            {%- assign is_offer = block.settings.open_offer -%}
            <div class="bento-slide tone tone--{{ block.settings.tone }}{% if forloop.first %} is-active{% endif %}" data-slide aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ slides.size }}" {{ block.shopify_attributes }}>
              <div class="bento-slide__copy">
                {%- if block.settings.kicker != blank -%}<p class="tone-kicker">{{ block.settings.kicker | escape }}</p>{%- endif -%}
                <h2 class="bento-slide__heading">{{ block.settings.heading | escape }}</h2>
                {%- if block.settings.text != blank -%}<p class="bento-slide__text">{{ block.settings.text | escape }}</p>{%- endif -%}
                <div class="bento-slide__actions">
                  {%- if block.settings.button_label != blank -%}
                    <a href="{% if is_offer %}#{% else %}{{ block.settings.link | default: routes.all_products_collection_url }}{% endif %}" class="btn tone-btn btn--lg"{% if is_offer %} data-open-popup{% endif %}>
                      {{- block.settings.button_label | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' -%}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a href="{{ block.settings.link_2 | default: routes.root_url }}" class="btn tone-btn-2 btn--lg">{{ block.settings.button_label_2 | escape }}</a>
                  {%- endif -%}
                </div>
              </div>
              <div class="bento-slide__art art-box">
                {%- liquid
                  assign slide_loading = 'lazy'
                  if forloop.first
                    assign slide_loading = 'eager'
                  endif
                -%}
                {% render 'ill', name: block.settings.art, image: block.settings.image, sizes: '(min-width: 990px) 40vw, 90vw', loading: slide_loading %}
              </div>
            </div>
          {%- endfor -%}
          </div>
          {%- if slides.size > 1 -%}
            <div class="bento__controls">
              <button type="button" class="bento__arrow" data-prev aria-label="Previous slide">{% render 'icon', name: 'chevron-left', class: 'icon--sm' %}</button>
              <div class="bento__dots">
                {%- for block in slides -%}
                  <button type="button" class="bento__dot" data-dot aria-label="Show slide {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"><span></span></button>
                {%- endfor -%}
              </div>
              <button type="button" class="bento__arrow" data-next aria-label="Next slide">{% render 'icon', name: 'chevron-right', class: 'icon--sm' %}</button>
            </div>
          {%- endif -%}
        </bento-carousel>
      {%- endif -%}

      {%- for block in tiles limit: 5 -%}
        {%- assign is_offer = block.settings.open_offer -%}
        <a href="{% if is_offer %}#{% else %}{{ block.settings.link | default: routes.all_products_collection_url }}{% endif %}" class="bento-tile bento-tile--{{ forloop.index }} tone tone--{{ block.settings.tone }}"{% if is_offer %} data-open-popup{% endif %} {{ block.shopify_attributes }}>
          <span class="bento-tile__copy">
            {%- if block.settings.kicker != blank -%}<span class="tone-kicker">{{ block.settings.kicker | escape }}</span>{%- endif -%}
            <span class="bento-tile__heading">{{ block.settings.heading | escape }}</span>
            {%- if block.settings.text != blank -%}<span class="bento-tile__text">{{ block.settings.text | escape }}</span>{%- endif -%}
            {%- if block.settings.button_label != blank -%}<span class="bento-tile__cta tone-pill">{{ block.settings.button_label | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--xs' %}</span>{%- endif -%}
          </span>
          <span class="bento-tile__art art-box">{% render 'ill', name: block.settings.art, image: block.settings.image, sizes: '(min-width: 990px) 15vw, 40vw' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

