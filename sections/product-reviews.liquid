{%- comment -%}
  Customer reviews. Shows nothing at all until the product has real reviews,
  so shoppers never see an empty "no reviews" block. The rating comes from the
  standard reviews.rating / reviews.rating_count metafields (Judge.me keeps
  these in sync) or Judge.me's own badge data. With reviews, Judge.me's widget
  loads inside this section, including its "Write a review" button.
{%- endcomment -%}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign has_reviews = false
  if rating != blank and rating_count > 0
    assign has_reviews = true
  endif
  assign jm_badge = product.metafields.judgeme.badge | append: ''
  if has_reviews == false and settings.judgeme_enabled and jm_badge contains 'data-number-of-reviews'
    unless jm_badge contains "data-number-of-reviews='0'" or jm_badge contains 'data-number-of-reviews="0"'
      assign has_reviews = true
    endunless
  endif
  if request.design_mode and section.settings.preview
    assign has_reviews = true
  endif
-%}
{%- if has_reviews -%}
<section class="section product-reviews" id="reviews" aria-labelledby="ReviewsHeading-{{ section.id }}">
  <div class="container">
    <div class="reviews">
      <div class="reviews__summary">
        <p class="eyebrow eyebrow--muted">Reviews</p>
        <h2 class="reviews__title" id="ReviewsHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- if rating != blank and rating_count > 0 -%}
          {%- assign avg = rating.rating | round: 1 -%}
          {%- assign pct = rating.rating | divided_by: rating.scale_max | times: 100 -%}
          <p class="reviews__score"><span class="reviews__avg">{{ avg }}</span><span class="reviews__of">/ {{ rating.scale_max }}</span></p>
          <span class="rating__stars reviews__stars" style="--rating: {{ pct }}%;" aria-hidden="true">
            <span class="rating__base">{%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span>
            <span class="rating__fill">{%- for i in (1..5) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span>
          </span>
          <p class="reviews__count">Based on {{ rating_count }} {{ rating_count | pluralize: 'review', 'reviews' }}</p>
        {%- else -%}
          <p class="reviews__empty">{{ section.settings.empty_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: pages.contact.url | default: routes.root_url }}" class="btn btn--outline">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="reviews__list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
        {%- if settings.judgeme_enabled and section.blocks.size == 0 -%}
          <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget jdgm-outside-widget" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer reviews" },
    { "type": "text", "id": "empty_text", "label": "No reviews text", "default": "No reviews yet. Bought this? We'd love to hear what you think." },
    { "type": "checkbox", "id": "preview", "label": "Preview in the editor", "info": "The section is hidden on the live store until a product has reviews. Tick to see it while editing.", "default": false },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Share your experience" },
    { "type": "url", "id": "button_link", "label": "Button link", "info": "Defaults to your contact page. Hidden while Judge.me reviews are showing." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
