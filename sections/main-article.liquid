<article class="container container--narrow page article">
  {%- liquid
  assign tags = article.tags | join: ' ' | downcase
  assign art = ''
  comment
    article.handle is 'blog-handle/article-handle'; compare on the article part.
  endcomment
  assign post_handle = article.handle | split: '/' | last
  if post_handle == 'how-to-choose-a-wireless-charger-qi2-magsafe-and-watts-explained'
    assign art = 'ill-blog-charger'
  elsif post_handle == 'wireless-earbuds-care-fit-cleaning-and-battery-tips'
    assign art = 'ill-blog-earbuds'
  elsif post_handle == 'cafe-style-espresso-at-home-a-beginners-guide'
    assign art = 'ill-blog-espresso'
  elsif post_handle == 'heat-styling-without-the-damage-hair-dryer-and-straightener-tips'
    assign art = 'ill-blog-haircare'
  elsif post_handle == 'never-lose-your-keys-again-getting-the-most-from-an-item-tracker'
    assign art = 'ill-blog-tracker'
  elsif tags contains 'audio' or tags contains 'earbud'
    assign art = 'ill-buds'
  elsif tags contains 'charg'
    assign art = 'ill-charge'
  elsif tags contains 'kitchen' or tags contains 'coffee'
    assign art = 'ill-espresso'
  elsif tags contains 'hair'
    assign art = 'ill-haircare'
  elsif tags contains 'wear' or tags contains 'watch'
    assign art = 'ill-watch'
  else
    assign art = 'ill-guides'
  endif
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200 | at_least: 1
  -%}
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      <li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li>
      <li><span aria-current="page">{{ article.title | escape }}</span></li>
    </ol>
  </nav>
  <h1 class="page-title">{{ article.title | escape }}</h1>
  <p class="article__meta">
    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
    {%- if article.author != blank %} · {{ article.author | escape }}{% endif -%}
    · {{ minutes }} min read
  </p>
  <div class="article__image{% unless article.image %} article__image--art{% endunless %}">
    {%- if article.image -%}
      {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', widths: '600,900,1200,1400', sizes: '(min-width: 990px) 820px, 100vw' }}
    {%- else -%}
      <span class="art-box tone tone--violet">{% render 'ill', name: art, loading: 'eager' %}</span>
    {%- endif -%}
  </div>
  <div class="rte">{{ article.content }}</div>
  <p class="article__back"><a href="{{ blog.url }}" class="link-btn">{% render 'icon', name: 'chevron-left', class: 'icon--xs' %} Back to {{ blog.title | escape }}</a></p>
</article>

{% schema %}
{
  "name": "Blog post",
  "settings": []
}
{% endschema %}
