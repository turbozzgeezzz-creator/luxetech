{%- liquid
  assign menu = section.settings.menu
  assign overlay = false
  if section.settings.overlay_home and request.page_type == 'index'
    assign overlay = true
  endif
  assign contact_url = section.settings.contact_page.url
  if settings.advisor_whatsapp != blank
    assign contact_url = 'https://wa.me/' | append: settings.advisor_whatsapp
  endif
-%}
<div class="header-wrapper{% if overlay %} header-wrapper--overlay{% endif %}" data-header data-hide-on-scroll="{{ section.settings.hide_on_scroll }}">
  <header class="site-header">
    <div class="container header__inner">
      <div class="header__left">
        <button type="button" class="icon-btn header__burger" data-drawer-open="MenuOverlay" aria-controls="MenuOverlay" aria-expanded="false" aria-label="{{ 'header.menu' | t }}">
          {% render 'icon', name: 'menu' %}
        </button>
        <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }}">
          {% render 'logo' %}
        </a>
      </div>

      <form action="{{ routes.search_url }}" method="get" role="search" class="header__search" data-header-search>
        <label class="visually-hidden" for="HeaderSearch">{{ 'header.search' | t }}</label>
        <input id="HeaderSearch" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'header.search_placeholder' | t }}" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="HeaderSearchPop" aria-autocomplete="list" data-search-input>
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="type" value="product">
        <button type="submit" class="header__search-btn" aria-label="{{ 'header.search' | t }}">{% render 'icon', name: 'search' %}</button>
        <div class="search-pop" id="HeaderSearchPop" data-search-pop hidden>
          <div class="search-pop__idle" data-search-idle>
            {%- assign pops = section.settings.popular_searches | split: ',' -%}
            {%- if pops.size > 0 -%}
              <p class="search-pop__label">{{ 'search.popular' | t }}</p>
              <div class="search-pop__chips">{%- for q in pops -%}{%- assign qq = q | strip -%}<a class="search-chip" href="{{ routes.search_url }}?q={{ qq | url_encode }}&options%5Bprefix%5D=last">{% render 'icon', name: 'search', class: 'icon--sm' %}{{ qq }}</a>{%- endfor -%}</div>
            {%- endif -%}
            {%- assign sc = section.settings.search_collection -%}
            {%- if sc != blank -%}
              <p class="search-pop__label">{{ 'search.trending' | t: title: sc.title }}</p>
              <ul class="search-pop__products" role="list">
                {%- for p in sc.products limit: 4 -%}
                  <li><a href="{{ p.url }}"><span class="search-pop__img">{{ p.featured_media.preview_image | image_url: width: 160 | image_tag: width: 64, height: 64, loading: 'lazy', alt: p.title }}</span><span class="search-pop__name">{{ p.title }}</span><strong>{{ p.price | money }}</strong></a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
          <div class="search-pop__results" data-search-results hidden></div>
        </div>
      </form>

      <div class="header__right">
        <button type="button" class="icon-btn header__search-icon" data-drawer-open="SearchOverlay" aria-controls="SearchOverlay" aria-expanded="false" aria-label="{{ 'header.search' | t }}">{% render 'icon', name: 'search' %}</button>
        <button type="button" class="icon-btn theme-toggle" data-theme-toggle aria-label="{{ 'header.theme_toggle' | t }}" aria-pressed="false"><svg class="theme-toggle__moon" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg><svg class="theme-toggle__sun" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg></button>
        <button type="button" class="icon-btn header__wish" data-drawer-open="WishlistDrawer" aria-controls="WishlistDrawer" aria-expanded="false" aria-label="{{ 'header.wishlist' | t }}">{% render 'icon', name: 'heart' %}<span class="cart-count" data-wish-count hidden>0</span></button>
        {%- if shop.customer_accounts_enabled -%}
          <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="header__action header__account">
            {% render 'icon', name: 'account' %}
            <span class="header__action-text"><small>{% if customer and customer.first_name != blank %}{{ 'header.hello' | t: name: customer.first_name }}{% elsif customer %}{{ 'header.signed_in' | t }}{% else %}{{ 'header.sign_in' | t }}{% endif %}</small><strong>{{ 'header.account' | t }}</strong></span>
          </a>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="header__action header__cart" {% if settings.cart_type == 'drawer' %}data-drawer-open="CartDrawer" aria-controls="CartDrawer" aria-expanded="false" role="button"{% endif %} aria-label="{{ 'header.cart' | t }}">
          <span class="header__cart-icon">{% render 'icon', name: 'cart' %}<span class="cart-count" data-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span></span>
          <span class="header__action-text"><small data-cart-total>{{ cart.total_price | money }}</small><strong>{{ 'header.cart' | t }}</strong></span>
        </a>
      </div>
    </div>

    {%- if menu != blank and section.settings.show_nav -%}
      {%- liquid
        assign hide_csv = section.settings.nav_hide | downcase | replace: ', ', ',' | replace: ' ,', ','
        assign hide_csv = ',' | append: hide_csv | append: ','
      -%}
      <nav class="header__nav" aria-label="{{ 'header.main_menu' | t }}">
        <div class="container header__nav-inner">
        <ul class="header__nav-list" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign lt = link.title | downcase | strip
              assign key = ',' | append: lt | append: ','
              assign skip = false
              if hide_csv contains key
                assign skip = true
              endif
              assign has_mega = false
              if link.links.size > 0
                assign has_mega = true
              endif
              assign icon = 'sparkle'
              if lt contains 'all'
                assign icon = 'grid4'
              elsif lt contains 'audio' or lt contains 'headphone' or lt contains 'speaker'
                assign icon = 'headphones'
              elsif lt contains 'charg' or lt contains 'power'
                assign icon = 'bolt'
              elsif lt contains 'kitchen' or lt contains 'smart home'
                assign icon = 'home-device'
              elsif lt contains 'wear' or lt contains 'watch'
                assign icon = 'watch'
              elsif lt contains 'phone' or lt contains 'computer'
                assign icon = 'smartphone'
              elsif lt contains 'entertain' or lt contains 'tv' or lt contains 'projector'
                assign icon = 'tv'
              elsif lt contains 'hair' or lt contains 'beauty'
                assign icon = 'sparkle'
              elsif lt contains 'car tech' or lt == 'car'
                assign icon = 'plug'
              elsif lt contains 'guide' or lt contains 'blog'
                assign icon = 'help'
              elsif lt contains 'new'
                assign icon = 'sparkle'
              elsif lt contains 'cloth'
                assign icon = 'shirt'
              elsif lt contains 'shoe' or lt contains 'sneaker'
                assign icon = 'shoe'
              elsif lt contains 'bag'
                assign icon = 'bag'
              elsif lt contains 'access' or lt contains 'watch'
                assign icon = 'watch'
              elsif lt contains 'jewel'
                assign icon = 'diamond'
              elsif lt contains 'brand'
                assign icon = 'tag'
              elsif lt contains 'women' or lt contains 'men'
                assign icon = 'user'
              elsif lt contains 'fragr'
                assign icon = 'perfume'
              elsif lt contains 'deal' or lt contains 'sale'
                assign icon = 'percent'
              elsif lt contains 'home'
                assign icon = 'home'
              endif
              assign highlight = false
              if section.settings.highlight_item != blank
                assign hi = section.settings.highlight_item | downcase | strip
                if lt == hi
                  assign highlight = true
                endif
              endif
            -%}
            {%- unless skip -%}
            <li class="nav-item"{% if has_mega %} data-has-mega{% endif %}>
              <a href="{{ link.url }}" class="nav-link{% if highlight %} nav-link--highlight{% endif %}"{% if link.current %} aria-current="page"{% endif %}{% if has_mega %} aria-haspopup="true" aria-expanded="false"{% endif %}>{% render 'icon', name: icon, class: 'nav-link__icon' %}{{ link.title | escape }}{% if has_mega %}{% render 'icon', name: 'chevron-down', class: 'nav-link__chev' %}{% endif %}</a>
              {%- if has_mega -%}
                <div class="mega">
                  <div class="container mega__inner">
                    <div class="mega__cols">
                      {%- assign has_grand = false -%}
                      {%- for child in link.links -%}{%- if child.links.size > 0 -%}{%- assign has_grand = true -%}{%- endif -%}{%- endfor -%}
                      {%- if has_grand -%}
                        {%- for child in link.links -%}
                          <div>
                            <a class="mega__title" href="{{ child.url }}">{{ child.title | escape }}</a>
                            <ul class="mega__links" role="list">{%- for g in child.links -%}<li><a href="{{ g.url }}">{{ g.title | escape }}</a></li>{%- endfor -%}</ul>
                          </div>
                        {%- endfor -%}
                      {%- else -%}
                        <div>
                          <a class="mega__title" href="{{ link.url }}">{{ link.title | escape }}</a>
                          <ul class="mega__links mega__links--cols" role="list">{%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>{%- endfor -%}</ul>
                        </div>
                      {%- endif -%}
                    </div>
                    {%- liquid
                      assign mc = nil
                      if link.type == 'collection_link'
                        assign mc = link.object
                      elsif link.type == 'catalog_link' or link.url == '/collections/all'
                        # Shop all: best sellers from the whole store, not the first department in the list
                        assign mc = collections['best-sellers'] | default: collections.all
                      else
                        for child in link.links
                          if child.type == 'collection_link'
                            assign mc = child.object
                            break
                          endif
                        endfor
                      endif
                    -%}
                    {%- if mc != nil and mc.products_count > 0 -%}
                      <div class="mega__shots">
                        {%- for p in mc.products limit: 3 -%}
                          {%- if p.featured_media -%}
                            <a class="mega__shot" href="{{ p.url }}">
                              <span class="mega__shot-img">{{ p.featured_media.preview_image | image_url: width: 300 | image_tag: width: 150, height: 150, loading: 'lazy', alt: p.title }}</span>
                              <span class="mega__shot-name">{{ p.title }}</span>
                              <span class="mega__shot-price">{{ p.price | money_with_currency | replace: '.00 ', ' ' | replace: ',00 ', ' ' }}</span>
                            </a>
                          {%- endif -%}
                        {%- endfor -%}
                        <a class="mega__shot-all" href="{% if link.type == 'catalog_link' or link.url == '/collections/all' %}{{ routes.all_products_collection_url }}{% else %}{{ mc.url }}{% endif %}">{% if link.type == 'catalog_link' or link.url == '/collections/all' %}Shop everything{% else %}{{ 'header.shop_all' | t: title: mc.title }}{% endif %} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            </li>
            {%- endunless -%}
          {%- endfor -%}
          {%- if section.settings.help_menu != blank -%}
            <li class="nav-item nav-item--help" data-has-mega>
              <a href="{{ section.settings.help_menu.links.first.url | default: '#' }}" class="nav-link" aria-haspopup="true" aria-expanded="false">{% render 'icon', name: 'help', class: 'nav-link__icon' %}{{ section.settings.help_label }}{% render 'icon', name: 'chevron-down', class: 'nav-link__chev' %}</a>
              <div class="dropdown"><ul role="list">{%- for l in section.settings.help_menu.links -%}<li><a href="{{ l.url }}">{{ l.title | escape }}</a></li>{%- endfor -%}</ul></div>
            </li>
          {%- endif -%}
        </ul>
        {%- if section.settings.pill_label != blank -%}
          <a class="header__pill" href="{{ section.settings.pill_link | default: routes.all_products_collection_url }}">{% render 'icon', name: 'sparkle', class: 'icon--sm' %}{{ section.settings.pill_label }}</a>
        {%- endif -%}
        </div>
      </nav>
    {%- endif -%}
    <span class="scroll-progress" aria-hidden="true"></span>
  </header>
</div>
{%- unless overlay -%}<div class="header-spacer"></div>{%- endunless -%}

{%- comment -%} Full-screen menu {%- endcomment -%}
<div class="menu-overlay mnav" id="MenuOverlay" aria-hidden="true" data-menu-overlay>
  <div class="mnav__backdrop" data-drawer-close></div>
  <div class="menu-overlay__panel mnav__panel" role="dialog" aria-modal="true" aria-label="{{ 'header.menu' | t }}" tabindex="-1">
    <div class="mnav__top">
      <a href="{{ routes.root_url }}" class="mnav__logo" aria-label="{{ shop.name | escape }}">{% render 'logo' %}</a>
      <div class="mnav__top-btns">
        <button type="button" class="mnav__close theme-toggle" data-theme-toggle aria-label="{{ 'header.theme_toggle' | t }}" aria-pressed="false"><svg class="theme-toggle__moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg><svg class="theme-toggle__sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg></button>
      <button type="button" class="mnav__close" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>
    </div>
    <div class="mnav__body">
      <form action="{{ routes.search_url }}" method="get" role="search" class="mnav__search">
        <label class="visually-hidden" for="MenuSearch">{{ 'header.search' | t }}</label>
        <input id="MenuSearch" type="search" name="q" placeholder="{{ 'header.search_placeholder' | t }}" autocomplete="off" enterkeyhint="search">
        <input type="hidden" name="type" value="product">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="mnav__search-btn" aria-label="{{ 'header.search' | t }}">{% render 'icon', name: 'search', class: 'icon--sm' %}</button>
      </form>
      {%- if menu != blank -%}
        <p class="mnav__label">{{ 'header.shop' | t }}</p>
        <ul class="mnav__list" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign lt = link.title | downcase | strip
              assign is_page = false
              if link.type == 'page_link' or link.type == 'frontpage_link' or link.type == 'blog_link' or link.type == 'http_link' or link.type == 'policy_link'
                assign is_page = true
              endif
              if link.links.size > 0
                assign is_page = false
              endif
              assign icon = 'sparkle'
              if lt contains 'all'
                assign icon = 'grid4'
              elsif lt contains 'audio' or lt contains 'headphone' or lt contains 'speaker'
                assign icon = 'headphones'
              elsif lt contains 'charg' or lt contains 'power'
                assign icon = 'bolt'
              elsif lt contains 'kitchen' or lt contains 'smart home'
                assign icon = 'home-device'
              elsif lt contains 'wear' or lt contains 'watch'
                assign icon = 'watch'
              elsif lt contains 'phone' or lt contains 'computer'
                assign icon = 'smartphone'
              elsif lt contains 'entertain' or lt contains 'tv' or lt contains 'projector'
                assign icon = 'tv'
              elsif lt contains 'hair' or lt contains 'beauty'
                assign icon = 'sparkle'
              elsif lt contains 'car tech' or lt == 'car'
                assign icon = 'plug'
              elsif lt contains 'guide' or lt contains 'blog'
                assign icon = 'help'
              elsif lt contains 'new'
                assign icon = 'sparkle'
              elsif lt contains 'cloth'
                assign icon = 'shirt'
              elsif lt contains 'shoe' or lt contains 'sneaker'
                assign icon = 'shoe'
              elsif lt contains 'bag'
                assign icon = 'bag'
              elsif lt contains 'access' or lt contains 'watch'
                assign icon = 'watch'
              elsif lt contains 'jewel'
                assign icon = 'diamond'
              elsif lt contains 'brand'
                assign icon = 'tag'
              elsif lt contains 'women' or lt contains 'men'
                assign icon = 'user'
              elsif lt contains 'fragr'
                assign icon = 'perfume'
              elsif lt contains 'deal' or lt contains 'sale'
                assign icon = 'percent'
              endif
            -%}
            {%- unless is_page -%}
              <li style="--i: {{ forloop.index0 }}">
                {%- if link.links.size > 0 -%}
                  <details class="mnav__group" name="mnav">
                    <summary class="mnav__row"><span class="mnav__ico">{% render 'icon', name: icon %}</span><span class="mnav__txt">{{ link.title | escape }}</span>{% render 'icon', name: 'chevron-down', class: 'mnav__chev' %}</summary>
                    <div class="mnav__sub">
                      <a class="mnav__all" href="{{ link.url }}">{{ 'header.shop_all' | t: title: link.title }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>
                      <div class="mnav__chips">
                        {%- for child in link.links -%}
                          {%- assign ct = child.title | downcase -%}
                          {%- unless ct contains 'shop all' or child.url == link.url -%}
                            <a class="mnav__chip" href="{{ child.url }}">{{ child.title | escape }}</a>
                          {%- endunless -%}
                          {%- for g in child.links -%}{%- assign gt = g.title | downcase -%}{%- unless gt contains 'shop all' -%}<a class="mnav__chip mnav__chip--sub" href="{{ g.url }}">{{ g.title | escape }}</a>{%- endunless -%}{%- endfor -%}
                        {%- endfor -%}
                      </div>
                    </div>
                  </details>
                {%- else -%}
                  <a class="mnav__row" href="{{ link.url }}"><span class="mnav__ico">{% render 'icon', name: icon %}</span><span class="mnav__txt">{{ link.title | escape }}</span>{% render 'icon', name: 'arrow-right', class: 'mnav__chev icon--sm' %}</a>
                {%- endif -%}
              </li>
            {%- endunless -%}
          {%- endfor -%}
        </ul>
        <p class="mnav__label">{{ 'header.departments' | t }}</p>
        <div class="mnav__depts">
          {%- for link in menu.links -%}
            {%- if link.type == 'collection_link' and link.links.size > 0 -%}
              {%- assign dimg = link.object.featured_image | default: link.object.products.first.featured_media.preview_image -%}
              <a class="mnav__dept" href="{{ link.url }}">
                <span class="mnav__dept-img">{%- if dimg -%}{{ dimg | image_url: width: 260 | image_tag: width: 130, height: 130, loading: 'lazy', alt: link.title }}{%- endif -%}</span>
                <span class="mnav__dept-name">{{ link.title | escape }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="mnav__promo">
          <span class="mnav__promo-ico">{% render 'icon', name: 'truck' %}</span>
          <div><strong>{{ 'products.free_shipping' | t }}</strong><span>{{ 'products.refund_reship' | t }}</span></div>
        </div>
        <p class="mnav__label">{{ 'header.help' | t }}</p>
        <div class="mnav__quick">
          {%- for link in menu.links -%}
            {%- liquid
              assign lt = link.title | downcase | strip
              assign is_page = false
              if link.type == 'page_link' or link.type == 'blog_link' or link.type == 'http_link' or link.type == 'policy_link'
                assign is_page = true
              endif
              if link.links.size > 0 or link.type == 'frontpage_link'
                assign is_page = false
              endif
              assign qi = 'chat'
              if lt contains 'track'
                assign qi = 'truck'
              elsif lt contains 'faq' or lt contains 'help'
                assign qi = 'help'
              elsif lt contains 'review'
                assign qi = 'star'
              elsif lt contains 'why' or lt contains 'about'
                assign qi = 'diamond'
              elsif lt contains 'size'
                assign qi = 'ruler'
              elsif lt contains 'news' or lt contains 'blog' or lt contains 'journal'
                assign qi = 'sparkle'
              endif
            -%}
            {%- if is_page -%}<a class="mnav__tile" href="{{ link.url }}">{% render 'icon', name: qi %}<span>{{ link.title | escape }}</span></a>{%- endif -%}
          {%- endfor -%}
          {%- if contact_url != blank -%}<a class="mnav__tile" href="{{ contact_url }}">{% render 'icon', name: 'chat' %}<span>{{ section.settings.contact_label }}</span></a>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="mnav__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a class="mnav__acct" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">{% render 'icon', name: 'account', class: 'icon--sm' %} {% if customer %}{{ 'header.account' | t }}{% else %}{{ 'header.login' | t }}{% endif %}</a>
      {%- endif -%}
      <button type="button" class="mnav__acct" data-drawer-open="WishlistDrawer" aria-controls="WishlistDrawer">{% render 'icon', name: 'heart', class: 'icon--sm' %} {{ 'header.wishlist' | t }}</button>
      <div class="mnav__loc">{% render 'localization', id: 'MenuLocalization' %}</div>
      {% render 'social-links' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Second-level items become column titles, third level the links." },
    { "type": "checkbox", "id": "show_nav", "label": "Show menu row under the logo", "default": true, "info": "On phones the menu is always in the Menu button." },
    { "type": "text", "id": "highlight_item", "label": "Gold menu item", "info": "Exact title of a menu item to show in gold, e.g. New in." },
    { "type": "text", "id": "nav_hide", "label": "Leave out of the menu row", "info": "Comma-separated titles, e.g. Home, FAQs. They stay in the phone menu." },
    { "type": "link_list", "id": "help_menu", "label": "Help dropdown menu" },
    { "type": "text", "id": "popular_searches", "label": "Popular searches", "default": "Handbags, Sneakers, Hoodies, Fragrances, Watches, Jewellery", "info": "Comma-separated. Shown when someone clicks the search bar." },
    { "type": "collection", "id": "search_collection", "label": "Products shown before typing" },
    { "type": "text", "id": "help_label", "label": "Help dropdown name", "default": "Help" },
    { "type": "text", "id": "pill_label", "label": "Gold button text", "default": "New in" },
    { "type": "url", "id": "pill_link", "label": "Gold button link" },
    { "type": "checkbox", "id": "overlay_home", "label": "Transparent over homepage hero", "default": false },
    { "type": "checkbox", "id": "hide_on_scroll", "label": "Hide when scrolling down", "default": false },
    { "type": "checkbox", "id": "show_localization", "label": "Show country selector", "default": true, "info": "Countries come from Settings > Markets." },
    { "type": "text", "id": "contact_label", "label": "Contact link text", "default": "Help" },
    { "type": "page", "id": "contact_page", "label": "Contact page", "info": "Used when no advisor WhatsApp number is set in Theme settings > Client services." },
    { "type": "page", "id": "wishlist_page", "label": "Wishlist page", "info": "Create a page with the wishlist template, then pick it to show the heart icon." }
  ],
  "blocks": [
    {
      "type": "mega",
