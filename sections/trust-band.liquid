{%- if section.blocks.size > 0 -%}
<section class="section section--tight" aria-label="{{ section.settings.label | escape }}">
  <div class="container">
    <ul class="trust-row" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-item" {{ block.shopify_attributes }}>
          <span class="trust-item__icon">{% render 'icon', name: block.settings.icon %}</span>
          <span class="trust-item__text">
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="trust-item__title">{{ block.settings.title | escape }}</a>
            {%- else -%}
              <span class="trust-item__title">{{ block.settings.title | escape }}</span>
            {%- endif -%}
            {%- if block.settings.text != blank -%}<span class="trust-item__sub">{{ block.settings.text | escape }}</span>{%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Trust row",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible name", "default": "Why shop with us" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "truck", "label": "Truck"}, {"value": "shield", "label": "Shield"}, {"value": "repeat", "label": "Repeat"}, {"value": "chat", "label": "Chat"}, {"value": "headset", "label": "Headset"}, {"value": "lock", "label": "Lock"}, {"value": "box", "label": "Box"}, {"value": "gift", "label": "Gift"}, {"value": "clock", "label": "Clock"}, {"value": "percent", "label": "Percent"}, {"value": "bolt", "label": "Bolt"}, {"value": "check-circle", "label": "Check circle"}], "default": "truck" },
        { "type": "text", "id": "title", "label": "Title", "default": "Fast shipping" },
        { "type": "text", "id": "text", "label": "Text", "default": "Tracked delivery on every order." },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional, e.g. your shipping or returns policy." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust row",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "title": "Fast shipping", "text": "Tracked delivery on every order." } },
        { "type": "item", "settings": { "icon": "repeat", "title": "30-day returns", "text": "Unused items, no questions." } },
        { "type": "item", "settings": { "icon": "shield", "title": "Faulty items put right", "text": "Repair, replacement or refund." } },
        { "type": "item", "settings": { "icon": "headset", "title": "Real support", "text": "Talk to people who know the gear." } }
      ]
    }
  ]
}
{% endschema %}
