{%- assign s = section.settings -%}
<section class="section{% if s.subtle %} section--subtle{% endif %}{% if s.split %} faq-split{% endif %}">
  <div class="container{% unless s.split %} container--narrow{% endunless %}">
    {%- if s.split -%}
      <div class="faq-split__grid">
      <div class="faq-split__intro">
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="faq-split__lead">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.text != blank -%}<div class="rte muted">{{ s.text }}</div>{%- endif -%}
        {%- if s.button != blank and s.button_link != blank -%}<a class="btn btn--sm" href="{{ s.button_link }}">{{ s.button }}</a>{%- endif -%}
      </div>
    {%- elsif s.heading != blank -%}
      <div class="section-head section-head--center"><div class="section-head__text">
        {%- if s.eyebrow != blank -%}<span class="eyebrow" data-reveal>{{ s.eyebrow }}</span>{%- endif -%}
        <h2 class="h2" data-split>{{ s.heading }}</h2>
      </div></div>
    {%- endif -%}
    <div class="accordion accordion--large" data-stagger>
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }} {% render 'icon', name: 'plus', class: 'icon-plus' %}</summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    {%- if s.split and s.more_link != blank -%}<a class="link faq-split__more" href="{{ s.more_link }}">{{ 'general.learn_more' | t }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>{%- endif -%}
    </div>
    {%- if s.split -%}</div>{%- endif -%}
  </div>
</section>
{%- if section.blocks.size > 0 and s.schema -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions, answered" },
    { "type": "checkbox", "id": "split", "label": "Side-by-side layout", "default": false },
    { "type": "text", "id": "subheading", "label": "Lead line (side-by-side)" },
    { "type": "richtext", "id": "text", "label": "Text (side-by-side)" },
    { "type": "text", "id": "button", "label": "Button (side-by-side)" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "url", "id": "more_link", "label": "Read all link" },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ data for search engines", "default": true },
    { "type": "checkbox", "id": "subtle", "label": "Soft background", "default": false }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Add your answer here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }] }]
}
{% endschema %}
