{%- assign s = section.settings -%}
<section class="section steps{% if s.dark %} steps--dark{% endif %}">
  <div class="container">
    <div class="section-head">
      <div>
        {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="muted steps__text">{{ s.text }}</p>{%- endif -%}
      </div>
    </div>
    <ol class="steps__list" role="list" data-stagger>
      {%- for block in section.blocks -%}
        <li class="steps__item" {{ block.shopify_attributes }}>
          <span class="steps__ico">{% render 'icon', name: block.settings.icon %}<span class="steps__n">{{ forloop.index }}</span></span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Steps",
  "class": "section-steps",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "sparkle", "options": [
        { "value": "sparkle", "label": "Sparkle" }, { "value": "diamond", "label": "Diamond" }, { "value": "truck", "label": "Truck" },
        { "value": "return", "label": "Refund" }, { "value": "check", "label": "Check" }, { "value": "box", "label": "Box" },
        { "value": "ruler", "label": "Ruler" }, { "value": "chat", "label": "Chat" }, { "value": "heart", "label": "Heart" } ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text" } ] }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "Steps", "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }, { "type": "step" }] }]
}
{% endschema %}
