{%- liquid
  assign s = section.settings
  assign art = s.art
  if art == 'auto'
    assign h = page.handle | default: request.path
    assign art = 'ill-about'
    if h contains 'contact'
      assign art = 'ill-contact'
    elsif h contains 'faq'
      assign art = 'ill-faq'
    elsif h contains 'track'
      assign art = 'ill-track'
    elsif h contains 'review'
      assign art = 'ill-offer'
    elsif h contains 'ship' or h contains 'deliver'
      assign art = 'ill-delivery'
    elsif h contains 'return' or h contains 'refund' or h contains 'warrant'
      assign art = 'ill-returns'
    elsif h contains 'privacy' or h contains 'cookie' or h contains 'data'
      assign art = 'ill-privacy'
    elsif h contains 'terms'
      assign art = 'ill-terms'
    elsif h contains 'wish'
      assign art = 'ill-wishlist'
    elsif h contains 'why'
      assign art = 'ill-devices'
    endif
  endif
  assign title = s.heading | default: page.title | newline_to_br
-%}
{% render 'page-banner', title: title, eyebrow: s.eyebrow, text: s.text, art: art, meta: s.show_meta %}

{% schema %}
{
  "name": "Page header",
  "class": "section-page-hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "textarea", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "select", "id": "art", "label": "Illustration", "default": "auto", "options": [
      { "value": "auto", "label": "Automatic" }, { "value": "diamond", "label": "Diamond" }, { "value": "envelope", "label": "Envelope" },
      { "value": "gift", "label": "Gift" }, { "value": "parcel", "label": "Parcel" }, { "value": "ring", "label": "Ring" }, { "value": "watch", "label": "Watch" },
      { "value": "heel", "label": "Heel" }, { "value": "bag", "label": "Bag" }, { "value": "sneaker", "label": "Sneaker" }, { "value": "coupon", "label": "Coupon" } ] },
    { "type": "checkbox", "id": "show_meta", "label": "Show rating and promises", "default": false }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
