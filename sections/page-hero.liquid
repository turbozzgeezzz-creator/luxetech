{%- comment -%}
  Large illustrated banner for content pages (About, Contact, FAQ, policies).
  Uses the page title as the heading when no heading is set.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank and page
    assign heading = page.title
  endif
-%}
<section class="page-hero-section">
  <div class="container">
    <div class="page-hero tone tone--{{ section.settings.tone }}">
      <div class="page-hero__copy">
        {%- if section.settings.kicker != blank -%}<p class="tone-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h1 class="page-hero__heading">{{ heading | escape }}</h1>
        {%- if section.settings.text != blank -%}<div class="page-hero__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="page-hero__actions">
            {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn tone-btn btn--lg">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>{%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}<a href="{{ section.settings.button_link_2 | default: routes.root_url }}" class="btn tone-btn-2 btn--lg">{{ section.settings.button_label_2 | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="page-hero__art art-box">{% render 'ill', name: section.settings.art, image: section.settings.image, sizes: '(min-width: 750px) 40vw, 80vw', loading: 'eager' %}</div>
    </div>
  </div>
</section>

