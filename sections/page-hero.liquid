{%- comment -%}
  Large illustrated banner for content pages (About, Contact, FAQ, policies).
  Uses the page title as the heading when no heading is set.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank and page
    assign heading = page.title
  endif
-%}
<section class="page-hero-section">
  <div class="container">
    <div class="page-hero bento-tone--{{ section.settings.tone }}">
      <div class="page-hero__art">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '700,1100,1500,1800', sizes: '100vw', alt: '', class: 'bento-art' }}
        {%- else -%}
          <img src="{{ section.settings.art | append: '.svg' | asset_url }}" alt="" class="bento-art" width="1200" height="600" loading="eager">
        {%- endif -%}
      </div>
      <div class="page-hero__copy">
        {%- if section.settings.kicker != blank -%}<p class="bento-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
        <h1 class="page-hero__heading">{{ heading | escape }}</h1>
        {%- if section.settings.text != blank -%}<div class="page-hero__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
          <div class="page-hero__actions">
            {%- if section.settings.button_label != blank -%}<a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--white btn--lg">{{ section.settings.button_label | escape }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</a>{%- endif -%}
            {%- if section.settings.button_label_2 != blank -%}<a href="{{ section.settings.button_link_2 | default: routes.root_url }}" class="btn btn--outline-light btn--lg">{{ section.settings.button_label_2 | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page banner",
  "settings": [
    { "type": "select", "id": "tone", "label": "Color", "options": [
      { "value": "violet", "label": "Violet night" },
      { "value": "grape", "label": "Bright violet" },
      { "value": "ink", "label": "Ink" }
    ], "default": "violet" },
    { "type": "select", "id": "art", "label": "Illustration", "options": [
      { "value": "art-hero", "label": "Devices on stage" },
      { "value": "art-audio", "label": "Earbuds" },
      { "value": "art-charging", "label": "Wireless charging" },
      { "value": "art-home", "label": "Coffee and blender" },
      { "value": "art-accessories", "label": "Smartwatch" },
      { "value": "art-deals", "label": "Price tag" },
      { "value": "art-bundle", "label": "Boxes" },
      { "value": "art-guide", "label": "Phone and charger" }
    ], "default": "art-hero" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Replaces the illustration." },
    { "type": "text", "id": "kicker", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title." },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_label_2", "label": "Second button" },
    { "type": "url", "id": "button_link_2", "label": "Second button link" }
  ],
  "presets": [{ "name": "Page banner" }]
}
{% endschema %}
