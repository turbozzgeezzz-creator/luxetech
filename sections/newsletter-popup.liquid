{%- liquid
  assign hide = false
  if request.page_type == 'password' or template.name == 'customers/login' or template.name == 'customers/register' or request.page_type == 'cart'
    assign hide = true
  endif
-%}
{%- unless hide -%}
<div class="popup" id="NewsletterPopup" aria-hidden="true"
  data-delay="{{ section.settings.delay }}"
  data-auto="{{ section.settings.enabled }}"
  data-trigger="{{ section.settings.trigger }}"
  data-repeat-days="{{ section.settings.repeat_days }}"
  data-hide-for-marketing="{% if customer and customer.accepts_marketing %}true{% else %}false{% endif %}">
  <div class="popup__overlay" data-drawer-close></div>
  <div class="popup__card popup__card--lux" role="dialog" aria-modal="true" aria-labelledby="PopupTitle" tabindex="-1">
    <button type="button" class="icon-btn popup__close" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    <div class="popup__side tile--noir">
      <img src="{{ section.settings.art | default: 'gift' | prepend: 'lx-' | append: '.svg' | asset_url }}" alt="Gift for subscribers" width="300" height="300" loading="lazy">
      <ul class="popup__perks" role="list">
        <li>{% render 'icon', name: 'sparkle', class: 'icon--sm' %} {{ 'newsletter.perk_1' | t }}</li>
        <li>{% render 'icon', name: 'tag', class: 'icon--sm' %} {{ 'newsletter.perk_2' | t }}</li>
        <li>{% render 'icon', name: 'heart', class: 'icon--sm' %} {{ 'newsletter.perk_3' | t }}</li>
      </ul>
    </div>
    <div class="popup__body newsletter" data-popup-body>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h2" id="PopupTitle">{%- if section.settings.show_offer and section.settings.offer != blank -%}{{ section.settings.offer }}{%- else -%}{{ section.settings.heading }}{%- endif -%}</h2>
      {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
      {% render 'newsletter-form', id: 'NewsletterPopupForm', source: 'popup', code_box: false %}
      <div class="popup__code" data-popup-code hidden>
        <p class="popup__code-title">{% render 'icon', name: 'check', class: 'icon--sm' %} {{ 'newsletter.code_ready' | t }}</p>
        <button type="button" class="popup__code-box" data-copy="" aria-label="{{ 'newsletter.copy' | t }}"><strong data-popup-code-value></strong> {% render 'icon', name: 'tag', class: 'icon--sm' %}</button>
        <p class="muted popup__code-note" data-popup-code-note></p>
        <button type="button" class="btn btn--gold btn--block" data-drawer-close>{{ 'newsletter.keep_shopping' | t }} {% render 'icon', name: 'arrow-right', class: 'icon--sm' %}</button>
      </div>
      <button type="button" class="link popup__skip" data-drawer-close>{{ 'newsletter.no_thanks' | t }}</button>
    </div>
  </div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Email popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Open by itself", "default": true, "info": "Stays hidden while another email popup app (SendWILL) is active, so visitors never see two." },
    {
      "type": "select",
      "id": "trigger",
      "label": "When it opens",
      "options": [
        { "value": "delay", "label": "After a delay" },
        { "value": "exit", "label": "On exit intent" }
      ],
      "default": "delay",
      "info": "Exit intent works on desktop. Phones use the delay."
    },
    { "type": "range", "id": "delay", "label": "Delay", "min": 3, "max": 40, "step": 1, "unit": "s", "default": 12 },
    { "type": "range", "id": "repeat_days", "label": "Show again after closing", "min": 0, "max": 60, "step": 1, "unit": "d", "default": 0, "info": "0 means never again." },
    { "type": "select", "id": "art", "label": "Illustration", "default": "gift", "options": [ { "value": "gift", "label": "Gift" }, { "value": "envelope", "label": "Envelope" }, { "value": "diamond", "label": "Diamond" }, { "value": "bag", "label": "Bag" } ] },
    { "type": "checkbox", "id": "show_offer", "label": "Show the welcome offer", "default": false, "info": "Turn on once LuxeMail sends welcome codes." },
    { "type": "text", "id": "offer", "label": "Offer heading", "default": "10% off your first order" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The private list" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "First to know, first to own" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Join the list for new arrivals, restocks and subscriber-only offers. Unsubscribe any time.</p>" }
  ]
}
{% endschema %}
