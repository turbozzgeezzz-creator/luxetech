{%- comment -%}
  Email capture popup. Shown once per visitor after a delay; never on
  customer account pages or for logged-in subscribers. Uses the same Shopify
  customer form as the footer newsletter, tagged "newsletter, popup".
{%- endcomment -%}
{%- liquid
  assign suppress = false
  if section.settings.enabled == false
    assign suppress = true
  endif
  if template.directory == 'customers' or template.name == 'password' or template.name == 'gift_card'
    assign suppress = true
  endif
  if request.design_mode and section.settings.preview == false
    assign suppress = true
  endif
  if customer and customer.accepts_marketing
    assign suppress = true
  endif
  assign code = section.settings.discount_code | default: settings.welcome_code | strip
  assign has_code = false
  if code != blank
    assign has_code = true
  endif
-%}
{%- unless suppress -%}
<newsletter-popup
  data-delay="{{ section.settings.delay | times: 1000 }}"
  data-trigger="{{ section.settings.trigger }}"
  data-repeat-days="{{ section.settings.repeat_days }}"
  data-preview="{{ request.design_mode }}"
>
  <dialog class="modal popup" id="NewsletterPopup" aria-labelledby="NewsletterPopupTitle">
    <button type="button" class="modal__close" data-popup-close aria-label="Close">{% render 'icon', name: 'close' %}</button>
    <div class="popup__grid{% if section.settings.image != blank %} popup__grid--image{% endif %}">
      {%- if section.settings.image != blank -%}
        <div class="popup__media">
          {{ section.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '300px', alt: '', class: 'popup__img' }}
        </div>
      {%- endif -%}
      <div class="popup__body">
        {%- if has_code -%}
          <p class="slide__kicker">{{ section.settings.offer_kicker | escape }}</p>
          <h2 class="popup__title" id="NewsletterPopupTitle">{{ section.settings.offer_heading | escape }}</h2>
          {%- if section.settings.offer_text != blank -%}<div class="popup__text">{{ section.settings.offer_text }}</div>{%- endif -%}
        {%- else -%}
          <h2 class="popup__title" id="NewsletterPopupTitle">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}<div class="popup__text">{{ section.settings.text }}</div>{%- endif -%}
        {%- endif -%}
        <div data-popup-form>
          {% render 'newsletter-form', id: 'popup', button_label: section.settings.button_label, tags: 'newsletter,popup', discount_code: code %}
        </div>
        <button type="button" class="link-btn popup__decline" data-popup-close>{{ section.settings.decline_label | escape }}</button>
        <p class="popup__fine">{{ section.settings.fine_print | escape }}</p>
      </div>
    </div>
  </dialog>
</newsletter-popup>
{%- endunless -%}

{% schema %}
{
  "name": "Email popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show email popup", "default": true },
    { "type": "select", "id": "trigger", "label": "Open the popup", "options": [
      { "value": "delay", "label": "After a delay" },
      { "value": "exit", "label": "On exit intent" }
    ], "default": "delay", "info": "Exit intent opens the popup when a desktop visitor moves to leave the page. Phones always use the delay." },
    { "type": "range", "id": "delay", "label": "Show after", "min": 3, "max": 30, "step": 1, "unit": "s", "default": 9 },
    { "type": "range", "id": "repeat_days", "label": "Show again to visitors who closed it after", "min": 0, "max": 90, "step": 5, "unit": "d", "default": 0, "info": "0 means never: each visitor sees it once. People who sign up never see it again." },
    { "type": "checkbox", "id": "preview", "label": "Show in the theme editor", "default": false, "info": "Turn on to preview and edit the popup here. It opens immediately while previewing." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Offer (only shown when a discount code is set)" },
    { "type": "text", "id": "discount_code", "label": "Discount code", "info": "Leave empty to use the code in Theme settings > Welcome offer. The code must exist in Shopify admin > Discounts." },
    { "type": "text", "id": "offer_kicker", "label": "Small line above heading", "default": "Welcome offer" },
    { "type": "text", "id": "offer_heading", "label": "Offer heading", "default": "Take 10% off your first order" },
    { "type": "richtext", "id": "offer_text", "label": "Offer text", "default": "<p>Join our email list and we'll show your code straight away. One use per customer.</p>", "info": "Make sure this matches the discount you created (amount, minimum spend, expiry)." },
    { "type": "header", "content": "Plain signup (no discount code)" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hear about deals first" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Occasional emails with restocks, new products and subscriber offers.</p>" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Signup button", "default": "Sign up" },
    { "type": "text", "id": "decline_label", "label": "Decline link", "default": "No thanks" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "By signing up you agree to get our emails. Unsubscribe any time." }
  ]
}
{% endschema %}
